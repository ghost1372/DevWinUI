<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.WelcomeHeroPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <local:ControlExample DocPage="controls/welcomeHero">
        <local:ControlExample.Xaml>
            <x:String>&lt;dev:WelcomeHero x:Name="Hero"/&gt;</x:String>
        </local:ControlExample.Xaml>
        <local:ControlExample.CSharp>
            <x:String>
                Hero.LogoAsset = "ms-appx:///Assets/AppIcon.png";#nl#
                Hero.Modules =[#nl#
                new("ms-appx:///Assets/CommandPalette.png", "CmdPal", "Command Palette"),#nl#
                new("ms-appx:///AdvancedPaste.png", "AdvancedPaste", "Advanced Paste"),#nl#
                ];
            </x:String>
        </local:ControlExample.CSharp>
        <Frame x:Name="MainFrame" />
    </local:ControlExample>

</Page>
