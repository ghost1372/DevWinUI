<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ProfileControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="ProfileControl" Doc="controls/profileControl">
                <local:ControlExample2.XamlCode>
                    <x:String>&lt;dev:ProfileControl Source="ms-appx:///Assets/Profile/1.jpg" /&gt;</x:String>
                </local:ControlExample2.XamlCode>
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <Button x:Name="BtnPrev" HorizontalAlignment="Stretch" Click="BtnPrev_Click" Content="Previous" />
                        <Button x:Name="BtnNext" HorizontalAlignment="Stretch" Click="BtnNext_Click" Content="Next" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <dev:ProfileControl x:Name="profile" Width="320" Height="320" HorizontalAlignment="Center" VerticalAlignment="Center" BorderGap="25" Stretch="Uniform" Tint="#efefef" />
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
