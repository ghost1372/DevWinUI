<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ImageFramePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="ImageFrame" Doc="controls/imageFrame">
                <local:ControlExample.XamlCode>
                    <x:String>&lt;dev:ImageFrame Source="ms-appx:///Assets/Others/RainbowRose.png" /&gt;</x:String>
                </local:ControlExample.XamlCode>
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Image">
                        <local:OptionPanel>
                            <Button x:Name="BtnChange" HorizontalAlignment="Stretch" Click="BtnChange_Click" Content="Change Image" />
                            <local:ChoiceOption Header="Transition" Value="{x:Bind ImageFrame.TransitionMode, Mode=TwoWay}" />
                            <local:ChoiceOption Header="Alignment X" Value="{x:Bind ImageFrame.AlignX, Mode=TwoWay}" />
                            <local:ChoiceOption Header="Alignment Y" Value="{x:Bind ImageFrame.AlignY, Mode=TwoWay}" />
                            <Slider x:Name="SldCornerRadius" Header="Corner Radius" Value="8" />
                            <ToggleSwitch x:Name="TgShowPlaceholder" Header="Show Placeholder" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Shadow">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TgShowShadow" Header="Show Shadow" IsOn="True" />
                            <Slider x:Name="SldShadowBlurRadius" Header="Shadow Blur Radius" Value="60" />
                            <Slider x:Name="SldShadowOffsetX" Header="Shadow Offset X" Minimum="-180" Value="0" />
                            <Slider x:Name="SldShadowOffsetY" Header="Shadow Offset Y" Minimum="-180" Value="0" />
                            <Slider x:Name="SldShadowOpacity" Header="Shadow Opacity" Maximum="1" Minimum="0" TickFrequency="0.01" Value="0.65" />
                            <local:ColorOption x:Name="ColorOptionSample" Header="Shadow Color" Value="Yellow" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <dev:ImageFrame x:Name="ImageFrame" HorizontalAlignment="Stretch" VerticalAlignment="Top" AlignX="Center" AlignY="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="{x:Bind SldCornerRadius.Value, Mode=OneWay, Converter={StaticResource DoubleToCornerRadiusConverter}}" DisplayShadow="{x:Bind TgShowShadow.IsOn, Mode=OneWay}" FrameBackground="{ThemeResource CardStrokeColorDefaultSolid}" ShadowBlurRadius="{x:Bind SldShadowBlurRadius.Value, Mode=OneWay}" ShadowColor="{x:Bind ColorOptionSample.Value, Mode=OneWay}" ShadowOffsetX="{x:Bind SldShadowOffsetX.Value, Mode=OneWay}" ShadowOffsetY="{x:Bind SldShadowOffsetY.Value, Mode=OneWay}" ShadowOpacity="{x:Bind SldShadowOpacity.Value, Mode=OneWay}" ShowPlaceholder="{x:Bind TgShowPlaceholder.IsOn, Mode=OneWay}" Stretch="Fill" TransitionMode="SlideLeft" />
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>

</Page>
