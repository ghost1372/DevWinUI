<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.StoreCarouselPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="StoreCarousel" Doc="controls/storeCarousel">
                <local:ControlExample2.XamlCode>
                    <x:String>&lt;dev:StoreCarousel ItemsSource="{x:Bind ViewModel.StoreCarouselData, Mode=OneWay}" /&gt;</x:String>
                </local:ControlExample2.XamlCode>
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <ToggleSwitch x:Name="TgShuffle" Header="Auto Shuffle" IsOn="True" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <dev:StoreCarousel AutoShuffle="{x:Bind TgShuffle.IsOn, Mode=OneWay}" ItemClick="StoreCarouselSample_ItemClick" ItemsSource="{x:Bind ViewModel.StoreCarouselData, Mode=OneWay}" PrimaryImageSource="ms-appx:///Assets/Carousel/8.jpg" SecondaryImageSource="ms-appx:///Assets/Carousel/9.jpg" TertiaryImageSource="ms-appx:///Assets/Carousel/10.jpg" />
            </local:ControlExample2>

        </StackPanel>
    </ScrollViewer>

</Page>
