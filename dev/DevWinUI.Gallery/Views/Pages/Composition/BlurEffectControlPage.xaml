<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BlurEffectControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="BlurEffectControl" Doc="controls/blurEffectControl">
                <local:ControlExample2.XamlCode>
                    <x:String>&lt;dev:BlurEffectControl /&gt;</x:String>
                </local:ControlExample2.XamlCode>
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Blur">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TGIsBlurEnabled" Header="Is Blur Enabled" IsOn="True" />
                            <Slider x:Name="TGSlider" Header="Blur Amount" Maximum="100" Minimum="0" Value="2" />
                            <local:ChoiceOption x:Name="CmbBlurSourceType" Header="Blur Source Type" ValueChanged="CmbBlurSourceType_ValueChanged" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Effect">
                        <local:OptionPanel>
                            <local:ChoiceOption Header="Effect Border Mode" Value="{x:Bind BlurEffectControlSample.BorderMode, Mode=TwoWay}" />
                            <local:ChoiceOption Header="Effect Optimization" Value="{x:Bind BlurEffectControlSample.Optimization, Mode=TwoWay}" />
                            <local:ChoiceOption Header="Blend Effect Mode" Value="{x:Bind BlurEffectControlSample.BlendMode, Mode=TwoWay}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Noise and Tint">
                        <local:OptionPanel>
                            <local:ChoiceOption Header="Noise Blend Effect Mode" Value="{x:Bind BlurEffectControlSample.NoiseBlendMode, Mode=TwoWay}" />
                            <ToggleSwitch x:Name="TGUseNoise" Header="Use Noise" />
                            <TextBox x:Name="TxtNoiseUri" Header="Noise URI" IsReadOnly="True" Text="ms-appx:///Assets/Noise/Noise.jpg" />
                            <local:ColorOption Header="Tint Color" IsAlphaEnabled="False" Value="{x:Bind BlurEffectControlSample.TintColor, Mode=TwoWay}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <Grid VerticalAlignment="Top">
                    <dev:CompositionImage x:Name="BackdropImage" Source="ms-appx:///Assets/Landscapes/Landscape-9.jpg" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="72" Foreground="Black" Text="DevWinUI" TextWrapping="Wrap" />
                    <dev:BlurEffectControl x:Name="BlurEffectControlSample" BlendMode="Multiply" BlurAmount="{x:Bind TGSlider.Value, Mode=OneWay}" BorderMode="Hard" IsBlurEnabled="{x:Bind TGIsBlurEnabled.IsOn, Mode=OneWay}" IsTintEnabled="True" NoiseBlendMode="Screen" NoiseUri="{x:Bind TxtNoiseUri.Text, Mode=OneWay}" Optimization="Balanced" UseNoise="{x:Bind TGUseNoise.IsOn, Mode=OneWay}" />
                </Grid>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
