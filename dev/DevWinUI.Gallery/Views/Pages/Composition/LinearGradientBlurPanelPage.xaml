<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LinearGradientBlurPanelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer CanContentRenderOutsideBounds="True">
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="LinearGradientBlurPanel" Doc="controls/linearGradientBlurPanel">
                <local:ControlExample.XamlCode>
                    <x:String>&lt;dev:LinearGradientBlurPanel TintColor="#99000000" MaxBlurAmount="64" /&gt;</x:String>
                </local:ControlExample.XamlCode>
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <local:ChoiceOption x:Name="PointOption" Header="Gradient Direction" ItemsSource="{x:Bind PointList, Mode=OneWay}" Value="{x:Bind PointList[0]}" />
                        <Slider x:Name="SlMaxBlurAmount" Header="Max Blur Amount" Value="64" />
                        <Button HorizontalAlignment="Stretch" Click="StartAnimationButton_Click" Content="Start Animation" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <Border MaxWidth="400" MaxHeight="500" HorizontalAlignment="Stretch">
                    <Grid>
                        <Image Source="ms-appx:///Assets/Others/Girl.jpg" Stretch="Fill" />
                        <dev:LinearGradientBlurPanel x:Name="LinearGradientBlurPanelSample" MaxBlurAmount="{x:Bind SlMaxBlurAmount.Value, Mode=OneWay}" TintColor="#99000000" StartPoint="{x:Bind GetStartPoint(PointOption.Value), Mode=OneWay}" EndPoint="{x:Bind GetEndPoint(PointOption.Value), Mode=OneWay}">
                            <Rectangle Width="50" Height="50" Margin="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Fill="#77c3f4" />
                        </dev:LinearGradientBlurPanel>
                    </Grid>
                </Border>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
