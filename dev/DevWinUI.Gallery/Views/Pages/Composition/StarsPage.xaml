<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.StarsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Stars" Doc="controls/stars">
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <Slider x:Name="SldNumberOfBigMovingStars" Header="Number Of Big Moving Stars" Maximum="300" Minimum="10" Value="150" />
                        <Slider x:Name="SldNumberOfSmallTwinklingStars" Header="Number Of Small Twinkling Stars" Maximum="2000" Minimum="100" Value="600" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <local:ControlExample.XamlCode>
                    <x:String>&lt;dev:Stars /&gt;</x:String>
                </local:ControlExample.XamlCode>
                <dev:Stars Height="300" NumberOfBigMovingStars="{x:Bind (x:Int32)SldNumberOfBigMovingStars.Value, Mode=OneWay}" NumberOfSmallTwinklingStars="{x:Bind (x:Int32)SldNumberOfSmallTwinklingStars.Value, Mode=OneWay}" />
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
