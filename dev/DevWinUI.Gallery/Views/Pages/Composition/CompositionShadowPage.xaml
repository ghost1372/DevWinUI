<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.CompositionShadowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="CompositionShadow" Doc="controls/compositionShadow" Xaml="Composition/CompositionShadowPage_xaml.txt">
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <ToggleSwitch x:Name="TGMask" Header="Toggle Mask" Toggled="TGMask_Toggled" />
                        <ToggleSwitch x:Name="TGBreath" Header="Breath" />
                        <ToggleSwitch x:Name="TGIsRounded" Header="Is Rounded" IsOn="True" />
                        <local:ColorOption x:Name="ColorOptionSample" Header="Shadow Color" Value="Yellow" />
                        <Slider x:Name="OffsetXSlider" Header="Offset X" Maximum="200" Minimum="-200" Value="2" />
                        <Slider x:Name="OffsetYSlider" Header="Offset Y" Maximum="200" Minimum="-200" Value="2" />
                        <Slider x:Name="ShadowSlider" Header="Shadow Opacity" Maximum="1" Minimum="0" TickFrequency="0.1" Value="1" />
                        <Slider x:Name="BlurSlider" Header="Blur Radius" Maximum="100" Minimum="0" Value="16" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <StackPanel Spacing="10">
                    <dev:CompositionShadow BlurRadius="{x:Bind BlurSlider.Value, Mode=OneWay}" IsBreathing="{x:Bind TGBreath.IsOn, Mode=OneWay}" OffsetX="{x:Bind OffsetXSlider.Value, Mode=OneWay}" OffsetY="{x:Bind OffsetYSlider.Value, Mode=OneWay}" ShadowOpacity="{x:Bind ShadowSlider.Value, Mode=OneWay}" Color="{x:Bind ColorOptionSample.Value, Mode=OneWay}">
                        <TextBlock FontSize="30" FontWeight="SemiBold" TextWrapping="Wrap">
                            Here’s a custom control that allows you to apply DropShadows through Markup on XAML Text, Images, or Shapes
                        </TextBlock>
                    </dev:CompositionShadow>
                    <dev:CompositionShadow x:Name="RenderShadow" Width="200" Height="300" BlurRadius="{x:Bind BlurSlider.Value, Mode=OneWay}" IsBreathing="{x:Bind TGBreath.IsOn, Mode=OneWay}" OffsetX="{x:Bind OffsetXSlider.Value, Mode=OneWay}" OffsetY="{x:Bind OffsetYSlider.Value, Mode=OneWay}" ShadowOpacity="{x:Bind ShadowSlider.Value, Mode=OneWay}" Color="{x:Bind ColorOptionSample.Value, Mode=OneWay}">
                        <dev:CompositionImage x:Name="ComImage" Source="ms-appx:///Assets/Others/Girl.jpg" />
                    </dev:CompositionShadow>
                    <dev:CompositionShadow BlurRadius="{x:Bind BlurSlider.Value, Mode=OneWay}" IsBreathing="{x:Bind TGBreath.IsOn, Mode=OneWay}" OffsetX="{x:Bind OffsetXSlider.Value, Mode=OneWay}" OffsetY="{x:Bind OffsetYSlider.Value, Mode=OneWay}" ShadowOpacity="{x:Bind ShadowSlider.Value, Mode=OneWay}" Color="{x:Bind ColorOptionSample.Value, Mode=OneWay}">
                        <Polygon Fill="Blue" Points="50,0 0,50 50,50" />
                    </dev:CompositionShadow>
                    <dev:CompositionShadow Width="100" Height="100" BlurRadius="{x:Bind BlurSlider.Value, Mode=OneWay}" IsBreathing="{x:Bind TGBreath.IsOn, Mode=OneWay}" IsRounded="{x:Bind TGIsRounded.IsOn, Mode=OneWay}" OffsetX="{x:Bind OffsetXSlider.Value, Mode=OneWay}" OffsetY="{x:Bind OffsetYSlider.Value, Mode=OneWay}" ShadowOpacity="{x:Bind ShadowSlider.Value, Mode=OneWay}" Color="{x:Bind ColorOptionSample.Value, Mode=OneWay}" />
                </StackPanel>

            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>

</Page>
