<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ColorSlideControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="ColorSlideControl" CSharp="Composition/ColorSlideControl/ColorSlideControlPage_cs.txt" Doc="controls/colorSlideControl" Xaml="Composition/ColorSlideControl/ColorSlideControlPage_xaml.txt">
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <local:ColorOption x:Name="ColorOptionSample" Header="Slide Color" IsAlphaEnabled="False" Value="Orange" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <Grid Height="200" VerticalAlignment="Top" SizeChanged="OnSizeChanged">
                    <Button x:Name="BtnStart" Width="170" Margin="0,0,0,10" VerticalAlignment="Top" Click="OnClick" Content="Start" />
                    <dev:ColorSlideControl x:Name="ColorSlideSample" Color="{x:Bind ColorOptionSample.Value, Mode=OneWay}" />
                </Grid>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
