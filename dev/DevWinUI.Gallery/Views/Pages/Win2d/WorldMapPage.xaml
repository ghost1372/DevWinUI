<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.WorldMapPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="WorldMap" Doc="controls/worldMap">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Selection">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbSelectionMode" Header="Selection Mode" Value="{x:Bind dev:WorldMapSelectionMode.Multiple}" />
                            <local:ChoiceOption x:Name="CmbHighlightColor" Header="Highlight Color" Value="{x:Bind dev:WorldMapHighlightColor.Cyan}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Borders">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbBorderStyle" Header="Border Style" Value="{x:Bind dev:WorldMapBorderStyle.Dashed}" />
                            <Slider x:Name="SliderStrokeThickness" Header="Border Thickness" Maximum="2" Minimum="0.25" StepFrequency="0.25" Value="0.75" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Interaction">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TglToolTip" Header="Tool Tips" IsOn="True" />
                            <ToggleSwitch x:Name="TglZoomControls" Header="Zoom Controls" IsOn="True" />
                            <ToggleSwitch x:Name="TglPan" Header="Pan" IsOn="True" />
                            <ToggleSwitch x:Name="TglZoom" Header="Zoom" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="WorldMap">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:WorldMap Height="440" SelectionMode="Multiple" HighlightColor="Cyan" CountryBorderStyle="Dashed" ShowToolTip="True" ShowZoomControls="True" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="8">
                            <dev:WorldMap x:Name="Map" Height="440" CountryBorderStyle="{x:Bind ((dev:WorldMapBorderStyle)CmbBorderStyle.Value), Mode=OneWay}" CountryClicked="OnMapCountryClicked" CountryStrokeThickness="{x:Bind SliderStrokeThickness.Value, Mode=OneWay}" HighlightColor="{x:Bind ((dev:WorldMapHighlightColor)CmbHighlightColor.Value), Mode=OneWay}" IsPanEnabled="{x:Bind TglPan.IsOn, Mode=OneWay}" IsZoomEnabled="{x:Bind TglZoom.IsOn, Mode=OneWay}" MapLoaded="OnMapLoaded" SelectionChanged="OnMapSelectionChanged" SelectionMode="{x:Bind ((dev:WorldMapSelectionMode)CmbSelectionMode.Value), Mode=OneWay}" ShowToolTip="{x:Bind TglToolTip.IsOn, Mode=OneWay}" ShowZoomControls="{x:Bind TglZoomControls.IsOn, Mode=OneWay}" />
                            <TextBlock x:Name="MapStatusText" Text="Loading world map..." />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
