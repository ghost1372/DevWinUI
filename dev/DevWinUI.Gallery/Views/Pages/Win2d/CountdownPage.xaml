<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.CountdownPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Countdown" Doc="controls/countdown">
                <local:ControlExample.XamlCode>
                    <x:String>&lt;dev:Countdown CountdownSeconds="0" MaxSeconds="60" /&gt;</x:String>
                </local:ControlExample.XamlCode>
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Countdown">
                        <local:OptionPanel>
                            <Slider x:Name="SldSec" Header="Countdown Seconds" Maximum="{x:Bind SldMaxSec.Value, Mode=OneWay}" Value="0" />
                            <Slider x:Name="SldMaxSec" Header="Max Second" Value="60" />
                            <local:ChoiceOption Header="State" Value="{x:Bind CountdownSample.State, Mode=TwoWay}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <dev:Countdown x:Name="CountdownSample" CountdownSeconds="{x:Bind (x:Int32)SldSec.Value, Mode=OneWay}" MaxSeconds="{x:Bind (x:Int32)SldMaxSec.Value, Mode=OneWay}" />
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>

</Page>
