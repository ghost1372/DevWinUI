<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BlinkingSquaresPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Blinking Squares" Doc="controls/blinkingSquares">
                <local:ControlExample.XamlCode>
                    <x:String>&lt;dev:BlinkingSquares Direction="Right" GridSize="52" SquareColor="Red" /&gt;</x:String>
                </local:ControlExample.XamlCode>
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Appearance">
                        <local:OptionPanel>
                            <local:ChoiceOption Header="Direction" Value="{x:Bind Preview.Direction, Mode=TwoWay}" />
                            <Slider x:Name="SldGridSize" Header="Grid Size" Maximum="100" Minimum="8" StepFrequency="1" Value="52" />
                            <Slider x:Name="SldSquareDensity" Header="Square Density" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.9" />
                            <Slider x:Name="SldIntensity" Header="Intensity" Maximum="2" Minimum="0" StepFrequency="0.1" Value="1" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Twinkle">
                        <local:OptionPanel>
                            <Slider x:Name="SldTwinkleSpeed" Header="Twinkle Speed" Maximum="4" Minimum="0" StepFrequency="0.1" Value="1.4" />
                            <Slider x:Name="SldTwinkleStrength" Header="Twinkle Strength" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.94" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <dev:BlinkingSquares x:Name="Preview" GridSize="{x:Bind (x:Int32)SldGridSize.Value, Mode=OneWay}" Intensity="{x:Bind SldIntensity.Value, Mode=OneWay}" SquareDensity="{x:Bind SldSquareDensity.Value, Mode=OneWay}" TwinkleSpeed="{x:Bind SldTwinkleSpeed.Value, Mode=OneWay}" TwinkleStrength="{x:Bind SldTwinkleStrength.Value, Mode=OneWay}" />
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
