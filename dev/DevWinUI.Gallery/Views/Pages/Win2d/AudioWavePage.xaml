<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.AudioWavePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="AudioWave" Doc="controls/audioWave">
                <local:ControlExample.XamlCode>
                    <x:String>&lt;dev:AudioWave x:Name="AudioWaveSample" /&gt;</x:String>
                </local:ControlExample.XamlCode>
                <local:ControlExample.CSharpCode>
                    <x:String>AudioWaveSample.WaveDataProvider = OnWaveDataProvider;</x:String>
                </local:ControlExample.CSharpCode>
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Data">
                        <local:OptionPanel>
                            <StackPanel Spacing="8">
                                <Button x:Name="BtnFake" HorizontalAlignment="Stretch" Click="BtnFake_Click" Content="Generate Fake Data" />
                                <Button x:Name="BtnFake2" HorizontalAlignment="Stretch" Click="BtnFake2_Click" Content="Generate Fake Data2" />
                            </StackPanel>
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Playback">
                        <local:OptionPanel>
                            <StackPanel Spacing="8">
                                <Button x:Name="BtnStart" HorizontalAlignment="Stretch" Click="BtnStart_Click" Content="Start" />
                                <Button x:Name="BtnPause" HorizontalAlignment="Stretch" Click="BtnPause_Click" Content="Pause" />
                                <Button x:Name="BtnStop" HorizontalAlignment="Stretch" Click="BtnStop_Click" Content="Stop" />
                            </StackPanel>
                            <Slider x:Name="SldProgress" Header="Progress" Maximum="100" Minimum="0" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <dev:AudioWave x:Name="AudioWaveSample" Height="100" CanSelectedByMouse="True" Progress="{x:Bind (x:Int32)SldProgress.Value, Mode=OneWay}" />
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>

</Page>
