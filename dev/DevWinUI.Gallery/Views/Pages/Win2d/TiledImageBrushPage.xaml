<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.TiledImageBrushPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="TiledImageBrush" Doc="brushes/tiledImageBrush">
                <local:ControlExample.Samples>
                    <local:Sample Title="TiledImageBrush" Xaml="Win2d/TiledImageBrush_xaml.txt">
                        <Rectangle Height="400">
                            <Rectangle.Fill>
                                <dev:TiledImageBrush Source="ms-appx:///Assets/cloud.png" />
                            </Rectangle.Fill>
                        </Rectangle>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
