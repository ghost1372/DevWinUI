<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.CircleIconPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="CircleIcon" Doc="controls/circleIcon">
                <local:ControlExample2.XamlCode>
                    <x:String>&lt;dev:CircleIcon /&gt;</x:String>
                </local:ControlExample2.XamlCode>
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Appearance">
                        <local:OptionPanel>
                            <Slider x:Name="SldBorderThickness" Header="Border Thickness" Value="2" />
                            <TextBox x:Name="TxtContent" Header="Content (Can be any object)" PlaceholderText="D" Text="D" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <dev:CircleIcon BorderStrokeThickness="{x:Bind SldBorderThickness.Value, Mode=OneWay}" Content="{x:Bind TxtContent.Text, Mode=OneWay}" />
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
