<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.WatermarkPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Watermark" Doc="controls/watermark">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Text watermark">
                        <local:OptionPanel>
                            <TextBox x:Name="txtMark" Header="Mark" PlaceholderText="Mark" Text="DevWinUI" />
                            <NumberBox x:Name="nbHorizSpace" Header="HorizontalSpacing" Minimum="0" SpinButtonPlacementMode="Inline" Value="5" />
                            <NumberBox x:Name="nbVerSpace" Header="VerticalSpacing" Minimum="0" SpinButtonPlacementMode="Inline" Value="5" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Text transform">
                        <local:OptionPanel>
                            <Slider x:Name="Angle" Header="Angle" Maximum="360" Minimum="-360" Value="15" />
                            <Slider x:Name="CenterPointX" Header="CenterPointX" Maximum="360" Minimum="-360" />
                            <Slider x:Name="CenterPointY" Header="CenterPointY" Maximum="360" Minimum="-360" />
                            <ToggleSwitch x:Name="UseScale" Header="UseScale" IsOn="True" />
                            <Slider x:Name="MarkScale" Header="MarkScale" Value="1" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Image watermark">
                        <local:OptionPanel>
                            <NumberBox x:Name="nbHorizSpace2" Header="HorizontalSpacing" Minimum="0" SpinButtonPlacementMode="Inline" Value="5" />
                            <NumberBox x:Name="nbVerSpace2" Header="VerticalSpacing" Minimum="0" SpinButtonPlacementMode="Inline" Value="5" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Image transform">
                        <local:OptionPanel>
                            <Slider x:Name="Angle2" Header="Angle" Maximum="360" Minimum="-360" Value="15" />
                            <Slider x:Name="CenterPointX2" Header="CenterPointX" Maximum="360" Minimum="-360" />
                            <Slider x:Name="CenterPointY2" Header="CenterPointY" Maximum="360" Minimum="-360" />
                            <ToggleSwitch x:Name="UseScale2" Header="UseScale" IsOn="True" />
                            <Slider x:Name="MarkScale2" Header="MarkScale" StepFrequency="0.1" Value="0.1" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Text watermark">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Watermark Mark="DevWinUI" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:Watermark Angle="{x:Bind Angle.Value, Mode=OneWay}" CenterPointX="{x:Bind CenterPointX.Value, Mode=OneWay}" CenterPointY="{x:Bind CenterPointY.Value, Mode=OneWay}" HorizontalSpacing="{x:Bind (x:Int32)nbHorizSpace.Value, Mode=OneWay}" Mark="{x:Bind txtMark.Text, Mode=OneWay}" MarkScale="{x:Bind MarkScale.Value, Mode=OneWay}" UseScale="{x:Bind UseScale.IsOn, Mode=OneWay}" VerticalSpacing="{x:Bind (x:Int32)nbVerSpace.Value, Mode=OneWay}" />
                    </local:Sample>
                    <local:Sample Title="Image watermark">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Watermark MarkImage="ms-appx:///Assets/Cover.png" IsImage="True" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:Watermark Angle="{x:Bind Angle2.Value, Mode=OneWay}" CenterPointX="{x:Bind CenterPointX2.Value, Mode=OneWay}" CenterPointY="{x:Bind CenterPointY2.Value, Mode=OneWay}" HorizontalSpacing="{x:Bind (x:Int32)nbHorizSpace2.Value, Mode=OneWay}" IsImage="True" MarkImage="https://raw.githubusercontent.com/ghost1372/DevWinUI/refs/heads/main/tools/Assets/DevWinUI.png" MarkScale="{x:Bind MarkScale2.Value, Mode=OneWay}" UseScale="{x:Bind UseScale2.IsOn, Mode=OneWay}" VerticalSpacing="{x:Bind (x:Int32)nbVerSpace2.Value, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
