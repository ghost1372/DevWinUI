<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SpeedGraphPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="SpeedGraph" Doc="controls/speedGraph">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Simulation">
                        <local:OptionPanel>
                            <Button Click="BtnCopy_Click" Content="Starting file copy simulation" />
                            <Button Click="BtnError_Click" Content="Error" />
                            <Button Click="BtnPause_Click" Content="Pause" />
                            <Button Click="BtnNormal_Click" Content="Normal" />
                            <NumberBox x:Name="NBFileSize" Header="File Size (MB)" Maximum="5000" Minimum="100" Value="500" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Appearance">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TGShowLine" Header="Show Speed Line" IsOn="True" />
                            <ToggleSwitch x:Name="TGShowText" Header="Show Speed Text" IsOn="True" />
                            <ToggleSwitch x:Name="TGAutoUpdate" Header="Auto Update Speed Text" IsOn="True" />
                            <local:ChoiceOption x:Name="CmbBackgroundMode" Header="Background Mode" Value="{x:Bind dev:SpeedGraphBackgroundMode.Dot}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="SpeedGraph">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:SpeedGraph /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <local:Sample.CSharpCode>
                            <x:String>
                                SpeedGraph.SetSpeed(percent, speed);
                            </x:String>
                        </local:Sample.CSharpCode>
                        <dev:SpeedGraph x:Name="SpeedGraphSample" AutoUpdateSpeedText="{x:Bind TGAutoUpdate.IsOn, Mode=OneWay}" BackgroundMode="{x:Bind ((dev:SpeedGraphBackgroundMode)CmbBackgroundMode.Value), Mode=OneWay}" SpeedLineVisibility="{x:Bind TGShowLine.IsOn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" SpeedTextVisibility="{x:Bind TGShowText.IsOn, Mode=OneWay, Converter={StaticResource BoolToVisibilityConverter}}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
            <local:ControlExample Title="SpeedGraph2" Doc="controls/speedGraph2">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Simulation">
                        <local:OptionPanel>
                            <Button Click="BtnCopy_Click2" Content="Starting file copy simulation" />
                            <Button Click="BtnError_Click2" Content="Error" />
                            <Button Click="BtnPause_Click2" Content="Warning" />
                            <Button Click="BtnSuccess_Click2" Content="Success" />
                            <Button Click="BtnNormal_Click2" Content="Normal" />
                            <NumberBox x:Name="NBFileSize2" Header="File Size (MB)" Maximum="5000" Minimum="100" Value="500" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="SpeedGraph2">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:SpeedGraph2 x:Name="SpeedGraphSample2" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <local:Sample.CSharpCode>
                            <x:String>
                                SpeedGraphSample2.Points.Add(new Vector2(percent, speed));
                            </x:String>
                        </local:Sample.CSharpCode>
                        <dev:SpeedGraph2 x:Name="SpeedGraphSample2" MinHeight="200" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
