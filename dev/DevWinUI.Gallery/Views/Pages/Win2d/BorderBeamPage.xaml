<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BorderBeamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="using:DevWinUIGallery.Views"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="BorderBeam" Doc="controls/borderBeam" ResetRequested="ControlExample_ResetRequested">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Beam">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbMode" Header="Mode" Value="{x:Bind dev:BorderBeamMode.Chase}" />
                            <local:ChoiceOption x:Name="CmbPreset" Header="Color Preset" ItemsSource="{x:Bind Presets}" SelectedIndex="0">
                                <local:ChoiceOption.ItemTemplate>
                                    <DataTemplate x:DataType="views:BeamPreset">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </local:ChoiceOption.ItemTemplate>
                            </local:ChoiceOption>
                            <local:ColorOption x:Name="ClrFrom" Header="Color From" Value="{x:Bind ((views:BeamPreset)CmbPreset.Value).From, Mode=OneWay}" />
                            <local:ColorOption x:Name="ClrTo" Header="Color To" Value="{x:Bind ((views:BeamPreset)CmbPreset.Value).To, Mode=OneWay}" />
                            <Slider x:Name="SliderSize" Header="Size" Maximum="600" Minimum="20" Value="200" />
                            <Slider x:Name="SliderBeamCount" Header="Beam Count" Maximum="6" Minimum="1" StepFrequency="1" Value="1" />
                            <Slider x:Name="SliderDuration" Header="Duration (seconds)" Maximum="30" Minimum="1" StepFrequency="0.5" Value="15" />
                            <Slider x:Name="SliderDelay" Header="Delay (seconds)" Maximum="10" Minimum="0" StepFrequency="0.5" Value="0" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Lifecycle">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TglActive" Header="Is Active" IsOn="True" />
                            <Slider x:Name="SliderCycleCount" Header="Cycle Count (0 = forever)" Maximum="10" Minimum="0" StepFrequency="1" Value="0" />
                            <ToggleSwitch x:Name="TglFadeOut" Header="Fade Out" IsOn="True" />
                            <Slider x:Name="SliderFadeOut" Header="Fade Out (seconds)" Maximum="3" Minimum="0" StepFrequency="0.1" Value="0.5" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Chase">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbChaseOrigin" Header="Origin" Value="{x:Bind dev:BorderBeamOrigin.Top}" />
                            <local:ChoiceOption x:Name="CmbChaseEdge" Header="Edge" Value="{x:Bind dev:BorderBeamEdge.LeftEdge}" />
                            <local:ChoiceOption x:Name="CmbChaseDirection" Header="Direction" Value="{x:Bind dev:BorderBeamDirection.Clockwise}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Mirror">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbMirrorOrigin" Header="Origin" Value="{x:Bind dev:BorderBeamOrigin.Top}" />
                            <local:ChoiceOption x:Name="CmbMirrorEdge" Header="Edge" Value="{x:Bind dev:BorderBeamEdge.Center}" />
                            <local:ChoiceOption x:Name="CmbMirrorStart" Header="Start" Value="{x:Bind dev:BorderBeamStart.Both}" />
                            <Slider x:Name="SliderMirrorLag" Header="Lag (seconds)" Maximum="2" Minimum="0" StepFrequency="0.1" Value="0.3" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Shape">
                        <local:OptionPanel>
                            <Slider x:Name="SliderBorderWidth" Header="Border Width" Maximum="8" Minimum="0.5" StepFrequency="0.5" Value="1.5" />
                            <Slider x:Name="SliderRadius" Header="Corner Radius" Maximum="100" Minimum="0" Value="12" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Card">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:BorderBeam ColorFrom="#FFFFAA40" ColorTo="#FF9C40FF" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Width="360" Height="200" HorizontalAlignment="Center">
                            <dev:BorderBeam x:Name="CardBeam" BeamCount="{x:Bind (x:Int32)SliderBeamCount.Value, Mode=OneWay}" BorderWidth="{x:Bind SliderBorderWidth.Value, Mode=OneWay}" ChaseDirection="{x:Bind (dev:BorderBeamDirection)CmbChaseDirection.Value, Mode=OneWay}" ChaseEdge="{x:Bind (dev:BorderBeamEdge)CmbChaseEdge.Value, Mode=OneWay}" ChaseOrigin="{x:Bind (dev:BorderBeamOrigin)CmbChaseOrigin.Value, Mode=OneWay}" ColorFrom="{x:Bind ClrFrom.Value, Mode=OneWay}" ColorTo="{x:Bind ClrTo.Value, Mode=OneWay}" CornerRadius="{x:Bind ToCornerRadius(SliderRadius.Value), Mode=OneWay}" CycleCount="{x:Bind (x:Int32)SliderCycleCount.Value, Mode=OneWay}" Delay="{x:Bind SliderDelay.Value, Mode=OneWay}" FadeOut="{x:Bind TglFadeOut.IsOn, Mode=OneWay}" FadeOutDuration="{x:Bind ToTimeSpan(SliderFadeOut.Value), Mode=OneWay}" IsActive="{x:Bind TglActive.IsOn, Mode=OneWay}" MirrorEdge="{x:Bind (dev:BorderBeamEdge)CmbMirrorEdge.Value, Mode=OneWay}" MirrorLag="{x:Bind SliderMirrorLag.Value, Mode=OneWay}" MirrorOrigin="{x:Bind (dev:BorderBeamOrigin)CmbMirrorOrigin.Value, Mode=OneWay}" MirrorStart="{x:Bind (dev:BorderBeamStart)CmbMirrorStart.Value, Mode=OneWay}" Mode="{x:Bind (dev:BorderBeamMode)CmbMode.Value, Mode=OneWay}" Size="{x:Bind SliderSize.Value, Mode=OneWay}" Duration="{x:Bind SliderDuration.Value, Mode=OneWay}" />
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{x:Bind ToCornerRadius(SliderRadius.Value), Mode=OneWay}" Visibility="Collapsed" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Border Beam" />
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Search box">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:BorderBeam BorderWidth="2" ColorFrom="#FF38BDF8" ColorTo="#FFA855F7" CornerRadius="28" Size="120" Duration="4" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Width="420" Height="56" HorizontalAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="28">
                            <dev:BorderBeam BorderWidth="2" ColorFrom="#FF38BDF8" ColorTo="#FFA855F7" CornerRadius="28" Size="120" Duration="4" />
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="28" />
                            <TextBox Margin="24,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" PlaceholderText="Ask anything..." />
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Attention grabber">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:BorderBeam x:Name="HighlightBeam" BorderWidth="2" ColorFrom="#FF38BDF8" ColorTo="#FFA855F7" CornerRadius="28" CycleCount="3" Duration="1" FadeOutDuration="0:0:0.6" IsActive="False" Size="120" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <local:Sample.CSharpCode>
                            <x:String>
                                HighlightBeam.Start();
                            </x:String>
                        </local:Sample.CSharpCode>
                        <StackPanel HorizontalAlignment="Center" Spacing="16">
                            <Grid Width="420" Height="56" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="28">
                                <dev:BorderBeam x:Name="HighlightBeam" BorderWidth="2" ColorFrom="#FF38BDF8" ColorTo="#FFA855F7" CornerRadius="28" CycleCount="3" FadeOutDuration="0:0:0.6" IsActive="False" Size="120" Duration="1" />
                                <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="28" />
                                <TextBox Margin="24,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" PlaceholderText="Search..." />
                            </Grid>
                            <Button HorizontalAlignment="Center" Click="OnHighlightClick" Content="Highlight" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
