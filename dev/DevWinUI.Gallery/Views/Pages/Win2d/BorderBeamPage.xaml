<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BorderBeamPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="using:DevWinUIGallery.Views"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="BorderBeam" Doc="controls/borderBeam">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Beam">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbPreset" Header="Colors" ItemsSource="{x:Bind Presets}" SelectedIndex="0">
                                <local:ChoiceOption.ItemTemplate>
                                    <DataTemplate x:DataType="views:BeamPreset">
                                        <TextBlock Text="{x:Bind Name}" />
                                    </DataTemplate>
                                </local:ChoiceOption.ItemTemplate>
                            </local:ChoiceOption>
                            <Slider x:Name="SliderSize" Header="Size" Maximum="600" Minimum="20" Value="200" />
                            <Slider x:Name="SliderDuration" Header="Duration (seconds)" Maximum="30" Minimum="1" StepFrequency="0.5" Value="15" />
                            <Slider x:Name="SliderDelay" Header="Delay (seconds)" Maximum="10" Minimum="0" StepFrequency="0.5" Value="0" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Shape">
                        <local:OptionPanel>
                            <Slider x:Name="SliderBorderWidth" Header="Border Width" Maximum="8" Minimum="0.5" StepFrequency="0.5" Value="1.5" />
                            <Slider x:Name="SliderRadius" Header="Corner Radius" Maximum="100" Minimum="0" Value="12" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="Card">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:BorderBeam /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Width="360" Height="200" HorizontalAlignment="Center">
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{x:Bind ToCornerRadius(SliderRadius.Value), Mode=OneWay}" />
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="Border Beam" />
                            <dev:BorderBeam BorderWidth="{x:Bind SliderBorderWidth.Value, Mode=OneWay}" ColorFrom="{x:Bind ((views:BeamPreset)CmbPreset.Value).From, Mode=OneWay}" ColorTo="{x:Bind ((views:BeamPreset)CmbPreset.Value).To, Mode=OneWay}" CornerRadius="{x:Bind ToCornerRadius(SliderRadius.Value), Mode=OneWay}" Delay="{x:Bind SliderDelay.Value, Mode=OneWay}" Size="{x:Bind SliderSize.Value, Mode=OneWay}" Duration="{x:Bind SliderDuration.Value, Mode=OneWay}" />
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Search box">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:BorderBeam BorderWidth="2" ColorFrom="#FF38BDF8" ColorTo="#FFA855F7" CornerRadius="28" Size="120" Duration="4" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Width="420" Height="56" HorizontalAlignment="Center" Background="Transparent" BorderBrush="Transparent" BorderThickness="0" CornerRadius="28">
                            <dev:BorderBeam BorderWidth="2" ColorFrom="#FF38BDF8" ColorTo="#FFA855F7" CornerRadius="28" Size="120" Duration="4" />
                            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="28" />
                            <TextBox Margin="24,0" VerticalAlignment="Center" Background="Transparent" BorderThickness="0" PlaceholderText="Ask anything..." />
                        </Grid>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
