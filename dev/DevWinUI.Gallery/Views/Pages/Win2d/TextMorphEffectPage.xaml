<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.TextMorphEffectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="TextMorphEffect" Doc="controls/textMorphEffect">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Text morph">
                        <local:OptionPanel>
                            <TextBox x:Name="txt" Header="Text" PlaceholderText="Text" Text="DevWinUI,Controls,ContextMenu,Core" />
                            <TextBox x:Name="delimiter" Header="Delimiter" PlaceholderText="Delimiter" Text="," />
                            <NumberBox x:Name="nbBlur" Header="Blur Amount" Maximum="10" Minimum="0" PlaceholderText="Blur Amount" SpinButtonPlacementMode="Inline" Value="1" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="TextMorphEffect">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:TextMorphEffect BlurAmount="1" Delimiter="," Text="Text1,Text2,Text3" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:TextMorphEffect BlurAmount="{x:Bind nbBlur.Value, Mode=OneWay}" Delimiter="{x:Bind delimiter.Text, Mode=OneWay}" FontSize="32" Text="{x:Bind txt.Text, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
