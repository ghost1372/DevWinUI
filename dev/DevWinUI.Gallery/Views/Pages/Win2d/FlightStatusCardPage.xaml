<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.FlightStatusCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="10" dev:PanelAttach.ChildrenTransitions="Default" Spacing="10">
            <local:ControlExample DocPage="controls/flightStatusCard" HeaderText="FlightStatusCard">
                <local:ControlExample.Xaml>
                    <x:String>
                        &lt;dev:FlightStatusCard DepartureCode="JFK" DepartureCity="New York" DepartureTime="MON, 6:14 PM" ArrivalCode="IKA" ArrivalCity="Tehran" ArrivalTime="TUE, 1:44 PM" Eta="ETA 1:44 PM" Timezone="Tehran Time" NextEvent="BREAKFAST IN" NextEventTime="4:20H" RemainingTime="-6H 36M" Progress="45" /&gt;
                    </x:String>
                </local:ControlExample.Xaml>
                <local:ControlExample.Pane>
                    <StackPanel Spacing="10">
                        <Slider x:Name="SliderProgress" Header="Progress" Maximum="100" Minimum="0" Value="45" />
                        <Slider x:Name="SliderWidth" Header="Container Width" Maximum="900" Minimum="120" Value="700" />
                        <Slider x:Name="SliderHeight" Header="Container Height" Maximum="600" Minimum="100" Value="480" />
                        <TextBox x:Name="TxtDepartureCode" Header="Departure Code" MaxLength="4" Text="JFK" />
                        <TextBox x:Name="TxtDepartureCity" Header="Departure City" Text="New York" />
                        <TextBox x:Name="TxtArrivalCode" Header="Arrival Code" MaxLength="4" Text="IKA" />
                        <TextBox x:Name="TxtArrivalCity" Header="Arrival City" Text="Tehran" />
                        <TextBox x:Name="TxtEta" Header="Eta" Text="ETA 1:44 PM" />
                        <TextBox x:Name="TxtRemainingTime" Header="Remaining Time" Text="-6H 36M" />
                    </StackPanel>
                </local:ControlExample.Pane>
                <Grid Width="{x:Bind SliderWidth.Value, Mode=OneWay}" Height="{x:Bind SliderHeight.Value, Mode=OneWay}" HorizontalAlignment="Left">
                    <dev:FlightStatusCard ArrivalCity="{x:Bind TxtArrivalCity.Text, Mode=OneWay}" ArrivalCode="{x:Bind TxtArrivalCode.Text, Mode=OneWay}" ArrivalTime="TUE, 1:44 PM" DepartureCity="{x:Bind TxtDepartureCity.Text, Mode=OneWay}" DepartureCode="{x:Bind TxtDepartureCode.Text, Mode=OneWay}" DepartureTime="MON, 6:14 PM" Eta="{x:Bind TxtEta.Text, Mode=OneWay}" NextEvent="BREAKFAST IN" NextEventTime="4:20H" Progress="{x:Bind SliderProgress.Value, Mode=OneWay}" RemainingTime="{x:Bind TxtRemainingTime.Text, Mode=OneWay}" Timezone="Tehran Time" />
                </Grid>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
