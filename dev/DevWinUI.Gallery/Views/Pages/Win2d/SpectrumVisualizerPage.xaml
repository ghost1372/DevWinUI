<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SpectrumVisualizerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <InfoBar Title="Please play music on your system to see the spectrum visualizer effects." IsClosable="False" IsOpen="True" Severity="Warning" />
            <local:ControlExample2 Title="SpectrumVisualizer" Doc="controls/spectrumVisualizer">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Display">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TgShowAlbumArt" Header="Show Album Art" IsOn="True" />
                            <ToggleSwitch x:Name="TgShowTitle" Header="Show Title" IsOn="True" />
                            <ToggleSwitch x:Name="TgShowArtist" Header="Show Artist" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Spectrum">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbSpectrumType" Header="Spectrum Type">
                                <local:ChoiceOption.Value>
                                    <dev:SpectrumType>Plain</dev:SpectrumType>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbColorType" Header="Color Type">
                                <local:ChoiceOption.Value>
                                    <dev:SpectrumColorType>GradientLoop</dev:SpectrumColorType>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <Slider x:Name="SldRotationSpeed" Header="Rotation Speed" Value="10" />
                            <Slider x:Name="SldSensitivity" Header="Sensitivity" Value="20" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="SpectrumVisualizer">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:SpectrumVisualizer x:Name="SpectrumVisualizerSample" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <local:Sample.CSharpCode>
                            <x:String>
                                SpectrumVisualizerSample.Analyzer = new MyAnalyzer();
                            </x:String>
                        </local:Sample.CSharpCode>
                        <dev:SpectrumVisualizer x:Name="SpectrumVisualizerSample" ColorType="{x:Bind ((dev:SpectrumColorType)CmbColorType.Value), Mode=OneWay}" RotationSpeed="{x:Bind SldRotationSpeed.Value, Mode=OneWay}" Sensitivity="{x:Bind SldSensitivity.Value, Mode=OneWay}" ShowAlbumArt="{x:Bind TgShowAlbumArt.IsOn, Mode=OneWay}" ShowArtist="{x:Bind TgShowArtist.IsOn, Mode=OneWay}" ShowTitle="{x:Bind TgShowTitle.IsOn, Mode=OneWay}" SpectrumType="{x:Bind ((dev:SpectrumType)CmbSpectrumType.Value), Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
