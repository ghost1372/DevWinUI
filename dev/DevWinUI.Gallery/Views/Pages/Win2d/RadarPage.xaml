<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.RadarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Radar" Doc="controls/radar">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Scan">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbMode" Header="Mode" Value="{x:Bind dev:RadarMode.Sweep}" />
                            <Slider x:Name="SliderSpeed" Header="Speed" Maximum="3" Minimum="-3" StepFrequency="0.1" Value="1" />
                            <Slider x:Name="SliderTrail" Header="Trail" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.35" />
                            <ToggleSwitch x:Name="TglPaused" Header="Paused" />
                            <ToggleSwitch x:Name="TglMouse" Header="Mouse interaction" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Colors">
                        <local:OptionPanel>
                            <local:ColorOption Brush="{x:Bind RadarMain.Foreground, Mode=TwoWay}" Header="Foreground (Radar)" />
                            <local:ColorOption x:Name="ClrTarget" Header="TargetBrush (Radar)" Value="#FF5CC8FF" />
                            <local:ColorOption Brush="{x:Bind RadarBlips.Foreground, Mode=TwoWay}" Header="Foreground (Blips)" />
                            <local:ColorOption x:Name="ClrAircraft" Header="Aircraft Color (Blips)" Value="#FFFFB020" />
                            <local:ColorOption x:Name="ClrHostile" Header="Hostile Color (Blips)" Value="#FFFF5C5C" />
                            <local:ColorOption x:Name="ClrFriendly" Header="Friendly Color (Blips)" Value="#FF5CC8FF" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Grid and clutter">
                        <local:OptionPanel>
                            <Slider x:Name="SliderRings" Header="Ring count" Maximum="12" Minimum="0" Value="6" />
                            <Slider x:Name="SliderSpokes" Header="Spoke count" Maximum="36" Minimum="0" Value="12" />
                            <Slider x:Name="SliderClutter" Header="Clutter" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.35" />
                            <Slider x:Name="SliderGlow" Header="Glow" Maximum="3" Minimum="0" StepFrequency="0.1" Value="1" />
                            <ToggleSwitch x:Name="TglTicks" Header="Ticks" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Blips">
                        <local:OptionPanel>
                            <Slider x:Name="SliderTrailLength" Header="Trail length (seconds)" Maximum="20" Minimum="0" Value="6" />
                            <local:ChoiceOption x:Name="CmbState" Header="State (Unknown contact)" Value="{x:Bind dev:RadarBlipState.Alert}" />
                            <local:ChoiceOption x:Name="CmbMarker" Header="Marker (Alpha contact)" Value="{x:Bind dev:RadarMarker.Diamond}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Radar">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Radar Mode="Sweep" Speed="1" Trail="0.35" RingCount="6" Foreground="#00FF7F" TargetBrush="#5CC8FF" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar x:Name="RadarMain" Height="380" Clutter="{x:Bind SliderClutter.Value, Mode=OneWay}" Glow="{x:Bind SliderGlow.Value, Mode=OneWay}" Mode="{x:Bind ((dev:RadarMode)CmbMode.Value), Mode=OneWay}" MouseInteraction="{x:Bind TglMouse.IsOn, Mode=OneWay}" Paused="{x:Bind TglPaused.IsOn, Mode=OneWay}" RingCount="{x:Bind (x:Int32)SliderRings.Value, Mode=OneWay}" Speed="{x:Bind SliderSpeed.Value, Mode=OneWay}" SpokeCount="{x:Bind (x:Int32)SliderSpokes.Value, Mode=OneWay}" TargetBrush="{x:Bind ClrTarget.Brush, Mode=OneWay}" Targets="4" Ticks="{x:Bind TglTicks.IsOn, Mode=OneWay}" Trail="{x:Bind SliderTrail.Value, Mode=OneWay}" />
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Blips, labels, trails and states" Xaml="Win2d/Radar/RadarBlips_xaml.txt">
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar x:Name="RadarBlips" Height="380" Clutter="0.15" Targets="0">
                                <dev:RadarBlip Angle="40" Distance="1.15" EndDistance="0" Foreground="{x:Bind ClrAircraft.Brush, Mode=OneWay}" Label="AC-101&#x0a;FL350" Marker="Plane" Motion="Linear" Repeat="Loop" TrailLength="{x:Bind SliderTrailLength.Value, Mode=OneWay}" Duration="14" />
                                <dev:RadarBlip Angle="300" Distance="0.8" EndAngle="60" EndDistance="0.3" Foreground="{x:Bind ClrAircraft.Brush, Mode=OneWay}" Label="AC-207" Marker="Plane" Motion="Linear" Repeat="PingPong" TrailLength="{x:Bind SliderTrailLength.Value, Mode=OneWay}" Duration="8" />
                                <dev:RadarBlip Angle="120" Distance="0.6" Foreground="{x:Bind ClrHostile.Brush, Mode=OneWay}" Label="UNKNOWN" Marker="Diamond" Size="3.5" State="{x:Bind ((dev:RadarBlipState)CmbState.Value), Mode=OneWay}" />
                                <dev:RadarBlip Angle="235" Distance="0.45" Foreground="{x:Bind ClrFriendly.Brush, Mode=OneWay}" Label="ALPHA" Marker="{x:Bind ((dev:RadarMarker)CmbMarker.Value), Mode=OneWay}" State="Selected" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
            <local:ControlExample Title="Radar Visibility, Zones and Effects" Doc="controls/radar">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Scan-only visibility">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbTargetVisibility" Header="Target visibility" Value="{x:Bind dev:RadarVisibility.ScanOnly}" />
                            <local:ChoiceOption x:Name="CmbBlipVisibility" Header="Blip visibility (default)" Value="{x:Bind dev:RadarVisibility.ScanOnly}" />
                            <local:ChoiceOption x:Name="CmbScanMode" Header="Mode" Value="{x:Bind dev:RadarMode.Sweep}" />
                            <Slider x:Name="SliderScanFade" Header="Scan fade" Maximum="6" Minimum="0.5" StepFrequency="0.1" Value="2" />
                            <Slider x:Name="SliderScanTrail" Header="Trail" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.35" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Colors">
                        <local:OptionPanel>
                            <local:ColorOption Brush="{x:Bind RadarScan.Foreground, Mode=TwoWay}" Header="Foreground (Scan-only)" />
                            <local:ColorOption x:Name="ClrScanTarget" Header="TargetBrush (Scan-only)" Value="#FF5CC8FF" />
                            <local:ColorOption Brush="{x:Bind RadarZones.Foreground, Mode=TwoWay}" Header="Foreground (Zones)" />
                            <local:ColorOption Brush="{x:Bind RadarEffects.Foreground, Mode=TwoWay}" Header="Foreground (Effects)" />
                            <local:ColorOption x:Name="ClrEffectsTarget" Header="TargetBrush (Effects)" Value="#FF5CC8FF" />
                            <local:ColorOption x:Name="ClrAircraft2" Header="Aircraft Color" Value="#FFFFB020" />
                            <local:ColorOption x:Name="ClrHostile2" Header="Hostile Color" Value="#FFFF5C5C" />
                            <local:ColorOption x:Name="ClrFriendly2" Header="Friendly Color" Value="#FF5CC8FF" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Zones, jams and scale">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TglRangeLabels" Header="Range labels" IsOn="True" />
                            <ToggleSwitch x:Name="TglCompass" Header="Compass" IsOn="True" />
                            <ToggleSwitch x:Name="TglReadout" Header="Cursor readout" IsOn="True" />
                            <Slider x:Name="SliderMaxRange" Header="Max range (km)" Maximum="500" Minimum="10" StepFrequency="10" Value="200" />
                            <ToggleSwitch x:Name="TglZoneScan" Header="Corridor visible only when scanned" IsOn="True" />
                            <Slider x:Name="SliderZoneFill" Header="Zone fill opacity" Maximum="0.5" Minimum="0" StepFrequency="0.02" Value="0.12" />
                            <Slider x:Name="SliderJam" Header="Jam intensity" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.7" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Effects">
                        <local:OptionPanel>
                            <Slider x:Name="SliderPhosphor" Header="Phosphor" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.5" />
                            <Slider x:Name="SliderTilt" Header="Tilt" Maximum="80" Minimum="-80" Value="40" />
                            <Slider x:Name="SliderFade" Header="Edge fade" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.5" />
                            <Slider x:Name="SliderGrain" Header="Grain" Maximum="0.3" Minimum="0" StepFrequency="0.01" Value="0.05" />
                            <Slider x:Name="SliderBrightness" Header="Brightness" Maximum="2" Minimum="0.2" StepFrequency="0.1" Value="1" />
                            <Slider x:Name="SliderLineWidth" Header="Line width" Maximum="4" Minimum="0.5" StepFrequency="0.25" Value="1" />
                            <ToggleSwitch x:Name="TglLight" Header="Light mode" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Scan-only visibility" Xaml="Win2d/Radar/RadarScanOnly_xaml.txt">
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar x:Name="RadarScan" Height="380" BlipVisibility="{x:Bind ((dev:RadarVisibility)CmbBlipVisibility.Value), Mode=OneWay}" Clutter="0.1" Mode="{x:Bind ((dev:RadarMode)CmbScanMode.Value), Mode=OneWay}" ScanFade="{x:Bind SliderScanFade.Value, Mode=OneWay}" TargetBrush="{x:Bind ClrScanTarget.Brush, Mode=OneWay}" TargetVisibility="{x:Bind ((dev:RadarVisibility)CmbTargetVisibility.Value), Mode=OneWay}" Targets="5" Trail="{x:Bind SliderScanTrail.Value, Mode=OneWay}">
                                <dev:RadarBlip Angle="40" Distance="1.15" EndDistance="0" Foreground="{x:Bind ClrAircraft2.Brush, Mode=OneWay}" Marker="Plane" Motion="Linear" Repeat="Loop" Duration="14" />
                                <dev:RadarBlip Angle="150" Distance="0.65" Foreground="{x:Bind ClrHostile2.Brush, Mode=OneWay}" Marker="Diamond" Size="3.5" />
                                <dev:RadarBlip Angle="260" Distance="0.5" Foreground="{x:Bind ClrAircraft2.Brush, Mode=OneWay}" Marker="Square" Visibility="Always" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Zones, jammed sectors and scale" Xaml="Win2d/Radar/RadarZones_xaml.txt">
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar x:Name="RadarZones" Height="400" Clutter="0.1" MaxRange="{x:Bind SliderMaxRange.Value, Mode=OneWay}" RadarScale="0.8" RangeUnit="km" ShowCompass="{x:Bind TglCompass.IsOn, Mode=OneWay}" ShowRangeLabels="{x:Bind TglRangeLabels.IsOn, Mode=OneWay}" ShowReadout="{x:Bind TglReadout.IsOn, Mode=OneWay}" Targets="0">
                                <dev:Radar.Zones>
                                    <dev:RadarZone Angle="200" Distance="0.55" FillOpacity="{x:Bind SliderZoneFill.Value, Mode=OneWay}" Foreground="{x:Bind ClrHostile2.Brush, Mode=OneWay}" Label="RESTRICTED" Radius="0.18" Shape="Circle" />
                                    <dev:RadarZone FillOpacity="{x:Bind SliderZoneFill.Value, Mode=OneWay}" Foreground="{x:Bind ClrFriendly2.Brush, Mode=OneWay}" Label="CORRIDOR" Points="20,0.35 50,0.9 80,0.9 60,0.35" Shape="Polygon" Visibility="{x:Bind ZoneVisibility(TglZoneScan.IsOn), Mode=OneWay}" />
                                </dev:Radar.Zones>
                                <dev:Radar.Jams>
                                    <dev:RadarJam EndAngle="330" Foreground="{x:Bind ClrHostile2.Brush, Mode=OneWay}" Intensity="{x:Bind SliderJam.Value, Mode=OneWay}" StartAngle="285" />
                                </dev:Radar.Jams>
                                <dev:RadarBlip Angle="310" Distance="0.6" Foreground="{x:Bind ClrAircraft2.Brush, Mode=OneWay}" Label="JAMMED" Marker="Plane" />
                                <dev:RadarBlip Angle="70" Distance="0.6" EndAngle="30" EndDistance="0.85" Foreground="{x:Bind ClrAircraft2.Brush, Mode=OneWay}" Label="IN CORRIDOR" Marker="Plane" Motion="Linear" Repeat="PingPong" Duration="12" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Effects">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Radar Phosphor="0.5" Tilt="40" Fade="0.5" Grain="0.05" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="{x:Bind ThemeOf(TglLight.IsOn), Mode=OneWay}">
                            <dev:Radar x:Name="RadarEffects" Height="400" Brightness="{x:Bind SliderBrightness.Value, Mode=OneWay}" CenterY="0.55" Fade="{x:Bind SliderFade.Value, Mode=OneWay}" Grain="{x:Bind SliderGrain.Value, Mode=OneWay}" LightMode="{x:Bind TglLight.IsOn, Mode=OneWay}" LineWidth="{x:Bind SliderLineWidth.Value, Mode=OneWay}" Phosphor="{x:Bind SliderPhosphor.Value, Mode=OneWay}" TargetBrush="{x:Bind ClrEffectsTarget.Brush, Mode=OneWay}" Targets="4" Tilt="{x:Bind SliderTilt.Value, Mode=OneWay}">
                                <dev:RadarBlip Angle="40" Distance="1.15" EndDistance="0" Foreground="{x:Bind ClrAircraft2.Brush, Mode=OneWay}" Marker="Plane" Motion="Linear" Repeat="Loop" Duration="14" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
            <local:ControlExample Title="Radar Data Binding" CSharp="Win2d/Radar/RadarBinding_cs.txt" Doc="controls/radar" Xaml="Win2d/Radar/RadarBinding_xaml.txt">
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <ToggleSwitch x:Name="TglLive" Header="Live movement" IsOn="True" />
                        <local:ColorOption Brush="{x:Bind RadarBinding.Foreground, Mode=TwoWay}" Header="Foreground" />
                        <local:ColorOption Header="Aircraft Color" ValueChanged="OnAircraftColorChanged" Value="#FFFFB020" />
                        <Button Click="AddAircraft_Click" Content="Add aircraft" />
                        <Button Click="RemoveAircraft_Click" Content="Remove last aircraft" />
                        <Button Click="ToggleAlert_Click" Content="Toggle alert on first aircraft" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                    <dev:Radar x:Name="RadarBinding" Height="380" Clutter="0.1" ItemMapper="{x:Bind Mapper}" ItemsSource="{x:Bind Aircraft}" Targets="0" />
                </Grid>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
