<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.RadarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Page.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Default">
                    <SolidColorBrush x:Key="AircraftBrush" Color="#FFB020" />
                    <SolidColorBrush x:Key="HostileBrush" Color="#FF5C5C" />
                    <SolidColorBrush x:Key="FriendlyBrush" Color="#5CC8FF" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AircraftBrush" Color="#B86E00" />
                    <SolidColorBrush x:Key="HostileBrush" Color="#C42B1C" />
                    <SolidColorBrush x:Key="FriendlyBrush" Color="#005FB8" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="AircraftBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="HostileBrush" ResourceKey="SystemColorHighlightColorBrush" />
                    <StaticResource x:Key="FriendlyBrush" ResourceKey="SystemColorHighlightColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="Radar" Doc="controls/radar">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Scan">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbMode" Header="Mode">
                                <local:ChoiceOption.Value>
                                    <dev:RadarMode>Sweep</dev:RadarMode>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <Slider x:Name="SliderSpeed" Header="Speed" Maximum="3" Minimum="-3" StepFrequency="0.1" Value="1" />
                            <Slider x:Name="SliderTrail" Header="Trail" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.35" />
                            <ToggleSwitch x:Name="TglPaused" Header="Paused" />
                            <ToggleSwitch x:Name="TglMouse" Header="Mouse interaction" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Grid and clutter">
                        <local:OptionPanel>
                            <Slider x:Name="SliderRings" Header="Ring count" Maximum="12" Minimum="0" Value="6" />
                            <Slider x:Name="SliderSpokes" Header="Spoke count" Maximum="36" Minimum="0" Value="12" />
                            <Slider x:Name="SliderClutter" Header="Clutter" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.35" />
                            <Slider x:Name="SliderGlow" Header="Glow" Maximum="3" Minimum="0" StepFrequency="0.1" Value="1" />
                            <ToggleSwitch x:Name="TglTicks" Header="Ticks" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Blips">
                        <local:OptionPanel>
                            <Slider x:Name="SliderTrailLength" Header="Trail length (seconds)" Maximum="20" Minimum="0" Value="6" />
                            <local:ChoiceOption x:Name="CmbState" Header="State (Unknown contact)">
                                <local:ChoiceOption.Value>
                                    <dev:RadarBlipState>Alert</dev:RadarBlipState>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbMarker" Header="Marker (Alpha contact)">
                                <local:ChoiceOption.Value>
                                    <dev:RadarMarker>Diamond</dev:RadarMarker>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Scan-only visibility">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbTargetVisibility" Header="Target visibility">
                                <local:ChoiceOption.Value>
                                    <dev:RadarVisibility>ScanOnly</dev:RadarVisibility>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbBlipVisibility" Header="Blip visibility (default)">
                                <local:ChoiceOption.Value>
                                    <dev:RadarVisibility>ScanOnly</dev:RadarVisibility>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbScanMode" Header="Mode">
                                <local:ChoiceOption.Value>
                                    <dev:RadarMode>Sweep</dev:RadarMode>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <Slider x:Name="SliderScanFade" Header="Scan fade" Maximum="6" Minimum="0.5" StepFrequency="0.1" Value="2" />
                            <Slider x:Name="SliderScanTrail" Header="Trail" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.35" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Zones, jams and scale">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TglRangeLabels" Header="Range labels" IsOn="True" />
                            <ToggleSwitch x:Name="TglCompass" Header="Compass" IsOn="True" />
                            <ToggleSwitch x:Name="TglReadout" Header="Cursor readout" IsOn="True" />
                            <Slider x:Name="SliderMaxRange" Header="Max range (km)" Maximum="500" Minimum="10" StepFrequency="10" Value="200" />
                            <ToggleSwitch x:Name="TglZoneScan" Header="Corridor visible only when scanned" IsOn="True" />
                            <Slider x:Name="SliderZoneFill" Header="Zone fill opacity" Maximum="0.5" Minimum="0" StepFrequency="0.02" Value="0.12" />
                            <Slider x:Name="SliderJam" Header="Jam intensity" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.7" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Effects">
                        <local:OptionPanel>
                            <Slider x:Name="SliderPhosphor" Header="Phosphor" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.5" />
                            <Slider x:Name="SliderTilt" Header="Tilt" Maximum="80" Minimum="-80" Value="40" />
                            <Slider x:Name="SliderFade" Header="Edge fade" Maximum="1" Minimum="0" StepFrequency="0.05" Value="0.5" />
                            <Slider x:Name="SliderGrain" Header="Grain" Maximum="0.3" Minimum="0" StepFrequency="0.01" Value="0.05" />
                            <Slider x:Name="SliderBrightness" Header="Brightness" Maximum="2" Minimum="0.2" StepFrequency="0.1" Value="1" />
                            <Slider x:Name="SliderLineWidth" Header="Line width" Maximum="4" Minimum="0.5" StepFrequency="0.25" Value="1" />
                            <ToggleSwitch x:Name="TglLight" Header="Light mode" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Data binding">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TglLive" Header="Live movement" IsOn="True" />
                            <Button Click="AddAircraft_Click" Content="Add aircraft" />
                            <Button Click="RemoveAircraft_Click" Content="Remove last aircraft" />
                            <Button Click="ToggleAlert_Click" Content="Toggle alert on first aircraft" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="Radar">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Radar Mode="Sweep" Speed="1" Trail="0.35" RingCount="6" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar Height="380" Clutter="{x:Bind SliderClutter.Value, Mode=OneWay}" Glow="{x:Bind SliderGlow.Value, Mode=OneWay}" Mode="{x:Bind ((dev:RadarMode)CmbMode.Value), Mode=OneWay}" MouseInteraction="{x:Bind TglMouse.IsOn, Mode=OneWay}" Paused="{x:Bind TglPaused.IsOn, Mode=OneWay}" RingCount="{x:Bind (x:Int32)SliderRings.Value, Mode=OneWay}" Speed="{x:Bind SliderSpeed.Value, Mode=OneWay}" SpokeCount="{x:Bind (x:Int32)SliderSpokes.Value, Mode=OneWay}" TargetBrush="{ThemeResource FriendlyBrush}" Targets="4" Ticks="{x:Bind TglTicks.IsOn, Mode=OneWay}" Trail="{x:Bind SliderTrail.Value, Mode=OneWay}" />
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Blips, labels, trails and states" Xaml="Win2d/Radar/RadarBlips_xaml.txt">
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar Height="380" Clutter="0.15" Targets="0">
                                <dev:RadarBlip Angle="40" Distance="1.15" EndDistance="0" Foreground="{ThemeResource AircraftBrush}" Label="AC-101&#x0a;FL350" Marker="Plane" Motion="Linear" Repeat="Loop" TrailLength="{x:Bind SliderTrailLength.Value, Mode=OneWay}" Duration="14" />
                                <dev:RadarBlip Angle="300" Distance="0.8" EndAngle="60" EndDistance="0.3" Foreground="{ThemeResource AircraftBrush}" Label="AC-207" Marker="Plane" Motion="Linear" Repeat="PingPong" TrailLength="{x:Bind SliderTrailLength.Value, Mode=OneWay}" Duration="8" />
                                <dev:RadarBlip Angle="120" Distance="0.6" Foreground="{ThemeResource HostileBrush}" Label="UNKNOWN" Marker="Diamond" Size="3.5" State="{x:Bind ((dev:RadarBlipState)CmbState.Value), Mode=OneWay}" />
                                <dev:RadarBlip Angle="235" Distance="0.45" Foreground="{ThemeResource FriendlyBrush}" Label="ALPHA" Marker="{x:Bind ((dev:RadarMarker)CmbMarker.Value), Mode=OneWay}" State="Selected" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Scan-only visibility" Xaml="Win2d/Radar/RadarScanOnly_xaml.txt">
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar Height="380" BlipVisibility="{x:Bind ((dev:RadarVisibility)CmbBlipVisibility.Value), Mode=OneWay}" Clutter="0.1" Mode="{x:Bind ((dev:RadarMode)CmbScanMode.Value), Mode=OneWay}" ScanFade="{x:Bind SliderScanFade.Value, Mode=OneWay}" TargetBrush="{ThemeResource FriendlyBrush}" TargetVisibility="{x:Bind ((dev:RadarVisibility)CmbTargetVisibility.Value), Mode=OneWay}" Targets="5" Trail="{x:Bind SliderScanTrail.Value, Mode=OneWay}">
                                <dev:RadarBlip Angle="40" Distance="1.15" EndDistance="0" Foreground="{ThemeResource AircraftBrush}" Marker="Plane" Motion="Linear" Repeat="Loop" Duration="14" />
                                <dev:RadarBlip Angle="150" Distance="0.65" Foreground="{ThemeResource HostileBrush}" Marker="Diamond" Size="3.5" />
                                <dev:RadarBlip Angle="260" Distance="0.5" Foreground="{ThemeResource AircraftBrush}" Marker="Square" Visibility="Always" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Zones, jammed sectors and scale" Xaml="Win2d/Radar/RadarZones_xaml.txt">
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar Height="400" Clutter="0.1" MaxRange="{x:Bind SliderMaxRange.Value, Mode=OneWay}" RadarScale="0.8" RangeUnit="km" ShowCompass="{x:Bind TglCompass.IsOn, Mode=OneWay}" ShowRangeLabels="{x:Bind TglRangeLabels.IsOn, Mode=OneWay}" ShowReadout="{x:Bind TglReadout.IsOn, Mode=OneWay}" Targets="0">
                                <dev:Radar.Zones>
                                    <dev:RadarZone Angle="200" Distance="0.55" FillOpacity="{x:Bind SliderZoneFill.Value, Mode=OneWay}" Foreground="{ThemeResource HostileBrush}" Label="RESTRICTED" Radius="0.18" Shape="Circle" />
                                    <dev:RadarZone FillOpacity="{x:Bind SliderZoneFill.Value, Mode=OneWay}" Foreground="{ThemeResource FriendlyBrush}" Label="CORRIDOR" Points="20,0.35 50,0.9 80,0.9 60,0.35" Shape="Polygon" Visibility="{x:Bind ZoneVisibility(TglZoneScan.IsOn), Mode=OneWay}" />
                                </dev:Radar.Zones>
                                <dev:Radar.Jams>
                                    <dev:RadarJam EndAngle="330" Foreground="{ThemeResource HostileBrush}" Intensity="{x:Bind SliderJam.Value, Mode=OneWay}" StartAngle="285" />
                                </dev:Radar.Jams>
                                <dev:RadarBlip Angle="310" Distance="0.6" Foreground="{ThemeResource AircraftBrush}" Label="JAMMED" Marker="Plane" />
                                <dev:RadarBlip Angle="70" Distance="0.6" EndAngle="30" EndDistance="0.85" Foreground="{ThemeResource AircraftBrush}" Label="IN CORRIDOR" Marker="Plane" Motion="Linear" Repeat="PingPong" Duration="12" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Effects">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Radar Phosphor="0.5" Tilt="40" Fade="0.5" Grain="0.05" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="{x:Bind ThemeOf(TglLight.IsOn), Mode=OneWay}">
                            <dev:Radar Height="400" Brightness="{x:Bind SliderBrightness.Value, Mode=OneWay}" CenterY="0.55" Fade="{x:Bind SliderFade.Value, Mode=OneWay}" Grain="{x:Bind SliderGrain.Value, Mode=OneWay}" LightMode="{x:Bind TglLight.IsOn, Mode=OneWay}" LineWidth="{x:Bind SliderLineWidth.Value, Mode=OneWay}" Phosphor="{x:Bind SliderPhosphor.Value, Mode=OneWay}" TargetBrush="{ThemeResource FriendlyBrush}" Targets="4" Tilt="{x:Bind SliderTilt.Value, Mode=OneWay}">
                                <dev:RadarBlip Angle="40" Distance="1.15" EndDistance="0" Foreground="{ThemeResource AircraftBrush}" Marker="Plane" Motion="Linear" Repeat="Loop" Duration="14" />
                            </dev:Radar>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Data binding" CSharp="Win2d/Radar/RadarBinding_cs.txt" Xaml="Win2d/Radar/RadarBinding_xaml.txt">
                        <Grid Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" RequestedTheme="Dark">
                            <dev:Radar Height="380" Clutter="0.1" ItemMapper="{x:Bind Mapper}" ItemsSource="{x:Bind Aircraft}" Targets="0" />
                        </Grid>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
