<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.RelativeDatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="RelativeDate" Doc="common/relativeDate" DocType="Core">
                <local:ControlExample2.CSharpCode>
                    <x:String>
                        var relativeDate = RelativeDate.Get(dateTime).ToString();
                    </x:String>
                </local:ControlExample2.CSharpCode>
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <DatePicker x:Name="DatePickerSample" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind GetPersian(DatePickerSample.SelectedDate), Mode=OneWay}" />
                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind GetDefault(DatePickerSample.SelectedDate), Mode=OneWay}" />
                </StackPanel>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
