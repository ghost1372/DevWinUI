<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.RainbowFramePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="RainbowFrame" CSharp="Features/Others/RainbowFramePage_cs.txt" Doc="common/rainbowFrame" DocType="Core" ResetRequested="ControlExample_ResetRequested">
                <StackPanel Margin="10" Spacing="10">
                    <Button x:Name="btnFixed" Click="btnFixed_Click" Content="Change Window Frame Color to Red" />
                    <Button x:Name="btnRainbow" Click="btnRainbow_Click" Content="Start Rainbow" />
                    <NumberBox x:Name="nbEffectSpeed" Header="Effect Speed" Minimum="1" SpinButtonPlacementMode="Inline" ValueChanged="nbEffectSpeed_ValueChanged" Value="4" />
                    <MenuFlyoutSeparator Margin="0,10" />
                </StackPanel>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
