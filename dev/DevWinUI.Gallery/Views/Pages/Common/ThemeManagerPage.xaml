<Page x:Class="DevWinUIGallery.Views.ThemeManagerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DevWinUIGallery">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <InfoBar Title="You can simplify the operation of saving, retrieving and selecting the Application theme, All operations are performed automatically." IsClosable="False" IsOpen="True" Severity="Informational" />
            <InfoBar Title="Dont forget to Initialize `ThemeService` in your App.cs" IsClosable="False" IsOpen="True" Severity="Warning" />
            <local:ControlExample Title="ThemeManager" Doc="themeService" DocType="Core">
                <local:ControlExample.Samples>
                    <local:Sample Title="Theme" CSharp="Features/ThemeManager/ThemeManagerPage_Theme_cs.txt" Xaml="Features/ThemeManager/ThemeManagerPage_Theme_xaml.txt">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel x:Name="themePanel" Margin="10">
                                <RadioButton Checked="OnThemeRadioButtonChecked" Content="Use system setting" Tag="Default" />
                                <RadioButton Checked="OnThemeRadioButtonChecked" Content="Light" Tag="Light" />
                                <RadioButton Checked="OnThemeRadioButtonChecked" Content="Dark" Tag="Dark" />
                            </StackPanel>

                            <local:ChoiceOption x:Name="cmbTheme" Header="Theme" ValueChanged="cmbTheme_ValueChanged" />
                        </StackPanel>
                    </local:Sample>

                    <local:Sample Title="Backdrop" CSharp="Features/ThemeManager/ThemeManagerPage_Backdrop_cs.txt" Xaml="Features/ThemeManager/ThemeManagerPage_Backdrop_xaml.txt">
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <StackPanel x:Name="backdropPanel" Margin="10">
                                <RadioButton Checked="OnBackdropRadioButtonChecked" Content="None" Tag="None" />
                                <RadioButton Checked="OnBackdropRadioButtonChecked" Content="Mica" Tag="Mica" />
                                <RadioButton Checked="OnBackdropRadioButtonChecked" Content="MicaAlt" Tag="MicaAlt" />
                                <RadioButton Checked="OnBackdropRadioButtonChecked" Content="Acrylic" Tag="Acrylic" />
                                <RadioButton Checked="OnBackdropRadioButtonChecked" Content="Acrylic Thin" Tag="AcrylicThin" />
                                <RadioButton Checked="OnBackdropRadioButtonChecked" Content="Transparent" Tag="Transparent" />
                            </StackPanel>

                            <local:ChoiceOption x:Name="cmbBackdrop" Header="Backdrop" ValueChanged="cmbBackdrop_ValueChanged" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
