<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LegacyMessageBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="LegacyMessageBox" Doc="common/messageBox" DocType="Core">
                <local:ControlExample2.CSharpCode>
                    <x:String>
                        LegacyMessageBox.Show(window, "Message", "Title", MessageBoxStyle.IconInformation);
                    </x:String>
                </local:ControlExample2.CSharpCode>

                <Button x:Name="BtnMessageBox" Click="BtnMessageBox_Click" Content="Show MessageBox" />
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
