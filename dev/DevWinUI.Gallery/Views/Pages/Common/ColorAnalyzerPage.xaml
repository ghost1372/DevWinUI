<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ColorAnalyzerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery">

    <Page.Resources>
        <dev:ColorAnalyzer x:Name="ColorAnalyzerSample" Source="{x:Bind ImageSample}">
            <dev:AccentColorAnalyzer x:Name="AccentColorAnalyzerSample" MinColorCount="3" />
            <dev:BaseColorAnalyzer x:Name="BaseColorAnalyzerSample" MinColorCount="3" />
            <dev:ColorWeightAnalyzer x:Name="ColorWeightAnalyzerSample" MinColorCount="3" />
        </dev:ColorAnalyzer>
    </Page.Resources>

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="ColorAnalyzer" Description="Extract accent, base and weighted colors from an image." Doc="common/colorAnalyzer" DocType="Core" Xaml="Features/Others/ColorAnalyzer_xaml.txt">
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <Button x:Name="BtnChange" HorizontalAlignment="Stretch" Click="BtnChange_Click" Content="Change Image" />
                        <Image x:Name="ImageSample" Width="200" Height="200" HorizontalAlignment="Center" ImageOpened="ImageSample_ImageOpened" Source="ms-appx:///Assets/Carousel/5.jpg" Stretch="Uniform" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <local:ControlExample2.Samples>
                    <local:Sample Title="Accent">
                        <Grid Width="400" Height="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="0.6*" />
                                <RowDefinition Height="0.4*" />
                            </Grid.RowDefinitions>
                            <Border Grid.ColumnSpan="2" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind AccentColorAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind AccentColorAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" Text="Primary Accent" />
                            </Border>
                            <Border Grid.Row="1" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind AccentColorAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind AccentColorAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" Text="Secondary Accent" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind AccentColorAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind AccentColorAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" Text="Tertiary Accent" />
                            </Border>
                            <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Margin="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="{x:Bind AccentColorAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" />
                                        <GradientStop Offset="0.6" Color="{x:Bind AccentColorAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" />
                                        <GradientStop Offset="1" Color="{x:Bind AccentColorAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Base">
                        <Grid Width="400" Height="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="0.6*" />
                                <RowDefinition Height="0.4*" />
                            </Grid.RowDefinitions>
                            <Border Grid.ColumnSpan="2" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind BaseColorAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind BaseColorAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" Text="Primary Base" />
                            </Border>
                            <Border Grid.Row="1" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind BaseColorAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind BaseColorAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" Text="Secondary Base" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind BaseColorAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind BaseColorAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" Text="Tertiary Base" />
                            </Border>
                            <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Margin="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="{x:Bind BaseColorAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" />
                                        <GradientStop Offset="0.6" Color="{x:Bind BaseColorAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" />
                                        <GradientStop Offset="1" Color="{x:Bind BaseColorAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </local:Sample>
                    <local:Sample Title="Weight">
                        <Grid Width="400" Height="250">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="0.6*" />
                                <RowDefinition Height="0.4*" />
                            </Grid.RowDefinitions>
                            <Border Grid.ColumnSpan="2" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind ColorWeightAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind ColorWeightAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" Text="Primary Weight" />
                            </Border>
                            <Border Grid.Row="1" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind ColorWeightAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind ColorWeightAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" Text="Secondary Weight" />
                            </Border>
                            <Border Grid.Row="1" Grid.Column="1" Margin="4" Padding="2">
                                <Border.Background>
                                    <SolidColorBrush Color="{x:Bind ColorWeightAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" />
                                </Border.Background>
                                <TextBlock dev:ContrastAnalyzer.Opponent="{x:Bind ColorWeightAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" Text="Tertiary Weight" />
                            </Border>
                            <Rectangle Grid.Row="2" Grid.ColumnSpan="2" Margin="4">
                                <Rectangle.Fill>
                                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                        <GradientStop Offset="0" Color="{x:Bind ColorWeightAnalyzerSample.SelectedColors[0], FallbackValue=Transparent, Mode=OneWay}" />
                                        <GradientStop Offset="0.6" Color="{x:Bind ColorWeightAnalyzerSample.SelectedColors[1], FallbackValue=Transparent, Mode=OneWay}" />
                                        <GradientStop Offset="1" Color="{x:Bind ColorWeightAnalyzerSample.SelectedColors[2], FallbackValue=Transparent, Mode=OneWay}" />
                                    </LinearGradientBrush>
                                </Rectangle.Fill>
                            </Rectangle>
                        </Grid>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
