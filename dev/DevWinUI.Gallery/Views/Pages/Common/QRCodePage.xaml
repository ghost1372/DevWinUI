<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.QRCodePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="QRCode" Doc="common/qRCode" DocType="Core">
                <local:ControlExample2.CSharpCode>
                    <x:String>
                        var standardQr = QRCode.Create("DevWinUI", ErrorCorrectionLevel.High);
                    </x:String>
                </local:ControlExample2.CSharpCode>
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <TextBox Name="TxtInput" PlaceholderText="Input" Text="DevWinUI" />
                        <local:ChoiceOption x:Name="CmbError" Header="Error Correction Level" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <Image Source="{x:Bind GenerateImage(TxtInput.Text, CmbError.Value), Mode=OneWay}" />
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
