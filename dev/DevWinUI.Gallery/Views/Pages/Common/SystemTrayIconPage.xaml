<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SystemTrayIconPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="SystemTrayIcon" CSharp="Features/Others/SystemTrayIconPage_cs.txt" Doc="common/systemTrayIcon" DocType="Core">
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <TextBox x:Name="TxtToolTip" Header="ToolTip" PlaceholderText="AppName" Text="ToolTip" TextChanged="TxtToolTip_TextChanged" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <ToggleSwitch x:Name="TGIsVisible" Header="IsVisible" IsOn="True" Toggled="TGIsVisible_Toggled" />
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
