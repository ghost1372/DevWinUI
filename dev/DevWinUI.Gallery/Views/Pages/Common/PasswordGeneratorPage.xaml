<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.PasswordGeneratorPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="Password Generator" Doc="common/passwordGenerator" DocType="Core">
                <local:ControlExample2.Samples>
                    <local:Sample Title="Generate Password" CSharp="Features/Others/PasswordGeneratorPage_cs.txt">
                        <StackPanel Spacing="10">
                            <TextBox x:Name="TxtPassResult" HorizontalAlignment="Stretch" Header="Generated Password" IsReadOnly="True" />
                        </StackPanel>
                    </local:Sample>

                    <local:Sample Title="Password Strength">
                        <local:Sample.CSharpCode>
                            <x:String>
                                var result = PasswordGenerator.GetPasswordStrength("myPassword");
                            </x:String>
                        </local:Sample.CSharpCode>
                        <StackPanel Spacing="10">
                            <TextBox x:Name="TxtPass" HorizontalAlignment="Stretch" Header="Enter your Password" TextChanged="TxtPass_TextChanged" />
                            <InfoBar x:Name="InfoBarResult" HorizontalAlignment="Stretch" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>

                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Character Sets">
                        <local:OptionPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CheckBox x:Name="ChkUpper" Content="Upper Case" IsChecked="True" />
                                <CheckBox x:Name="ChkLower" Content="Lower Case" IsChecked="True" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CheckBox x:Name="ChkNumbers" Content="Numbers" IsChecked="True" />
                                <CheckBox x:Name="ChkMath" Content="Math" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CheckBox x:Name="ChkPunctuation" Content="Punctuation" />
                                <CheckBox x:Name="ChkBrackets" Content="Brackets" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CheckBox x:Name="ChkQuotes" Content="Quotes" />
                                <CheckBox x:Name="ChkSpecial" Content="Special" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <CheckBox x:Name="ChkSpaces" Content="Space" />
                                <NumberBox x:Name="NBLength" Header="Length" Maximum="256" Minimum="6" SpinButtonPlacementMode="Inline" Value="12" />
                            </StackPanel>
                        </local:OptionPanel>
                    </local:OptionGroup>

                    <local:OptionGroup Title="Generation">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TglRepeat" Header="Allow Repeating Characters" IsOn="True" />
                            <ToggleSwitch x:Name="TglEachChar" Header="Ensure Each Set Selected" IsOn="True" />
                            <ToggleSwitch x:Name="TglExcludeAmb" Header="Exclude Ambiguous Characters" />
                            <ToggleSwitch x:Name="TglReadable" Header="Readable Password" />
                            <Button x:Name="BtnGenerate" HorizontalAlignment="Stretch" Click="BtnGenerate_Click" Content="Generate Password" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
            </local:ControlExample2>

        </StackPanel>
    </ScrollViewer>

</Page>
