<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SunTimesHelperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="SunTimesHelper" Doc="helpers/sunTimesHelper" DocType="Core">
                <local:ControlExample.CSharpCode>
                    <x:String>
                        var sunTimes = SunTimesHelper.CalculateSunriseSunset(Latitude, Longitude, DateTime.Now.Year, DateTime.Now.Month, DateTime.Now.Day);
                    </x:String>
                </local:ControlExample.CSharpCode>
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <NumberBox x:Name="NBLatitude" Header="Latitude" Maximum="10000" Minimum="-10000" PlaceholderText="47.0313" SpinButtonPlacementMode="Inline" Value="47.0313" />
                        <NumberBox x:Name="NBLongitude" Header="Longitude" Maximum="10000" Minimum="-10000" PlaceholderText="48.4787" SpinButtonPlacementMode="Inline" Value="48.4787" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <StackPanel Spacing="10">
                    <InfoBar Title="Retrieve your current Latitude and Longitude" IsClosable="False" IsOpen="True" Message="Works only if location access is granted and your device supports reliable location services (e.g., GPS or Wi-Fi).  If your device does not have GPS, results may be inaccurate.">
                        <InfoBar.ActionButton>
                            <Button x:Name="BtnGetLocation" Click="BtnGetLocation_Click" Content="Get Latitude and Longitude" />
                        </InfoBar.ActionButton>
                    </InfoBar>
                    <InfoBar x:Name="InfoBarSource" Title="Position Source" IsClosable="False" IsOpen="True" Message="Position source will appear here after retrieving location." Severity="Warning" />
                    <Button x:Name="BtnCalc" Click="BtnCalc_Click" Content="Calculate Sunrise and Sunset" Style="{StaticResource AccentButtonStyle}" />
                    <TextBlock x:Name="TxtSunRise" Style="{ThemeResource TitleTextBlockStyle}" />
                    <TextBlock x:Name="TxtSunSet" Style="{ThemeResource TitleTextBlockStyle}" />
                </StackPanel>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>

</Page>
