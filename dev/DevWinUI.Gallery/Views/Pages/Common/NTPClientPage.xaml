<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.NTPClientPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="NTPClient" CSharp="Features/Others/NTPClientPage_cs.txt" Doc="common/ntpClient" DocType="Core">
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <TextBox Name="TxtServer" PlaceholderText="NTP Server" Text="pool.ntp.org" />
                        <Button x:Name="BtnGet" Click="BtnGet_Click" Content="Query" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <StackPanel Spacing="10">
                    <TextBlock x:Name="TxtTime" Style="{ThemeResource BaseTextBlockStyle}" />
                    <TextBlock x:Name="TxtOffset" Style="{ThemeResource BaseTextBlockStyle}" />
                    <TextBlock x:Name="TxtDelay" Style="{ThemeResource BaseTextBlockStyle}" />
                    <TextBlock x:Name="TxtStratum" Style="{ThemeResource BaseTextBlockStyle}" />
                </StackPanel>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
