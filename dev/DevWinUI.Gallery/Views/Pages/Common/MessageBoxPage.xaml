<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.MessageBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="MessageBox" Doc="controls/messageBox" DocType="Controls">
                <local:ControlExample2.CSharpCode>
                    <x:String>
                        await MessageBox.ShowAsync("Content", "Title");
                    </x:String>
                </local:ControlExample2.CSharpCode>
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Message">
                        <local:OptionPanel>
                            <TextBox x:Name="txtTitle" Header="Title" PlaceholderText="Title" Text="Title" />
                            <TextBox x:Name="txtContent" HorizontalAlignment="Stretch" Header="Content" PlaceholderText="Content" Text="Content" />
                            <local:ChoiceOption x:Name="CmbMessageBoxButtons" Header="MessageBox Buttons" />
                            <local:ChoiceOption x:Name="CmbMessageBoxDefaultButton" Header="MessageBox Default Button" />
                            <local:ChoiceOption x:Name="CmbMessageBoxIcon" Header="MessageBox Icon" />
                        </local:OptionPanel>
                    </local:OptionGroup>

                    <local:OptionGroup Title="Window">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbFlow" Header="FlowDirection" />
                            <local:ChoiceOption x:Name="CmbWindowStartupLocation" Header="WindowStartupLocation" />
                            <ToggleSwitch x:Name="TGHasOwnerWindow" Header="Has Owner Window?" IsOn="True" />
                            <ToggleSwitch x:Name="TGHasTitleBar" Header="Has TitleBar?" IsOn="True" />
                            <ToggleSwitch x:Name="TGDragMove" Header="Drag by Content" IsOn="False" />
                            <ToggleSwitch x:Name="TGCanResize" Header="Can Resize?" IsOn="True" />
                            <local:ChoiceOption x:Name="CmbUnderlayBackdrops" Header="Backdrop" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <StackPanel Spacing="10">
                    <Button Click="OnMessageBox" Content="Show MessageBox" Tag="None" HorizontalAlignment="Stretch" />
                    <Button Click="OnMessageBox" Content="Show Info MessageBox" Tag="Info" HorizontalAlignment="Stretch"/>
                    <Button Click="OnMessageBox" Content="Show Error MessageBox" Tag="Error" HorizontalAlignment="Stretch"/>
                    <Button Click="OnMessageBox" Content="Show Success MessageBox" Tag="Success" HorizontalAlignment="Stretch"/>
                    <Button Click="OnMessageBox" Content="Show Warning MessageBox" Tag="Warning" HorizontalAlignment="Stretch"/>
                    <Button Click="OnMessageBox" Content="Show Question MessageBox" Tag="Question" HorizontalAlignment="Stretch"/>
                    <TextBlock x:Name="TxtResult" Style="{ThemeResource TitleTextBlockStyle}" />
                </StackPanel>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
