<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.DragMoveAndResizePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="DragMoveHelper" Doc="helpers/dragMoveHelper" DocType="Core">
                <local:ControlExample2.CSharpCode>
                    <x:String>
                        new DragMoveHelper(myWindow).SetDragMove(DragElement);
                    </x:String>
                </local:ControlExample2.CSharpCode>

                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <ToggleSwitch x:Name="SampleTG" Header="IsDraggable" IsOn="True" Toggled="SampleTG_Toggled" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>

                <Grid x:Name="DragElement">
                    <Rectangle Width="400" Height="200" Fill="{ThemeResource SystemAccentColor}" />
                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource TitleTextBlockStyle}" Text="Drag And Move Me!" />
                </Grid>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
