<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.TextBlockHelperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="TextBlockHelper" Doc="helpers/textBlockHelper" DocType="Core">
                <local:ControlExample2.CSharpCode>
                    <x:String>
                        await TextBlockHelper.AnimateTextChangeAsync(myTextBlock, "New Text");
                    </x:String>
                </local:ControlExample2.CSharpCode>
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <local:ChoiceOption x:Name="CmbType" Header="Slide Direction" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <TextBlock x:Name="TextBlockSample" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource TitleTextBlockStyle}" />
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>

</Page>
