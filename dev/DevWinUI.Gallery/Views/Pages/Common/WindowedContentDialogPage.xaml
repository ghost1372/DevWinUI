<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.WindowedContentDialogPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="WindowedContentDialog" CSharp="Features/WindowedContentDialogPage_cs.txt" Doc="controls/windowedContentDialog" DocType="Controls">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Dialog">
                        <local:OptionPanel>
                            <TextBox x:Name="txtTitle" Header="Header" PlaceholderText="Header" Text="Header" />
                            <TextBox x:Name="txtContent" Header="Content" PlaceholderText="Content" Text="Content" />
                            <local:ChoiceOption x:Name="CmbButtonOrientation" Header="Button Orientation" />
                        </local:OptionPanel>
                    </local:OptionGroup>

                    <local:OptionGroup Title="Window">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TGHasTitleBar" Header="Has TitleBar" IsOn="True" />
                            <ToggleSwitch x:Name="TGDragMove" Header="Drag by Content" IsOn="False" />
                            <ToggleSwitch x:Name="TGIsResizable" Header="Can Resize?" IsOn="False" />
                            <local:ChoiceOption x:Name="CmbUnderlayBackdrops" Header="Backdrop" />
                            <local:ChoiceOption x:Name="CmbFlow" Header="FlowDirection" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <StackPanel Spacing="10">
                    <Button Click="Button_Click" Content="Show Dialog" />
                    <TextBlock x:Name="TxtResult" Style="{ThemeResource TitleTextBlockStyle}" />
                </StackPanel>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
