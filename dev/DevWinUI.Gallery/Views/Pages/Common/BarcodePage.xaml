<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BarcodePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="using:DevWinUIGallery">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="Barcode" Description="Generate barcode images from text in several formats." Doc="common/barcode" DocType="Core">
                <local:ControlExample2.CSharpCode>
                    <x:String>
                        var barcode = Barcode.CreateCode128(TxtInput.Text);
                    </x:String>
                </local:ControlExample2.CSharpCode>
                <local:ControlExample2.Options>
                    <local:OptionPanel>
                        <TextBox x:Name="TxtInput" Header="Input" PlaceholderText="Input" Text="DevWinUI" TextChanged="TxtInput_TextChanged" />
                        <local:ChoiceOption x:Name="CmbType" Header="Barcode Type" ValueChanged="CmbType_ValueChanged" />
                    </local:OptionPanel>
                </local:ControlExample2.Options>
                <Image x:Name="OutPutImg" />
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
