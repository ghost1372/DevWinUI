<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LoopingListPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="LoopingList" Doc="controls/loopingList">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="LoopingList">
                        <local:OptionPanel>
                            <TextBox x:Name="TxtHeader" Header="Header" PlaceholderText="Country" Text="Country" />
                            <TextBox x:Name="TxtPrimary" Header="Primary Placeholder" PlaceholderText="Country" Text="Country" />
                            <TextBox x:Name="TxtSecondary" Header="Secondary Placeholder" PlaceholderText="Capital" Text="Capital" />
                            <TextBox x:Name="TxtTertiary" Header="Tertiary Placeholder" PlaceholderText="City" Text="City" />
                            <ToggleSwitch x:Name="TgShouldLoop" Header="Should Loop?" IsOn="True" />
                            <Button MinWidth="170" Click="Button_Click" Content="Clear Selection" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="LoopingList">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:LoopingList x:Name="LoopingListSample"/&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <local:Sample.CSharpCode>
                            <x:String>
                                LoopingListSample.PrimaryItems = new List&lt;string&gt;(){ "Item 1", "Item 2"}
                            </x:String>
                        </local:Sample.CSharpCode>
                        <dev:LoopingList x:Name="LoopingListSample" VerticalAlignment="Top" Header="{x:Bind TxtHeader.Text, Mode=OneWay}" PrimaryPlaceholderText="{x:Bind TxtPrimary.Text, Mode=OneWay}" SecondaryPlaceholderText="{x:Bind TxtSecondary.Text, Mode=OneWay}" ShouldLoop="{x:Bind TgShouldLoop.IsOn, Mode=OneWay}" TertiaryPlaceholderText="{x:Bind TxtTertiary.Text, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
