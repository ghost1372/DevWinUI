<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ArcProgressPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="ArcProgress" Doc="controls/arcProgress">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="ArcProgress">
                        <local:OptionPanel>
                            <Slider x:Name="SliderSample" Header="Percentage" Maximum="100" Minimum="0" Value="36" />
                            <local:ChoiceOption x:Name="CmbFillAnim" Header="Fill Status">
                                <local:ChoiceOption.Value>
                                    <dev:ArcProgressFillAnimationState>Idle</dev:ArcProgressFillAnimationState>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbSweepDirection" Header="Sweep Direction">
                                <local:ChoiceOption.Value>
                                    <dev:SweepDirection>Counterclockwise</dev:SweepDirection>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="ArcProgress">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:ArcProgress Percentage="36" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:ArcProgress FillStatus="{x:Bind ((dev:ArcProgressFillAnimationState)CmbFillAnim.Value), Mode=OneWay}" Percentage="{x:Bind SliderSample.Value, Mode=OneWay}" SweepDirection="{x:Bind ((SweepDirection)CmbSweepDirection.Value), Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
