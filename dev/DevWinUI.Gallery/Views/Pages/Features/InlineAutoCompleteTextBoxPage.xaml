<Page x:Class="DevWinUIGallery.Views.InlineAutoCompleteTextBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery">
    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="InlineAutoCompleteTextBox" Doc="controls/inlineAutoCompleteTextBox">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Matching">
                        <local:OptionPanel>
                            <CheckBox x:Name="IsCaseSensitive" VerticalAlignment="Top" Content="Case Sensitive" IsChecked="False" />
                            <TextBox x:Name="SuggestionPrefix" Header="Suggestion Prefix" Text="" />
                            <TextBox x:Name="SuggestionSuffix" Header="Suggestion Suffix" Text=" ? [Press Right]" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Suggestions">
                        <local:OptionPanel>
                            <NumberBox x:Name="RandomDemoSuggestionsCount" Header="Random Demo Suggestions Count" Maximum="100000" Minimum="0" Text="10000" />
                            <TextBox x:Name="AdditionalSuggestions" Header="Additional Suggestions (Separate additional suggestions with a comma.)" PlaceholderText="Enter comma separated suggestions here..." Text="Luke Skywalker,Leia Organa,Han Solo,Chewbacca,Obi-Wan Kenobi,R2-D2,C-3PO,Darth Vader,😎😊😁" />
                            <Button x:Name="UpdateDemoSuggestionsButton" Click="UpdateDemoSuggestionsButton_Click" Content="Update Demo Suggestions" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="InlineAutoCompleteTextBox" CSharp="Features/InlineAutoComplete/InlineAutoCompleteTextBoxPage_cs.txt" Xaml="Features/InlineAutoComplete/InlineAutoCompleteTextBoxPage_xaml.txt">
                        <dev:InlineAutoCompleteTextBox VerticalAlignment="Top" IsSuggestionCaseSensitive="{x:Bind (x:Boolean)IsCaseSensitive.IsChecked, Mode=OneWay}" PlaceholderText="Enter your text here..." SuggestionPrefix="{x:Bind SuggestionPrefix.Text, Mode=OneWay}" SuggestionSuffix="{x:Bind SuggestionSuffix.Text, Mode=OneWay}" SuggestionsSource="{x:Bind DemoSuggestions, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
