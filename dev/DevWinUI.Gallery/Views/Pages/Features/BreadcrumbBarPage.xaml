<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BreadcrumbBarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="BreadcrumbBar" Doc="controls/breadcrumbBar">
                <local:ControlExample2.Samples>
                    <local:Sample Title="BreadcrumbBar">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:BreadcrumbBar ItemsSource="{x:Bind Items}" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:BreadcrumbBar EllipsisButtonToolTip="More folders" ItemsSource="{x:Bind Items, Mode=OneWay}" RootItemToolTip="Root Folder" />
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
