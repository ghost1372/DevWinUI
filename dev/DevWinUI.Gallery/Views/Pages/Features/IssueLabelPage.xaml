<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.IssueLabelPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Issue Label" Doc="controls/issueLabel">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Issue Label">
                        <local:OptionPanel>
                            <TextBox x:Name="TxtTitle" Header="Title" Text="Bug" />
                            <local:ChoiceOption x:Name="CmbSeverity" Header="Severity" Value="{x:Bind dev:IssueLabelSeverity.Error}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Issue Label">
                        <local:Sample.XamlCode>
                            <x:String>&lt;dev:IssueLabel Title="Bug" Severity="Error" /&gt;</x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="10">
                            <dev:IssueLabel Title="{x:Bind TxtTitle.Text, Mode=OneWay}" Severity="{x:Bind ((dev:IssueLabelSeverity)CmbSeverity.Value), Mode=OneWay}" />
                            <dev:IssueLabel Title="{x:Bind TxtTitle.Text, Mode=OneWay}" HorizontalAlignment="Left" Severity="{x:Bind ((dev:IssueLabelSeverity)CmbSeverity.Value), Mode=OneWay}" />
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="Severity Variants">
                        <local:Sample.XamlCode>
                            <x:String>&lt;dev:IssueLabel Title="Warning" Severity="Warning" /&gt;</x:String>
                        </local:Sample.XamlCode>
                        <dev:UniformGrid ColumnSpacing="10" Columns="4" RowSpacing="10">
                            <dev:IssueLabel Title="Success" Severity="Success" />
                            <dev:IssueLabel Title="Warning" Severity="Warning" />
                            <dev:IssueLabel Title="Error" Severity="Error" />
                            <dev:IssueLabel Title="Green" Severity="Green" />
                            <dev:IssueLabel Title="Blue" Severity="Blue" />
                            <dev:IssueLabel Title="Yellow" Severity="Yellow" />
                            <dev:IssueLabel Title="Orange" Severity="Orange" />
                            <dev:IssueLabel Title="Red" Severity="Red" />
                            <dev:IssueLabel Title="Pink" Severity="Pink" />
                            <dev:IssueLabel Title="Purple" Severity="Purple" />
                            <dev:IssueLabel Title="Gray" Severity="Gray" />
                        </dev:UniformGrid>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
