<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ScrollSplitCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="ScrollSplitCard" Doc="controls/scrollSplitCard">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="ScrollSplitCard">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbSize" Header="Size">
                                <local:ChoiceOption.Value>
                                    <dev:ScrollSplitCardSize>Medium</dev:ScrollSplitCardSize>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbTone" Header="Tone">
                                <local:ChoiceOption.Value>
                                    <dev:ScrollSplitCardTone>Card</dev:ScrollSplitCardTone>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <Slider x:Name="SliderCount" Header="Card Count" Maximum="5" Minimum="1" Value="3" />
                            <TextBox x:Name="TxtImageAlt" Header="Image Alt" />
                            <TextBox x:Name="TxtHint" Header="Hint" Text="Scroll" />
                            <TextBox x:Name="TxtEndLabel" Header="End Label" Text="Thanks for scrolling" />
                            <ToggleSwitch x:Name="TsAnimation" Header="Is Animation Enabled" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="ScrollSplitCard" Xaml="Features/Others/ScrollSplitCard_xaml.txt">
                        <dev:ScrollSplitCard Cards="{x:Bind GetCards(SliderCount.Value), Mode=OneWay}" EndLabel="{x:Bind TxtEndLabel.Text, Mode=OneWay}" Hint="{x:Bind TxtHint.Text, Mode=OneWay}" Image="ms-appx:///Assets/BannerView/7.jpeg" ImageAlt="{x:Bind TxtImageAlt.Text, Mode=OneWay}" IsAnimationEnabled="{x:Bind TsAnimation.IsOn, Mode=OneWay}" Size="{x:Bind ((dev:ScrollSplitCardSize)CmbSize.Value), Mode=OneWay}" Tone="{x:Bind ((dev:ScrollSplitCardTone)CmbTone.Value), Mode=OneWay}" />
                    </local:Sample>
                    <local:Sample Title="Chart tone">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:ScrollSplitCard Cards="{x:Bind Cards}" Size="Small" Tone="Chart" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:ScrollSplitCard Cards="{x:Bind Cards}" Image="ms-appx:///Assets/BannerView/8.jpeg" Size="Small" Tone="Chart" />
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
