<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SegmentCharPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="SegmentChar" Doc="controls/segmentChar">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="SixteenSegmentChar">
                        <local:OptionPanel>
                            <TextBox x:Name="Txt" Header="Single Character" Text="D" />
                            <Slider x:Name="SldAngle" Header="Angle" Maximum="360" Minimum="-360" Value="0" />
                            <ToggleSwitch x:Name="TGIsPatternMaker" Header="Is Pattern Maker" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="FourteenSegmentChar">
                        <local:OptionPanel>
                            <TextBox x:Name="Txt2" Header="Single Character" Text="D" />
                            <Slider x:Name="SldAngle2" Header="Angle" Maximum="360" Minimum="-360" Value="0" />
                            <ToggleSwitch x:Name="TGIsPatternMaker2" Header="Is Pattern Maker" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Matrix8x14SegmentChar">
                        <local:OptionPanel>
                            <TextBox x:Name="Txt3" Header="Single Character" Text="D" />
                            <Slider x:Name="SldAngle3" Header="Angle" Maximum="360" Minimum="-360" Value="0" />
                            <ToggleSwitch x:Name="TGMatrixSquare" Header="IsMatrixSquare" />
                            <ToggleSwitch x:Name="TGIsPatternMaker3" Header="Is Pattern Maker" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="SixteenSegmentChar">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:SixteenSegmentChar Character="D" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="10">
                            <dev:SixteenSegmentChar x:Name="SixSeg" Angle="{x:Bind SldAngle.Value, Mode=OneWay}" Character="{x:Bind Txt.Text, Mode=OneWay}" IsPatternMakerEnabled="{x:Bind TGIsPatternMaker.IsOn, Mode=OneWay}" PatternChanged="OnSixteenPatternChanged" SegmentPointerPressed="OnSixteenPointerPressed" />
                            <TextBox x:Name="TxtPattern" Header="Pattern" IsReadOnly="True" />
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="FourteenSegmentChar">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:FourteenSegmentChar Character="D" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="10">
                            <dev:FourteenSegmentChar x:Name="FourSeg" Angle="{x:Bind SldAngle2.Value, Mode=OneWay}" Character="{x:Bind Txt2.Text, Mode=OneWay}" IsPatternMakerEnabled="{x:Bind TGIsPatternMaker2.IsOn, Mode=OneWay}" PatternChanged="OnFourteenPatternChanged" SegmentPointerPressed="OnFourteenPointerPressed" />
                            <TextBox x:Name="TxtPattern2" Header="Pattern" IsReadOnly="True" />
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="Matrix8x14SegmentChar">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Matrix8x14SegmentChar Character="D" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="10">
                            <dev:Matrix8x14SegmentChar x:Name="MatrixSeg" Angle="{x:Bind SldAngle3.Value, Mode=OneWay}" Character="{x:Bind Txt3.Text, Mode=OneWay}" IsMatrixSquare="{x:Bind TGMatrixSquare.IsOn, Mode=OneWay}" IsPatternMakerEnabled="{x:Bind TGIsPatternMaker3.IsOn, Mode=OneWay}" PatternChanged="OnMatrixPatternChanged" SegmentPointerPressed="OnMatrixPointerPressed" />
                            <TextBox x:Name="TxtPattern3" Header="Pattern" IsReadOnly="True" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
