<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SnowFlakeEffectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="SnowFlakeEffect" Doc="controls/snowFlakeEffect">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="SnowFlakeEffect">
                        <local:OptionPanel>
                            <NumberBox x:Name="NbValue" Header="Value" Minimum="0" SpinButtonPlacementMode="Inline" Value="100" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.XamlCode>
                    <x:String>
                        &lt;dev:SnowFlakeEffect FlakeCount="100" /&gt;
                    </x:String>
                </local:ControlExample.XamlCode>
                <dev:SnowFlakeEffect FlakeCount="{x:Bind (x:Int32)NbValue.Value, Mode=OneWay}" />

            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
