<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.GoToCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="GoToCard" Doc="controls/goToCard">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Text">
                        <local:OptionPanel>
                            <TextBox x:Name="TxtTitle" Header="Title" PlaceholderText="Title" Text="Syncfusion Collaborates with Microsoft to Advance .NET MAUI" />
                            <TextBox x:Name="TxtActionTitle" Header="Action Title" PlaceholderText="Action Title" Text="Read more" />
                            <TextBox x:Name="TxtUri" Header="Launch Uri" PlaceholderText="Launch Uri" Text="ms-settings:colors" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Visibility">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TgShowIcon" Header="Show Icon" IsOn="True" />
                            <ToggleSwitch x:Name="TgShowActionIcon" Header="Show Action Icon" IsOn="True" />
                            <ToggleSwitch x:Name="TgShowActionButton" Header="Show Action Button" IsOn="True" />
                            <ToggleSwitch x:Name="TgShowClose" Header="Show Close Button" IsOn="True" />
                            <ToggleSwitch x:Name="TgIsOpen" Header="Is Open?" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="GoToCard">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:GoToCard Title="Test" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="10">
                            <dev:GoToCard Title="{x:Bind TxtTitle.Text, Mode=OneWay}" ActionTitle="{x:Bind TxtActionTitle.Text, Mode=OneWay}" Icon="{dev:BitmapIconSource Source=ms-appx:///Assets/Fluent/Microsoft.png}" IsOpen="{x:Bind TgIsOpen.IsOn, Mode=OneWay}" LaunchUri="{x:Bind TxtUri.Text, Mode=OneWay}" ShowActionButton="{x:Bind TgShowActionButton.IsOn, Mode=OneWay}" ShowActionIcon="{x:Bind TgShowActionIcon.IsOn, Mode=OneWay}" ShowCloseButton="{x:Bind TgShowClose.IsOn, Mode=OneWay}" ShowIcon="{x:Bind TgShowIcon.IsOn, Mode=OneWay}" />
                            <dev:GoToCard Title="{x:Bind TxtTitle.Text, Mode=OneWay}" ActionTitle="{x:Bind TxtActionTitle.Text, Mode=OneWay}" Background="{ThemeResource CardGradient3Brush}" Icon="{dev:BitmapIconSource Source=ms-appx:///Assets/Fluent/Microsoft.png}" IsOpen="{x:Bind TgIsOpen.IsOn, Mode=OneWay}" LaunchUri="{x:Bind TxtUri.Text, Mode=OneWay}" ShowActionButton="{x:Bind TgShowActionButton.IsOn, Mode=OneWay}" ShowActionIcon="{x:Bind TgShowActionIcon.IsOn, Mode=OneWay}" ShowCloseButton="{x:Bind TgShowClose.IsOn, Mode=OneWay}" ShowIcon="{x:Bind TgShowIcon.IsOn, Mode=OneWay}" />
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="Gradients and custom actions">
                        <StackPanel Spacing="10">
                            <dev:GoToCard Title="Join Our Live Webinar on WinUI 3 Best Practices" ActionIcon="{dev:FontIconSource GlyphName=CalligraphyPen}" ActionTitle="Register Now" Background="{ThemeResource CardGradient1Brush}" Icon="{dev:BitmapIconSource Source=ms-appx:///Assets/Fluent/external.png}" IsOpen="{x:Bind TgIsOpen.IsOn, Mode=OneWay}" LaunchUri="{x:Bind TxtUri.Text, Mode=OneWay}" ShowActionButton="{x:Bind TgShowActionButton.IsOn, Mode=OneWay}" ShowActionIcon="{x:Bind TgShowActionIcon.IsOn, Mode=OneWay}" ShowCloseButton="{x:Bind TgShowClose.IsOn, Mode=OneWay}" ShowIcon="{x:Bind TgShowIcon.IsOn, Mode=OneWay}" />
                            <dev:GoToCard Title="Update Your Profile Information" ActionIcon="{dev:FontIconSource GlyphName=Info}" ActionTitle="Open Settings" Background="{ThemeResource CardGradient2Brush}" Icon="{dev:BitmapIconSource Source=ms-appx:///Assets/Fluent/update.png}" IsOpen="{x:Bind TgIsOpen.IsOn, Mode=OneWay}" LaunchUri="{x:Bind TxtUri.Text, Mode=OneWay}" ShowActionButton="{x:Bind TgShowActionButton.IsOn, Mode=OneWay}" ShowActionIcon="{x:Bind TgShowActionIcon.IsOn, Mode=OneWay}" ShowCloseButton="{x:Bind TgShowClose.IsOn, Mode=OneWay}" ShowIcon="{x:Bind TgShowIcon.IsOn, Mode=OneWay}" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
