<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LoadingStatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="LoadingState" Doc="controls/loadingState" ResetRequested="ControlExample_ResetRequested">
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <TextBox x:Name="TxtLabel" Header="Label" Text="Working" />
                        <local:ChoiceOption x:Name="CmbMode" Header="Mode" Value="{x:Bind dev:LoadingStateMode.Drive}" />
                        <ToggleSwitch x:Name="TgShowElapsed" Header="Show Elapsed" IsOn="True" />
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <local:ControlExample.XamlCode>
                    <x:String>
                        &lt;dev:LoadingState Label="Working" Mode="Drive" ShowElapsed="True" /&gt;
                    </x:String>
                </local:ControlExample.XamlCode>
                <dev:LoadingState x:Name="MyLoadingState" HorizontalAlignment="Left" Label="{x:Bind TxtLabel.Text, Mode=OneWay}" Mode="{x:Bind ((dev:LoadingStateMode)CmbMode.Value), Mode=OneWay}" ShowElapsed="{x:Bind TgShowElapsed.IsOn, Mode=OneWay}" />
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
