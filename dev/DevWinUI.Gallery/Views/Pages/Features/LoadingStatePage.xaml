<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LoadingStatePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="10" dev:PanelAttach.ChildrenTransitions="Default" Spacing="10">
            <local:ControlExample DocPage="controls/loadingState" HeaderText="LoadingState">
                <local:ControlExample.Xaml>
                    <x:String>
                        &lt;dev:LoadingState Label="Working" Mode="Drive" ShowElapsed="True" /&gt;
                    </x:String>
                </local:ControlExample.Xaml>
                <local:ControlExample.Pane>
                    <StackPanel Spacing="10">
                        <TextBox x:Name="TxtLabel" Header="Label" Text="Working" />
                        <ComboBox x:Name="CmbMode" Header="Mode" ItemsSource="{x:Bind Modes}" SelectedIndex="0" />
                        <ToggleSwitch x:Name="TgShowElapsed" Header="Show Elapsed" IsOn="True" />
                        <Button Click="Restart_Click" Content="Restart timer" />
                    </StackPanel>
                </local:ControlExample.Pane>
                <dev:LoadingState x:Name="MyLoadingState" HorizontalAlignment="Left" Label="{x:Bind TxtLabel.Text, Mode=OneWay}" Mode="{x:Bind ((dev:LoadingStateMode)CmbMode.SelectedItem), Mode=OneWay}" ShowElapsed="{x:Bind TgShowElapsed.IsOn, Mode=OneWay}" />
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
