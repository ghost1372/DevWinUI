<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BruteForcePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="BruteForce" Doc="controls/bruteForce">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="BruteForce">
                        <local:OptionPanel>
                            <TextBox x:Name="TxtPassword" Header="Password" PlaceholderText="Password" Text="DevWinUI" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="BruteForce">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:BruteForce x:Name="BruteForceSample" Password="DevWinUI" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <local:Sample.CSharpCode>
                            <x:String>
                                BruteForceSample.UpdateCharacterState(index, BruteForceState.Success);
                            </x:String>
                        </local:Sample.CSharpCode>
                        <StackPanel Spacing="10">
                            <dev:BruteForce x:Name="BruteForceSample" Password="{x:Bind TxtPassword.Text, Mode=OneWay}" />
                            <dev:BruteForce x:Name="BruteForceSample2" Password="{x:Bind TxtPassword.Text, Mode=OneWay}" RenderDelay="00:00:00.001" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
