<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.AnimatedTocPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="AnimatedToc" Doc="controls/animatedToc">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="AnimatedToc">
                        <local:OptionPanel>
                            <Slider x:Name="SliderRowHeight" Header="Row Height" Maximum="72" Minimum="32" Value="48" />
                            <Slider x:Name="SliderIndent" Header="Indent" Maximum="48" Minimum="8" Value="24" />
                            <TextBox x:Name="TxtTitle" Header="Title" Text="On this page" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="AnimatedToc" Xaml="Features/AnimatedToc/AnimatedToc_xaml.txt">
                        <dev:AnimatedToc Title="{x:Bind TxtTitle.Text, Mode=OneWay}" Width="280" HorizontalAlignment="Left" Indent="{x:Bind SliderIndent.Value, Mode=OneWay}" RowHeight="{x:Bind SliderRowHeight.Value, Mode=OneWay}">
                            <dev:AnimatedTocItem Depth="0" Href="#introduction" Label="Introduction" />
                            <dev:AnimatedTocItem Depth="0" Href="#getting-started" Label="Getting started" />
                            <dev:AnimatedTocItem Depth="1" Href="#installation" Label="Installation" />
                            <dev:AnimatedTocItem Depth="1" Href="#configuration" Label="Configuration" />
                            <dev:AnimatedTocItem Depth="0" Href="#usage" Label="Usage" />
                            <dev:AnimatedTocItem Depth="1" Href="#basic-usage" Label="Basic usage" />
                            <dev:AnimatedTocItem Depth="2" Href="#theming" Label="Theming" />
                            <dev:AnimatedTocItem Depth="0" Href="#api-reference" Label="API reference" />
                        </dev:AnimatedToc>
                    </local:Sample>
                    <local:Sample Title="Custom brushes" Xaml="Features/AnimatedToc/AnimatedTocBrushes_xaml.txt">
                        <dev:AnimatedToc Title="Release notes" Width="280" HorizontalAlignment="Left" ProgressBrush="{ThemeResource SystemFillColorSuccessBrush}" RailBrush="{ThemeResource ControlStrokeColorDefaultBrush}" SelectedIndex="1">
                            <dev:AnimatedTocItem Label="Overview" />
                            <dev:AnimatedTocItem Label="New features" />
                            <dev:AnimatedTocItem Label="Breaking changes" />
                            <dev:AnimatedTocItem Depth="1" Label="Migration" />
                        </dev:AnimatedToc>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
