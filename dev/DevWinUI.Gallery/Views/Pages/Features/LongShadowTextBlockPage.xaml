<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LongShadowTextBlockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="LongShadowTextBlock" Doc="controls/longShadowTextBlock">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="LongShadowTextBlock">
                        <local:OptionPanel>
                            <TextBox x:Name="txt" Header="Text" PlaceholderText="Text" Text="00:10:45" />
                            <Slider x:Name="slOpacity" Header="Opacity" Maximum="1.0" Minimum="0" TickFrequency="0.1" Value="0.3" />
                            <Slider x:Name="slDepth" Header="Depth" Maximum="500" Minimum="0" TickFrequency="1" Value="100" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="LongShadowTextBlock" Xaml="Features/Others/LongShadowTextBlock_xaml.txt">
                        <dev:LongShadowTextBlock Depth="{x:Bind (x:Int32)slDepth.Value, Mode=OneWay}" TextOpacity="{x:Bind slOpacity.Value, Mode=OneWay}" Color="GreenYellow">
                            <dev:LongShadowTextBlock.TextBlock>
                                <TextBlock FontSize="100" Text="{x:Bind txt.Text, Mode=OneWay}" />
                            </dev:LongShadowTextBlock.TextBlock>
                        </dev:LongShadowTextBlock>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
