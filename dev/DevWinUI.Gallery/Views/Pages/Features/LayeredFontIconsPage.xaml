<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LayeredFontIconsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <InfoBar Title="Can't see the icons?" IsClosable="False" IsOpen="True" Message="If the layered icons don't show up, your project probably has IconNoGridOptimization enabled in EnabledXamlOptionalChanges. That option removes the internal Grid from FontIcon, so LayeredFontIcons has nowhere to place its icons and fails to show them. Remove IconNoGridOptimization from the list and the icons will work again." Severity="Warning" />
            <local:ControlExample Title="LayeredFontIcons" Doc="controls/layeredFontIcons">
                <local:ControlExample.Samples>
                    <local:Sample Title="LayeredFontIcons" Xaml="Features/Others/LayeredFontIconsPage_xaml.txt">
                        <dev:LayeredFontIcons>
                            <dev:LayeredFontIcons.FontIcons>
                                <FontIcon Margin="0,0,15,0" Glyph="&#xE973;" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Margin="15,0,0,0" Glyph="&#xE974;" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                                <FontIcon Glyph="&#xE949;" RenderTransformOrigin="0.5,0.5">
                                    <FontIcon.RenderTransform>
                                        <RotateTransform Angle="-70" />
                                    </FontIcon.RenderTransform>
                                </FontIcon>
                            </dev:LayeredFontIcons.FontIcons>
                        </dev:LayeredFontIcons>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
