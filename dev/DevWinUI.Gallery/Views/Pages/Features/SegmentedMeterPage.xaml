<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SegmentedMeterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="SegmentedMeter" Doc="controls/segmentedMeter">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="SegmentedMeter">
                        <local:OptionPanel>
                            <Slider x:Name="SliderApps" Header="Apps" Maximum="60" Minimum="0" Value="30" />
                            <Slider x:Name="SliderMedia" Header="Media" Maximum="60" Minimum="0" Value="20" />
                            <Slider x:Name="SliderSystem" Header="System" Maximum="60" Minimum="0" Value="10" />
                            <Slider x:Name="SliderGap" Header="Gap" Maximum="12" Minimum="0" Value="2" />
                            <local:ChoiceOption x:Name="CmbBarSize" Header="Bar Size" SelectedIndex="1" Value="{x:Bind dev:MeterBarSize.Large}" />
                            <local:ChoiceOption x:Name="CmbOrientation" Header="Orientation" Value="{x:Bind controls:Orientation.Horizontal}" />
                            <local:ChoiceOption x:Name="CmbLegendPosition" Header="Legend Position" SelectedIndex="1" Value="{x:Bind dev:MeterLegendPosition.Start}" />
                            <local:ChoiceOption x:Name="CmbLegendOrientation" Header="Legend Orientation" Value="{x:Bind controls:Orientation.Vertical}" />
                            <ToggleSwitch x:Name="TglShowLegend" Header="Show Legend" IsOn="True" />
                            <ToggleSwitch x:Name="TglShowValue" Header="Show Value" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="SegmentedMeter" Xaml="Features/SegmentedMeter/SegmentedMeter_xaml.txt">
                        <dev:SegmentedMeter BarSize="{x:Bind ((dev:MeterBarSize)CmbBarSize.Value), Mode=OneWay}" Gap="{x:Bind SliderGap.Value, Mode=OneWay}" LegendOrientation="{x:Bind ((Orientation)CmbLegendOrientation.Value), Mode=OneWay}" LegendPosition="{x:Bind ((dev:MeterLegendPosition)CmbLegendPosition.Value), Mode=OneWay}" Orientation="{x:Bind ((Orientation)CmbOrientation.Value), Mode=OneWay}" ShowLegend="{x:Bind TglShowLegend.IsOn, Mode=OneWay}" ShowValue="{x:Bind TglShowValue.IsOn, Mode=OneWay}">
                            <dev:MeterSegment Label="Apps" Value="{x:Bind SliderApps.Value, Mode=OneWay}" />
                            <dev:MeterSegment Label="Media" Value="{x:Bind SliderMedia.Value, Mode=OneWay}" />
                            <dev:MeterSegment Label="System" Value="{x:Bind SliderSystem.Value, Mode=OneWay}" />
                        </dev:SegmentedMeter>
                    </local:Sample>
                    <local:Sample Title="Kinds" Xaml="Features/SegmentedMeter/SegmentedMeterKinds_xaml.txt">
                        <dev:SegmentedMeter Animated="True" BarSize="Large" ShowValue="False">
                            <dev:MeterSegment Kind="Success" Label="Done" Value="30" />
                            <dev:MeterSegment Kind="Accent" Label="In progress" Value="15" />
                            <dev:MeterSegment Kind="Danger" Label="Closed" Value="5" />
                        </dev:SegmentedMeter>
                    </local:Sample>
                    <local:Sample Title="Icons" Xaml="Features/SegmentedMeter/SegmentedMeterIcons_xaml.txt">
                        <dev:SegmentedMeter LegendPosition="Start">
                            <dev:MeterSegment Fill="#34D399" Icon="&#xE71D;" Label="Apps" Value="25" />
                            <dev:MeterSegment Fill="#FBBF24" Icon="&#xE715;" Label="Messages" Value="15" />
                            <dev:MeterSegment Fill="#60A5FA" Icon="&#xE8B2;" Label="Media" Value="20" />
                        </dev:SegmentedMeter>
                    </local:Sample>
                    <local:Sample Title="Vertical" Xaml="Features/SegmentedMeter/SegmentedMeterVertical_xaml.txt">
                        <dev:SegmentedMeter Height="240" HorizontalAlignment="Left" LegendOrientation="Vertical" Orientation="Vertical">
                            <dev:MeterSegment Label="Apps" Value="30" />
                            <dev:MeterSegment Label="Media" Value="20" />
                        </dev:SegmentedMeter>
                    </local:Sample>
                    <local:Sample Title="Start and end content" Xaml="Features/SegmentedMeter/SegmentedMeterContent_xaml.txt">
                        <dev:SegmentedMeter Maximum="200" Minimum="0">
                            <dev:SegmentedMeter.StartContent>
                                <TextBlock FontWeight="SemiBold" Text="Storage" />
                            </dev:SegmentedMeter.StartContent>
                            <dev:SegmentedMeter.EndContent>
                                <TextBlock Text="Total: 200 GB" />
                            </dev:SegmentedMeter.EndContent>
                            <dev:MeterSegment Label="Photos" Value="60" />
                            <dev:MeterSegment Label="Docs" Value="40" />
                        </dev:SegmentedMeter>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
