<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ColorfulShimmingEffectPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="ColorfulShimmingEffect" Doc="controls/colorfulShimmingEffect">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="ColorfulShimmingEffect">
                        <local:OptionPanel>
                            <TextBox x:Name="txt" Header="Text" PlaceholderText="Text" Text="DevWinUI" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="ColorfulShimmingEffect" Xaml="Features/Others/ColorfulShimmingEffectPage_cs.txt">
                        <dev:ColorfulShimmingEffect>
                            <dev:ColorfulShimmingEffect.ColorfulShimmingEffectItems>
                                <dev:ColorfulShimmingEffectItem DelayTimeSpan="0" DurationTimeSpan="0:0:10" Z="50.0" Color="Yellow" />
                                <dev:ColorfulShimmingEffectItem DelayTimeSpan="0:0:0.25" DurationTimeSpan="0:0:10" Z="50.0" Color="Green" />
                            </dev:ColorfulShimmingEffect.ColorfulShimmingEffectItems>
                            <TextBlock HorizontalAlignment="Center" FontSize="80" FontWeight="Bold" Foreground="White" Text="{x:Bind txt.Text, Mode=OneWay}" />
                        </dev:ColorfulShimmingEffect>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
