<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.AccordionPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:model="using:DevWinUIGallery.Models"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Accordion" Doc="controls/accordion">
                <local:ControlExample.Samples>
                    <local:Sample Title="Accordion">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Accordion ItemsSource="{x:Bind ViewModel.LandscapeData}" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:Accordion Height="500" ItemsSource="{x:Bind ViewModel.LandscapeData, Mode=OneWay}">
                            <dev:Accordion.ItemTemplate>
                                <DataTemplate x:DataType="model:SampleItemModel">
                                    <Image HorizontalAlignment="Center" VerticalAlignment="Center" Source="{x:Bind ImagePath}" Stretch="UniformToFill" />
                                </DataTemplate>
                            </dev:Accordion.ItemTemplate>
                            <dev:Accordion.HeaderTemplate>
                                <DataTemplate x:DataType="model:SampleItemModel">
                                    <Grid>
                                        <Grid.Background>
                                            <SolidColorBrush Opacity="0.25" Color="{ThemeResource CardBackgroundFillColorDefault}" />
                                        </Grid.Background>
                                        <TextBlock Margin="0,0,0,4" HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind Title}" />
                                    </Grid>
                                </DataTemplate>
                            </dev:Accordion.HeaderTemplate>
                        </dev:Accordion>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
