<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.TextBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="TextBox" Doc="controls/textBox">
                <local:ControlExample.Samples>
                    <local:Sample Title="TextBox" Xaml="Features/TextBox/TextBoxPage_Part1_xaml.txt">
                        <dev:TextBox Header="TextBox with Content" PlaceholderText="PlaceHolder...">
                            <dev:TextBox.Content>
                                <Button Content="&#xE895;" />
                            </dev:TextBox.Content>
                        </dev:TextBox>
                    </local:Sample>
                    <local:Sample Title="Multiple content" Xaml="Features/TextBox/TextBoxPage_Part2_xaml.txt">
                        <dev:TextBox Header="TextBox with Content" PlaceholderText="PlaceHolder...">
                            <dev:TextBox.Content>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="&#xE896;" />
                                    <Button>
                                        <FontIcon Glyph="&#xE895;" />
                                    </Button>
                                </StackPanel>
                            </dev:TextBox.Content>
                        </dev:TextBox>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
