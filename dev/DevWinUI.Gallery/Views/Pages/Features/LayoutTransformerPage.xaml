<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.LayoutTransformerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="LayoutTransformer" Doc="controls/layoutTransformer">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="LayoutTransformer">
                        <local:OptionPanel>
                            <Slider x:Name="SliderSample" Header="Rotation" Maximum="360" Minimum="-360" Value="0" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="LayoutTransformer" Xaml="Features/Others/LayoutTransformer_xaml.txt">
                        <dev:LayoutTransformer x:Name="LayoutTransformerSample" Height="300" RenderTransformOrigin="0.5,0.5">
                            <Rectangle Width="200" Height="100" Fill="{ThemeResource SystemFillColorCriticalBrush}" />
                            <dev:LayoutTransformer.RenderTransform>
                                <CompositeTransform Rotation="{x:Bind SliderSample.Value, Mode=OneWay}" />
                            </dev:LayoutTransformer.RenderTransform>
                        </dev:LayoutTransformer>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
