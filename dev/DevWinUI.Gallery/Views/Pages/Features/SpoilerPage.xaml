<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SpoilerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="Spoiler" Doc="controls/spoiler">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Spoiler">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbHeaderVerticalAlignment" Header="Header Vertical Alignment">
                                <local:ChoiceOption.Value>
                                    <VerticalAlignment>Center</VerticalAlignment>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbHeaderHorizontalAlignment" Header="Header Horizontal Alignment">
                                <local:ChoiceOption.Value>
                                    <HorizontalAlignment>Left</HorizontalAlignment>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <local:ChoiceOption x:Name="CmbRevealMode" Header="Reveal Mode">
                                <local:ChoiceOption.Value>
                                    <dev:SpoilerRevealMode>Once</dev:SpoilerRevealMode>
                                </local:ChoiceOption.Value>
                            </local:ChoiceOption>
                            <TextBox x:Name="TxtHeader" Header="Header" PlaceholderText="Header" Text="Click to Show Content" />
                            <ToggleSwitch x:Name="TgIsActiveShimmer" Header="Is Active Shimmer" IsOn="True" />
                            <ToggleSwitch x:Name="TgIsRevealed" Header="Is Revealed" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="Spoiler">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Spoiler Content="MyContent" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:Spoiler Header="{x:Bind TxtHeader.Text, Mode=OneWay}" HeaderHorizontalAlignment="{x:Bind ((HorizontalAlignment)CmbHeaderHorizontalAlignment.Value), Mode=OneWay}" HeaderVerticalAlignment="{x:Bind ((VerticalAlignment)CmbHeaderVerticalAlignment.Value), Mode=OneWay}" IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" IsRevealed="{x:Bind TgIsRevealed.IsOn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}">
                            <dev:Spoiler.HeaderIcon>
                                <FontIconSource Glyph="&#xE7B3;" />
                            </dev:Spoiler.HeaderIcon>
                            <StackPanel Spacing="10">
                                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                                <Button Content="DevWinUI Is GREAT!" />
                            </StackPanel>
                        </dev:Spoiler>
                    </local:Sample>
                    <local:Sample Title="Inline" Xaml="Features/Spoiler/SpoilerInline_xaml.txt">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock VerticalAlignment="Center" Style="{ThemeResource BaseTextBlockStyle}" Text="Here is some text before the spoiler." TextWrapping="Wrap" />
                            <dev:Spoiler Height="20" VerticalAlignment="Center" IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}" ShimmerHeight="20" ShimmerWidth="100">
                                <TextBlock Style="{ThemeResource BaseTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                            </dev:Spoiler>
                            <TextBlock VerticalAlignment="Center" Style="{ThemeResource BaseTextBlockStyle}" Text="And here is some text after it." TextWrapping="Wrap" />
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="Shimmer sizes" Xaml="Features/Spoiler/SpoilerShimmer_xaml.txt">
                        <StackPanel Spacing="10">
                            <dev:Spoiler IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}" ShimmerHeight="35" ShimmerWidth="300">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                                    <Button Content="DevWinUI Is GREAT!" />
                                </StackPanel>
                            </dev:Spoiler>
                            <dev:Spoiler IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}" ShimmerHeight="35" ShimmerWidth="280">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                                    <Button Content="DevWinUI Is GREAT!" />
                                </StackPanel>
                            </dev:Spoiler>
                            <dev:Spoiler IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}" ShimmerHeight="35" ShimmerWidth="200">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                                    <Button Content="DevWinUI Is GREAT!" />
                                </StackPanel>
                            </dev:Spoiler>
                            <dev:Spoiler IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}" ShimmerHeight="35" ShimmerWidth="150">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                                    <Button Content="DevWinUI Is GREAT!" />
                                </StackPanel>
                            </dev:Spoiler>
                            <dev:Spoiler IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}" ShimmerHeight="35" ShimmerWidth="260">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                                    <Button Content="DevWinUI Is GREAT!" />
                                </StackPanel>
                            </dev:Spoiler>
                            <dev:Spoiler IsActiveShimmer="{x:Bind TgIsActiveShimmer.IsOn, Mode=OneWay}" RevealMode="{x:Bind ((dev:SpoilerRevealMode)CmbRevealMode.Value), Mode=OneWay}" ShimmerCornerRadius="180" ShimmerHeight="50" ShimmerWidth="50">
                                <StackPanel Spacing="10">
                                    <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="DevWinUI Is GREAT!" />
                                    <Button Content="DevWinUI Is GREAT!" />
                                </StackPanel>
                            </dev:Spoiler>
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
