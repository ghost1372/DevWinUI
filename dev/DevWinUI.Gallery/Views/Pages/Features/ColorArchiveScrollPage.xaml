<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ColorArchiveScrollPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="ColorArchiveScroll" Doc="controls/colorArchiveScroll">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Preview">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbPreviewSize" Header="Preview Size" Value="{x:Bind dev:ColorArchivePreviewSize.Large}" />
                            <ToggleSwitch x:Name="TsShowPreview" Header="Show Preview" IsOn="True" />
                            <ToggleSwitch x:Name="TsShowRuler" Header="Show Ruler" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Behavior">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TsInfiniteScroll" Header="Infinite Scroll" IsOn="True" />
                            <ToggleSwitch x:Name="TsEnableSound" Header="Enable Sound" IsOn="True" />
                            <ToggleSwitch x:Name="TsReduceMotion" Header="Reduce Motion" IsOn="False" />
                            <Slider x:Name="SliderScrollThreshold" Header="Scroll Threshold" Maximum="200" Minimum="20" Value="90" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Layout">
                        <local:OptionPanel>
                            <Slider x:Name="SliderActiveAnchor" Header="Active Anchor" Maximum="0.9" Minimum="0.2" StepFrequency="0.01" Value="0.68" />
                            <Slider x:Name="SliderRowLeading" Header="Row Leading" Maximum="3" Minimum="1.2" StepFrequency="0.1" Value="1.9" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Status">
                        <local:OptionPanel>
                            <TextBlock x:Name="TxtActive" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Scroll, drag or tap the ruler to change the active project" TextWrapping="Wrap" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="ColorArchiveScroll">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:ColorArchiveScroll Projects="{x:Bind Projects}" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:ColorArchiveScroll x:Name="Archive" Height="560" ActiveAnchor="{x:Bind SliderActiveAnchor.Value, Mode=OneWay}" ActiveChanged="OnActiveChanged" EnableSound="{x:Bind TsEnableSound.IsOn, Mode=OneWay}" InfiniteScroll="{x:Bind TsInfiniteScroll.IsOn, Mode=OneWay}" PreviewSize="{x:Bind ((dev:ColorArchivePreviewSize)CmbPreviewSize.Value), Mode=OneWay}" Projects="{x:Bind Projects}" ReduceMotion="{x:Bind TsReduceMotion.IsOn, Mode=OneWay}" RowLeading="{x:Bind SliderRowLeading.Value, Mode=OneWay}" ScrollThreshold="{x:Bind SliderScrollThreshold.Value, Mode=OneWay}" ShowPreview="{x:Bind TsShowPreview.IsOn, Mode=OneWay}" ShowRuler="{x:Bind TsShowRuler.IsOn, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
