<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ClockPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Analog Clock" Doc="controls/clock">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Clock">
                        <local:OptionPanel>
                            <TextBox x:Name="TxtTimeFormat1" Header="TimeFormat" Text="HH:mm:ss" />
                            <NumberBox x:Name="MinuteIncrementNB1" Header="Minute Increment" Maximum="15" Value="1" />
                            <TextBlock x:Name="Txt" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Analog Clock">
                        <local:Sample.XamlCode>
                            <x:String>&lt;dev:Clock /&gt;</x:String>
                        </local:Sample.XamlCode>
                        <dev:Clock HorizontalAlignment="Left" MinuteIncrement="{x:Bind (x:Int32)MinuteIncrementNB1.Value, Mode=OneWay}" SelectedTimeChanged="Clock_SelectedTimeChanged" TimeFormat="{x:Bind TxtTimeFormat1.Text, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
