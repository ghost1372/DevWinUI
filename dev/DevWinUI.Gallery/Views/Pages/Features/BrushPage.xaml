<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.BrushPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="Brushes" Doc="brushes/themeBrushes">
                <local:ControlExample2.Samples>
                    <local:Sample Title="Theme Brushes" Xaml="Features/Others/BrushPage_xaml.txt">
                        <StackPanel Margin="10" Spacing="10">
                            <Border Height="80" Background="{ThemeResource CardGradient3Brush}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="CardGradient3Brush" />
                            </Border>
                            <Border Height="80" Background="{ThemeResource CardGradient2Brush}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="CardGradient2Brush" />
                            </Border>
                            <Border Height="80" Background="{ThemeResource CardGradient1Brush}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="CardGradient1Brush" />
                            </Border>
                            <Border Height="80" Background="{ThemeResource GlassAcrylicBackground}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="GlassAcrylicBackground" />
                            </Border>
                            <Border Height="80" Background="{ThemeResource GlassAcrylicBorderBrush}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="GlassAcrylicBorderBrush" />
                            </Border>
                            <Border Height="80" Background="{ThemeResource OverlayRadialGradient}">
                                <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" Text="OverlayRadialGradient" />
                            </Border>
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
