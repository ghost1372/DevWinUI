<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.StatusCenterPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="10" dev:PanelAttach.ChildrenTransitions="Default" Spacing="10">
            <local:ControlExample CSharpSource="Features/StatusCenterPage_cs.txt" DocPage="controls/statusCenter" HeaderText="Status center">
                <local:ControlExample.Xaml>
                    <x:String>&lt;dev:StatusCenterButton /&gt;</x:String>
                </local:ControlExample.Xaml>
                <local:ControlExample.Pane>
                    <StackPanel Spacing="8">
                        <ComboBox x:Name="CmbFlyoutPlacement" HorizontalAlignment="Stretch" Header="Flyout placement" SelectionChanged="CmbFlyoutPlacement_SelectionChanged">
                            <ComboBoxItem Content="BottomEdgeAlignedRight" Tag="BottomEdgeAlignedRight" />
                            <ComboBoxItem Content="BottomEdgeAlignedLeft" Tag="BottomEdgeAlignedLeft" />
                            <ComboBoxItem Content="TopEdgeAlignedRight" Tag="TopEdgeAlignedRight" />
                            <ComboBoxItem Content="TopEdgeAlignedLeft" Tag="TopEdgeAlignedLeft" />
                            <ComboBoxItem Content="LeftEdgeAlignedTop" Tag="LeftEdgeAlignedTop" />
                            <ComboBoxItem Content="LeftEdgeAlignedBottom" Tag="LeftEdgeAlignedBottom" />
                            <ComboBoxItem Content="RightEdgeAlignedTop" Tag="RightEdgeAlignedTop" />
                            <ComboBoxItem Content="RightEdgeAlignedBottom" Tag="RightEdgeAlignedBottom" />
                            <ComboBoxItem Content="Top" Tag="Top" />
                            <ComboBoxItem Content="Bottom" Tag="Bottom" />
                            <ComboBoxItem Content="Left" Tag="Left" />
                            <ComboBoxItem Content="Right" Tag="Right" />
                            <ComboBoxItem Content="Full" Tag="Full" />
                        </ComboBox>
                        <ComboBox x:Name="CmbSizeUnit" HorizontalAlignment="Stretch" Header="Size unit" SelectionChanged="CmbSizeUnit_SelectionChanged">
                            <ComboBoxItem Content="Binary (KiB, MiB, GiB)" Tag="BinaryUnits" />
                            <ComboBoxItem Content="Decimal (KB, MB, GB)" Tag="DecimalUnits" />
                        </ComboBox>
                        <Grid ColumnSpacing="8" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Button HorizontalAlignment="Stretch" Click="Copy_Click" Content="Copy" />
                            <Button Grid.Column="1" HorizontalAlignment="Stretch" Click="Move_Click" Content="Move" />
                            <Button Grid.Row="1" HorizontalAlignment="Stretch" Click="Delete_Click" Content="Delete" />
                            <Button Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Click="Recycle_Click" Content="Recycle" />
                            <Button Grid.Row="2" HorizontalAlignment="Stretch" Click="Compress_Click" Content="Compress" />
                            <Button Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Click="Extract_Click" Content="Extract" />
                            <Button Grid.Row="3" HorizontalAlignment="Stretch" Click="InstallFont_Click" Content="Install font" />
                            <Button Grid.Row="3" Grid.Column="1" HorizontalAlignment="Stretch" Click="EmptyRecycleBin_Click" Content="Recycle bin" />
                            <Button Grid.Row="4" HorizontalAlignment="Stretch" Click="GitClone_Click" Content="Git clone" />
                            <Button Grid.Row="4" Grid.Column="1" HorizontalAlignment="Stretch" Click="GitFetch_Click" Content="Git fetch" />
                            <Button Grid.Row="5" HorizontalAlignment="Stretch" Click="GitPull_Click" Content="Git pull" />
                            <Button Grid.Row="5" Grid.Column="1" HorizontalAlignment="Stretch" Click="GitPush_Click" Content="Git push" />
                            <Button Grid.Row="6" HorizontalAlignment="Stretch" Click="GitSync_Click" Content="Git sync" />
                            <Button Grid.Row="6" Grid.Column="1" HorizontalAlignment="Stretch" Click="GitCheckout_Click" Content="Git checkout" />
                        </Grid>
                    </StackPanel>
                </local:ControlExample.Pane>
                <Grid>
                    <dev:StatusCenterButton x:Name="StatusCenterButtonSample" HorizontalAlignment="Right" VerticalAlignment="Top" />
                </Grid>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
