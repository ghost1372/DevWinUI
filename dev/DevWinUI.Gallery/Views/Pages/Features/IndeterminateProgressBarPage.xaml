<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.IndeterminateProgressBarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="IndeterminateProgressBar" Doc="controls/indeterminateProgressBar">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="IndeterminateProgressBar">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="tgActive3" Header="IsActive" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="IndeterminateProgressBar">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:IndeterminateProgressBar /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="10">
                            <dev:IndeterminateProgressBar IsActive="{x:Bind tgActive3.IsOn, Mode=OneWay}" />
                            <dev:IndeterminateProgressBar DotHeight="8" DotWidth="8" IsActive="{x:Bind tgActive3.IsOn, Mode=OneWay}" />
                            <dev:IndeterminateProgressBar DotRadiusX="0" DotRadiusY="0" IsActive="{x:Bind tgActive3.IsOn, Mode=OneWay}" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
