<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.PagerControlPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="PagerControl" Doc="controls/pagerControl">
                <local:ControlExample.Samples>
                    <local:Sample Title="PagerControl/Auto (NumberBox)">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:PagerControl NumberOfPages="10"/&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:PagerControl NumberOfPages="10" />
                    </local:Sample>
                    <local:Sample Title="PagerControl/ButtonPanel">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:PagerControl DisplayMode="ButtonPanel" NumberOfPages="10"/&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:PagerControl DisplayMode="ButtonPanel" NumberOfPages="10" />
                    </local:Sample>
                    <local:Sample Title="PagerControl/ComboBox">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:PagerControl DisplayMode="ComboBox" NumberOfPages="10"/&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:PagerControl DisplayMode="ComboBox" NumberOfPages="10" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
