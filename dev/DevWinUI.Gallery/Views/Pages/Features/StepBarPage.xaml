<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.StepBarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:controls="using:Microsoft.UI.Xaml.Controls"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="StepBar" Doc="controls/stepBar">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="StepBar">
                        <local:OptionPanel>
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Button x:Name="BtnNext" MinWidth="120" Click="BtnNext_Click" Content="Next" />
                                <Button x:Name="BtnPrev" MinWidth="120" Click="BtnPrev_Click" Content="Prev" />
                            </StackPanel>
                            <local:ChoiceOption x:Name="CmbStatus" Header="Status" Value="{x:Bind dev:StepStatus.Info}" />
                            <local:ChoiceOption x:Name="CmbOrientation" Header="Orientation" Value="{x:Bind controls:Orientation.Horizontal}" />
                            <local:ChoiceOption x:Name="CmbHeaderDisplayMode" Header="Header Display Mode" Value="{x:Bind dev:StepBarHeaderDisplayMode.Bottom}" />
                            <local:ChoiceOption x:Name="CmbDisplayMode" Header="Display Mode" Value="{x:Bind dev:StepBarDisplayMode.Index}" />
                            <ToggleSwitch x:Name="TGShowStepIndex" Header="Show StepIndex" IsOn="True" />
                            <ToggleSwitch x:Name="TGAutoSelectOnItemClick" Header="Auto Select On Item Click" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="StepBar" Xaml="Features/Others/StepBar_xaml.txt">
                        <dev:StepBar x:Name="StepBarSample" AutoSelectOnItemClick="{x:Bind TGAutoSelectOnItemClick.IsOn, Mode=OneWay}" DisplayMode="{x:Bind ((dev:StepBarDisplayMode)CmbDisplayMode.Value), Mode=OneWay}" HeaderDisplayMode="{x:Bind ((dev:StepBarHeaderDisplayMode)CmbHeaderDisplayMode.Value), Mode=OneWay}" Orientation="{x:Bind ((Orientation)CmbOrientation.Value), Mode=OneWay}" ShowStepIndex="{x:Bind TGShowStepIndex.IsOn, Mode=OneWay}" Status="{x:Bind ((dev:StepStatus)CmbStatus.Value), Mode=OneWay}">
                            <dev:StepBarItem Content="Register" />
                            <dev:StepBarItem Content="BasicInfo" />
                            <dev:StepBarItem Content="UploadFile" />
                            <dev:StepBarItem Content="Complete" />
                        </dev:StepBar>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
