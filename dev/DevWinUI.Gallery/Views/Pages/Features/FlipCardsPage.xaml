<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.FlipCardsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="FlipCards" Doc="controls/flipCards">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="FlipCards">
                        <local:OptionPanel>
                            <NumberBox x:Name="NbValue" Header="Value" Minimum="0" SpinButtonPlacementMode="Inline" Value="1" />
                            <ComboBox x:Name="CmbSources" Header="Sources" ItemsSource="{x:Bind FlipCardsSourceItems, Mode=OneWay}" SelectedIndex="1" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="FlipCards">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:FlipCards /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:FlipCards Source="{x:Bind (dev:FlipCardsSourceType)CmbSources.SelectedItem, Mode=OneWay}" Value="{x:Bind NbValue.Value, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
