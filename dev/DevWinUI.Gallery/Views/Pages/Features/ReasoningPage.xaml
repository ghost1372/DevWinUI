<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ReasoningPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Reasoning" Doc="controls/reasoning">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Reasoning">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbKind" Header="Kind" Value="{x:Bind dev:ReasoningKind.Outline}" />
                            <ToggleSwitch Header="Thinking" IsOn="{x:Bind ReasoningMain.Thinking, Mode=TwoWay}" />
                            <TextBox x:Name="TxtThinkingLabel" Header="Thinking Label" Text="Thinking" />
                            <TextBox x:Name="TxtDurationLabel" Header="Completed Duration Label" Text="Thought for {0}" />
                            <ToggleSwitch Header="Animations" IsOn="True" Toggled="OnAnimationToggled" />
                            <Button HorizontalAlignment="Stretch" Click="OnSimulateClick" Content="Run Simulation" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Reasoning" Xaml="Features/Reasoning/Reasoning_xaml.txt">
                        <dev:Reasoning x:Name="ReasoningMain" MaxWidth="640" CompletedDurationLabel="{x:Bind TxtDurationLabel.Text, Mode=OneWay}" Kind="{x:Bind ((dev:ReasoningKind)CmbKind.Value), Mode=OneWay}" ThinkingLabel="{x:Bind TxtThinkingLabel.Text, Mode=OneWay}" Duration="12">
                            <dev:ReasoningSteps>
                                <dev:ReasoningStep x:Name="Step1" Label="Understand the request" Status="Done">
                                    <dev:ReasoningStepDetails Text="Identify the controls that were shared and decide which sample pages they need." />
                                </dev:ReasoningStep>
                                <dev:ReasoningStep x:Name="Step2" Label="Search for references" Status="Done">
                                    <dev:ReasoningStepSources Sources="{x:Bind Sources}" />
                                </dev:ReasoningStep>
                                <dev:ReasoningStep x:Name="Step3" Label="Review the control API" Status="Done">
                                    <dev:ReasoningRows Kind="Steps" Rows="{x:Bind StepRows}" />
                                </dev:ReasoningStep>
                                <dev:ReasoningStep x:Name="Step4" Label="Write the answer" Status="Done">
                                    <dev:ReasoningStepImage Alt="Application icon" Source="{x:Bind SampleImage}" />
                                </dev:ReasoningStep>
                            </dev:ReasoningSteps>
                        </dev:Reasoning>
                    </local:Sample>
                    <local:Sample Title="Search rows" Xaml="Features/Reasoning/ReasoningSearchRows_xaml.txt">
                        <dev:Reasoning MaxWidth="640" HorizontalAlignment="Left" DefaultOpen="True" Kind="Card" Duration="8">
                            <dev:ReasoningRows Kind="Search" Query="WinUI 3 animation performance" Rows="{x:Bind SearchRows}" />
                        </dev:Reasoning>
                    </local:Sample>
                    <local:Sample Title="Coding rows" Xaml="Features/Reasoning/ReasoningCodingRows_xaml.txt">
                        <StackPanel MaxWidth="640" HorizontalAlignment="Left" Spacing="8">
                            <dev:Reasoning DefaultOpen="True" Duration="21">
                                <dev:ReasoningRows x:Name="CodingRowsHost" Kind="Coding" Rows="{x:Bind CodingRows}" SelectedIndex="0" />
                            </dev:Reasoning>
                            <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                <Run Text="Selected index:" />
                                <Run Text="{x:Bind CodingRowsHost.SelectedIndex, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="Plain text" Xaml="Features/Reasoning/ReasoningPlainText_xaml.txt">
                        <dev:Reasoning MaxWidth="640" HorizontalAlignment="Left" DefaultOpen="True" Kind="Inline" Duration="75">
                            <TextBlock Text="Any content can be used as the body. The label switches to the formatted duration once thinking has finished." TextWrapping="Wrap" />
                        </dev:Reasoning>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
