<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.FillButtonPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="FillButton" Doc="controls/fillButton">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Appearance">
                        <local:OptionPanel>
                            <TextBox x:Name="TxtContent" Header="Content" Text="Get started" />
                            <local:ChoiceOption x:Name="CmbTone" Header="Tone" Value="{x:Bind dev:FillButtonTone.Soft}" />
                            <local:ChoiceOption x:Name="CmbSize" Header="Size" Value="{x:Bind dev:FillButtonSize.Default}" />
                            <ToggleSwitch x:Name="TglIcon" Header="Custom Icon" IsOn="False" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Behavior">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TglLink" Header="Navigate Uri" IsOn="False" />
                            <ToggleSwitch x:Name="TglEnabled" Header="Is Enabled" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="FillButton">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:FillButton Content="Get started" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <dev:FillButton Click="Sample_Click" Content="{x:Bind TxtContent.Text, Mode=OneWay}" Icon="{x:Bind GetIcon(TglIcon.IsOn), Mode=OneWay}" IsEnabled="{x:Bind TglEnabled.IsOn, Mode=OneWay}" NavigateUri="{x:Bind GetUri(TglLink.IsOn), Mode=OneWay}" Size="{x:Bind ((dev:FillButtonSize)CmbSize.Value), Mode=OneWay}" Tone="{x:Bind ((dev:FillButtonTone)CmbTone.Value), Mode=OneWay}" />
                            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Hover or focus the button" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
