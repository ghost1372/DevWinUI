<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ModalWindowPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="ModalWindow" Doc="controls/modalWindow">
                <local:ControlExample.Samples>
                    <local:Sample Title="ModalWindow">
                        <local:Sample.CSharpCode>
                            <x:String>
                                var window = new ModalWindow(WindowNative.GetWindowHandle(MainWindow.Instance));#nl#window.Activate();
                            </x:String>
                        </local:Sample.CSharpCode>
                        <Button Click="OnCreateModalWindowClick" Content="Create a New ModalWindow" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
