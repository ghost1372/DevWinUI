<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ToolbarPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Toolbar" Doc="controls/toolbar">
                <local:ControlExample.Samples>
                    <local:Sample Title="Toolbar" CSharp="Features/Others/ToolbarPage_cs.txt">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Toolbar Items="{x:Bind Items}" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:Toolbar x:Name="ToolbarSample" VerticalAlignment="Center" Items="{x:Bind Items, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
