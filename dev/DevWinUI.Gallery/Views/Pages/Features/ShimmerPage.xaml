<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ShimmerPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="Shimmer" Doc="controls/shimmer">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Shimmer">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TGIsActive" Header="IsActive" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="Shimmer">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:Shimmer /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="5">
                            <Border Width="300" Height="30">
                                <dev:Shimmer IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" />
                            </Border>
                            <Border Width="280" Height="30">
                                <dev:Shimmer IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" />
                            </Border>
                            <Border Width="200" Height="30">
                                <dev:Shimmer IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" />
                            </Border>
                            <Border Width="150" Height="30">
                                <dev:Shimmer IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" />
                            </Border>
                            <Border Width="260" Height="30">
                                <dev:Shimmer IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" />
                            </Border>
                            <Border Width="50" Height="50" CornerRadius="180">
                                <dev:Shimmer IsActive="{x:Bind TGIsActive.IsOn, Mode=OneWay}" />
                            </Border>
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
