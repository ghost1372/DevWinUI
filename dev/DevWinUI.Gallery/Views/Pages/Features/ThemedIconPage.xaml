<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ThemedIconPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:models="using:DevWinUIGallery.Models"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="ThemedIcon" Doc="controls/themedIcon">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="ThemedIcon">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="IsToggled" Header="Is Toggled" />
                            <local:ChoiceOption x:Name="CmbColorType" Header="Color Type" Value="{x:Bind dev:ThemedIconColorType.Normal}" />
                            <local:ChoiceOption x:Name="CmbIconType" Header="Icon Type" Value="{x:Bind dev:ThemedIconTypes.Layered}" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="ThemedIcon">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:ThemedIcon Style="{StaticResource App.ThemedIcons.Copy}" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Orientation="Horizontal" Spacing="10">
                            <dev:ThemedIcon IconColorType="{x:Bind (dev:ThemedIconColorType)CmbColorType.Value, Mode=OneWay}" IconType="{x:Bind (dev:ThemedIconTypes)CmbIconType.Value, Mode=OneWay}" IsToggled="{x:Bind IsToggled.IsOn, Mode=OneWay}" Style="{StaticResource App.ThemedIcons.Copy}" />
                            <dev:ThemedIcon IconColorType="{x:Bind (dev:ThemedIconColorType)CmbColorType.Value, Mode=OneWay}" IconType="{x:Bind (dev:ThemedIconTypes)CmbIconType.Value, Mode=OneWay}" IsToggled="{x:Bind IsToggled.IsOn, Mode=OneWay}" Style="{StaticResource App.ThemedIcons.Paste}" />
                            <dev:ThemedIcon IconColorType="{x:Bind (dev:ThemedIconColorType)CmbColorType.Value, Mode=OneWay}" IconType="{x:Bind (dev:ThemedIconTypes)CmbIconType.Value, Mode=OneWay}" IsToggled="{x:Bind IsToggled.IsOn, Mode=OneWay}" Style="{StaticResource App.ThemedIcons.Delete}" />
                            <dev:ThemedIcon IconColorType="{x:Bind (dev:ThemedIconColorType)CmbColorType.Value, Mode=OneWay}" IconType="{x:Bind (dev:ThemedIconTypes)CmbIconType.Value, Mode=OneWay}" IsToggled="{x:Bind IsToggled.IsOn, Mode=OneWay}" Style="{StaticResource App.ThemedIcons.Rename}" />
                            <dev:ThemedIcon IconColorType="{x:Bind (dev:ThemedIconColorType)CmbColorType.Value, Mode=OneWay}" IconType="{x:Bind (dev:ThemedIconTypes)CmbIconType.Value, Mode=OneWay}" IsToggled="{x:Bind IsToggled.IsOn, Mode=OneWay}" Style="{StaticResource App.ThemedIcons.Refresh}" />
                            <dev:ThemedIcon IconColorType="{x:Bind (dev:ThemedIconColorType)CmbColorType.Value, Mode=OneWay}" IconType="{x:Bind (dev:ThemedIconTypes)CmbIconType.Value, Mode=OneWay}" IsToggled="{x:Bind IsToggled.IsOn, Mode=OneWay}" Style="{StaticResource App.ThemedIcons.CopyTo}" />
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="All icons">
                        <ItemsControl ItemsSource="{x:Bind ThemedIconStyles, Mode=OneWay}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:ThemedIconItem">
                                    <dev:ThemedIcon Style="{x:Bind Style}" ToolTipService.ToolTip="{x:Bind Key}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <dev:WrapPanel HorizontalSpacing="5" VerticalSpacing="10" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
