<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ColorPalettePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="ColorPalette" Doc="controls/colorPalette">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Appearance">
                        <local:OptionPanel>
                            <local:ChoiceOption x:Name="CmbColorSet" Header="Color Set" Value="{x:Bind dev:ColorSetType.Basic}" />
                            <local:ChoiceOption x:Name="CmbItemShape" Header="Item Shape" Value="{x:Bind dev:ColorItemShape.Rectangle}" />
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <NumberBox x:Name="NBWidth" Header="Item Width" Maximum="200" Minimum="4" SpinButtonPlacementMode="Inline" Value="32" />
                                <NumberBox x:Name="NBHeight" Header="Item Height" Maximum="200" Minimum="4" SpinButtonPlacementMode="Inline" Value="32" />
                            </StackPanel>
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Behavior">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="TGIsCopyEnabled" Header="Copy color code on item click" IsOn="True" />
                            <ToggleSwitch x:Name="TGShowHexCode" Header="Show Hex Code" IsOn="False" />
                            <ToggleSwitch x:Name="TGShowColorName" Header="Show Color Name" IsOn="True" />
                            <ToggleSwitch x:Name="TGShowToolTip" Header="Show ToolTip" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="ColorPalette">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:ColorPalette /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel Spacing="10">
                            <dev:ColorPalette ColorChanged="ColorPalette_ColorChanged" ColorSet="{x:Bind ((dev:ColorSetType)CmbColorSet.SelectedItem), Mode=OneWay}" IsCopyColorCodeOnClickEnabled="{x:Bind TGIsCopyEnabled.IsOn, Mode=OneWay}" ItemHeight="{x:Bind NBHeight.Value, Mode=OneWay}" ItemShape="{x:Bind ((dev:ColorItemShape)CmbItemShape.SelectedItem), Mode=OneWay}" ItemWidth="{x:Bind NBWidth.Value, Mode=OneWay}" ShowColorName="{x:Bind TGShowColorName.IsOn, Mode=OneWay}" ShowHexCode="{x:Bind TGShowHexCode.IsOn, Mode=OneWay}" ShowToolTip="{x:Bind TGShowToolTip.IsOn, Mode=OneWay}">
                                <dev:ColorPalette.Colors>
                                    <dev:ColorPaletteItem Color="Red" />
                                    <dev:ColorPaletteItem Color="Green" />
                                    <dev:ColorPaletteItem Color="Orange" />
                                    <dev:ColorPaletteItem Color="Blue" />
                                </dev:ColorPalette.Colors>
                                <dev:ColorPalette.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <dev:UniformGrid Columns="10" />
                                    </ItemsPanelTemplate>
                                </dev:ColorPalette.ItemsPanel>
                            </dev:ColorPalette>
                            <TextBlock x:Name="TxtResult" HorizontalAlignment="Center" Style="{ThemeResource SubtitleTextBlockStyle}" />
                        </StackPanel>
                    </local:Sample>
                    <local:Sample Title="Direct Xaml Items" Xaml="Features/Others/ColorPalettePage_xaml.txt">
                        <dev:ColorPalette ColorSet="Custom">
                            <dev:ColorPalette.Colors>
                                <dev:ColorPaletteItem Color="Red" />
                                <dev:ColorPaletteItem Color="Green" />
                                <dev:ColorPaletteItem Color="Orange" />
                                <dev:ColorPaletteItem Color="Blue" />
                            </dev:ColorPalette.Colors>
                        </dev:ColorPalette>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
