<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.FlipSidePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="FlipSide" Doc="controls/flipSide">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="FlipSide">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="tg" Header="IsFlipped" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="FlipSide" Xaml="Features/Others/FlipSide_xaml.txt">
                        <dev:FlipSide IsFlipped="{x:Bind tg.IsOn, Mode=OneWay}">
                            <dev:FlipSide.Side1>
                                <Grid Background="Red">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Side 1" />
                                </Grid>
                            </dev:FlipSide.Side1>
                            <dev:FlipSide.Side2>
                                <Grid Background="Blue">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" Text="Side 2" />
                                </Grid>
                            </dev:FlipSide.Side2>
                        </dev:FlipSide>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
