<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ProgressRingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="ProgressRing" Doc="controls/progressRing">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="ProgressRing">
                        <local:OptionPanel>
                            <ToggleSwitch x:Name="tgActive" Header="IsActive" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="ProgressRing">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:ProgressRing IsActive="True" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:ProgressRing IsActive="{x:Bind tgActive.IsOn, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
