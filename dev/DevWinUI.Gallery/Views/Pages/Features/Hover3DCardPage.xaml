<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.Hover3DCardPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="Hover3DCard" Doc="controls/hover3DCard">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Hover3DCard">
                        <local:OptionPanel>
                            <Slider x:Name="SliderTilt" Header="Max Tilt" Maximum="30" Minimum="0" Value="8" />
                            <Slider x:Name="SliderScale" Header="Hover Scale" Maximum="1.3" Minimum="1" StepFrequency="0.01" Value="1.05" />
                            <Slider x:Name="SliderPerspective" Header="Perspective" Maximum="3000" Minimum="400" StepFrequency="100" Value="1200" />
                            <Slider x:Name="SliderSmoothing" Header="Smoothing (ms)" Maximum="300" Minimum="1" Value="60" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="Hover3DCard" Xaml="Features/Others/Hover3DCard_xaml.txt">
                        <dev:Hover3DCard Width="320" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center" HoverScale="{x:Bind SliderScale.Value, Mode=OneWay}" MaxTilt="{x:Bind SliderTilt.Value, Mode=OneWay}" Perspective="{x:Bind SliderPerspective.Value, Mode=OneWay}" SmoothingMs="{x:Bind SliderSmoothing.Value, Mode=OneWay}">
                            <Border Padding="20" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
                                <StackPanel VerticalAlignment="Center" Spacing="6">
                                    <FontIcon FontSize="32" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}" Glyph="&#xE734;" />
                                    <TextBlock Style="{StaticResource SubtitleTextBlockStyle}" Text="Hover 3D Card" />
                                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Move the pointer across the card to tilt it." TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </dev:Hover3DCard>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
