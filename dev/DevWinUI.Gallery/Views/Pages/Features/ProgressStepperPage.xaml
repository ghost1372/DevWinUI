<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.ProgressStepperPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="ProgressStepper" Doc="controls/progressStepper">
                <local:ControlExample.Options>
                    <local:OptionPanel>
                        <local:ChoiceOption x:Name="CmbAlign" Header="Align" Value="{x:Bind dev:ProgressStepperStepperAlign.Left}" />
                        <ToggleSwitch x:Name="TglShowStepLabel" Header="Show Step Label" IsOn="True" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button Click="OnBack" Content="Back" />
                            <Button Click="OnNext" Content="Next" Style="{StaticResource AccentButtonStyle}" />
                            <Button Click="OnReset" Content="Reset" />
                        </StackPanel>
                    </local:OptionPanel>
                </local:ControlExample.Options>
                <local:ControlExample.Samples>
                    <local:Sample Title="ProgressStepper">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:ProgressStepper Align="Left" Current="1" CurrentChild="1" ShowStepLabel="True" Steps="{x:Bind Steps}" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:ProgressStepper x:Name="Stepper" MinWidth="320" HorizontalAlignment="Left" Align="{x:Bind ((dev:ProgressStepperStepperAlign)CmbAlign.Value), Mode=OneWay}" Current="1" CurrentChild="1" ShowStepLabel="{x:Bind TglShowStepLabel.IsOn, Mode=OneWay}" Steps="{x:Bind Steps}" />
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
