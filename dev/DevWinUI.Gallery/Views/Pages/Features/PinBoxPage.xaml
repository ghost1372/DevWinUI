<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.PinBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="PinBox" Doc="controls/pinBox">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Text">
                        <local:OptionPanel>
                            <TextBox x:Name="txtHeader" Header="Header" PlaceholderText="Header" />
                            <TextBox x:Name="txtDesc" Header="Description" PlaceholderText="Description" />
                            <TextBox x:Name="txtPassChar" Header="Password Char" PlaceholderText="Password Char" Text="●" />
                            <TextBox x:Name="txtPlaceholder" Header="Placeholder Text" PlaceholderText="Placeholder Text" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Layout">
                        <local:OptionPanel>
                            <NumberBox Header="Password Length" Minimum="1" SpinButtonPlacementMode="Inline" ValueChanged="NumberBox_ValueChanged" Value="4" />
                            <Slider Header="Item Spacing" Maximum="100" Minimum="0" StepFrequency="1" ValueChanged="Slider_ValueChanged" Value="12" />
                            <ComboBox x:Name="cmbOrientation" Header="Orientation" SelectedIndex="1">
                                <ComboBoxItem Content="Vertical" />
                                <ComboBoxItem Content="Horizontal" />
                            </ComboBox>
                            <ComboBox x:Name="cmbHorizontalAlignment" Header="Horizontal Alignment" SelectedIndex="1">
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Center" />
                                <ComboBoxItem Content="Right" />
                                <ComboBoxItem Content="Stretch" />
                            </ComboBox>
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Behavior">
                        <local:OptionPanel>
                            <ComboBox x:Name="cmbFocusMode" Header="Focus Mode" SelectedIndex="1">
                                <ComboBoxItem Content="Normal" />
                                <ComboBoxItem Content="Complete" />
                            </ComboBox>
                            <ComboBox x:Name="cmbPassReveal" Header="Password Reveal Mode" SelectedIndex="0">
                                <ComboBoxItem Content="Hidden" />
                                <ComboBoxItem Content="Peek" />
                                <ComboBoxItem Content="Visible" />
                            </ComboBox>
                            <ToggleSwitch x:Name="tgShowSuccess" Header="Show Success" />
                            <ToggleSwitch x:Name="tgShowError" Header="Show Error" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="PinBox">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:PinBox /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <dev:PinBox x:Name="pinBox" HorizontalAlignment="{x:Bind GetHorizontalAlignment(cmbHorizontalAlignment.SelectedIndex), Mode=OneWay}" Description="{x:Bind txtDesc.Text, Mode=OneWay}" FocusMode="{x:Bind GetFocusMode(cmbFocusMode.SelectedIndex), Mode=OneWay}" Header="{x:Bind txtHeader.Text, Mode=OneWay}" Orientation="{x:Bind GetOrientation(cmbOrientation.SelectedIndex), Mode=OneWay}" PasswordChar="{x:Bind txtPassChar.Text, Mode=OneWay}" PasswordRevealMode="{x:Bind GetPasswordRevealMode(cmbPassReveal.SelectedIndex), Mode=OneWay}" PlaceholderText="{x:Bind txtPlaceholder.Text, Mode=OneWay}" ShowError="{x:Bind tgShowError.IsOn, Mode=OneWay}" ShowSuccess="{x:Bind tgShowSuccess.IsOn, Mode=OneWay}" />
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
