<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.HoldToConfirmPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample2 Title="HoldToConfirm" Doc="controls/holdToConfirm">
                <local:ControlExample2.OptionGroups>
                    <local:OptionGroup Title="Content">
                        <local:OptionPanel>
                            <TextBox x:Name="TxtLabel" Header="Label" Text="Hold to confirm" />
                            <TextBox x:Name="TxtConfirmedLabel" Header="Confirmed Label" Text="Confirmed" />
                            <ToggleSwitch x:Name="TglIcon" Header="Show Icon" IsOn="True" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Appearance">
                        <local:OptionPanel>
                            <ComboBox x:Name="CmbKind" Header="Kind" ItemsSource="{x:Bind KindItems, Mode=OneWay}" SelectedIndex="0" />
                            <ComboBox x:Name="CmbSize" Header="Size" ItemsSource="{x:Bind SizeItems, Mode=OneWay}" SelectedIndex="1" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Behavior">
                        <local:OptionPanel>
                            <Slider x:Name="SliderDuration" Header="Duration (ms)" Maximum="5000" Minimum="200" StepFrequency="100" Value="1200" />
                            <ToggleSwitch x:Name="TglAnimation" Header="Is Animation Enabled" IsOn="True" />
                            <Button Click="ResetButton_Click" Content="Reset" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample2.OptionGroups>
                <local:ControlExample2.Samples>
                    <local:Sample Title="HoldToConfirm">
                        <local:Sample.XamlCode>
                            <x:String>
                                &lt;dev:HoldToConfirm Label="Hold to confirm" ConfirmedLabel="Confirmed" Duration="1200" IconGlyph="&amp;#xE72E;" /&gt;
                            </x:String>
                        </local:Sample.XamlCode>
                        <StackPanel HorizontalAlignment="Center" Spacing="12">
                            <dev:HoldToConfirm x:Name="Sample" Confirm="Sample_Confirm" ConfirmedLabel="{x:Bind TxtConfirmedLabel.Text, Mode=OneWay}" IconGlyph="{x:Bind GetGlyph(TglIcon.IsOn), Mode=OneWay}" IsAnimationEnabled="{x:Bind TglAnimation.IsOn, Mode=OneWay}" Kind="{x:Bind ((dev:HoldToConfirmKind)CmbKind.SelectedItem), Mode=OneWay}" Label="{x:Bind TxtLabel.Text, Mode=OneWay}" Size="{x:Bind ((dev:HoldToConfirmSize)CmbSize.SelectedItem), Mode=OneWay}" Duration="{x:Bind SliderDuration.Value, Mode=OneWay}" />
                            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="Press and hold the button" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample2.Samples>
            </local:ControlExample2>
        </StackPanel>
    </ScrollViewer>
</Page>
