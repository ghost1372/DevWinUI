<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.SearchBoxPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Padding="24" Spacing="16">
            <local:ControlExample Title="SearchBox" Doc="controls/searchBox">
                <local:ControlExample.OptionGroups>
                    <local:OptionGroup Title="Actions">
                        <local:OptionPanel>
                            <TextBox Header="PlaceholderText" Text="{x:Bind Search.PlaceholderText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="NoResultsText" Text="{x:Bind Search.NoResultsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBox Header="NoResultsDescription" Text="{x:Bind Search.NoResultsDescription, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <ToggleSwitch Header="ShowPreviousSearch" IsOn="{x:Bind Search.ShowPreviousSearch, Mode=TwoWay}" OffContent="Off" OnContent="On" />
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Click="Show_Click" Content="Show" />
                                <Button Click="Hide_Click" Content="Hide" />
                                <Button Click="ResetItems_Click" Content="Reset items" />
                            </StackPanel>
                        </local:OptionPanel>
                    </local:OptionGroup>
                    <local:OptionGroup Title="Flyout">
                        <local:OptionPanel>
                            <NumberBox Header="FlyoutWidth" Maximum="1200" Minimum="320" SpinButtonPlacementMode="Inline" ValueChanged="FlyoutWidth_ValueChanged" Value="640" />
                            <NumberBox Header="ResultsMaxHeight" Maximum="800" Minimum="120" SpinButtonPlacementMode="Inline" ValueChanged="ResultsMaxHeight_ValueChanged" Value="560" />
                            <ComboBox HorizontalAlignment="Stretch" Header="FlyoutPlacement" SelectedIndex="1" SelectionChanged="Placement_SelectionChanged">
                                <ComboBoxItem Content="Auto" />
                                <ComboBoxItem Content="Bottom" />
                                <ComboBoxItem Content="Top" />
                                <ComboBoxItem Content="Left" />
                                <ComboBoxItem Content="Right" />
                            </ComboBox>
                            <ToggleSwitch Header="ConstrainToAppBounds" IsOn="{x:Bind Search.ConstrainToAppBounds, Mode=TwoWay}" OffContent="Off" OnContent="On" />
                        </local:OptionPanel>
                    </local:OptionGroup>
                </local:ControlExample.OptionGroups>
                <local:ControlExample.Samples>
                    <local:Sample Title="SearchBox" Xaml="Features/SearchBox/SearchBoxPage_xaml.txt">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Spacing="5">
                            <dev:SearchBox x:Name="Search" Width="260" MenuItemInvoked="Search_MenuItemInvoked" QueryChanged="Search_QueryChanged" ResultInvoked="Search_ResultInvoked" />
                            <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Style="{StaticResource SubtitleTextBlockStyle}" Text="Click the search box" />
                        </StackPanel>
                    </local:Sample>
                </local:ControlExample.Samples>
            </local:ControlExample>
        </StackPanel>
    </ScrollViewer>
</Page>
