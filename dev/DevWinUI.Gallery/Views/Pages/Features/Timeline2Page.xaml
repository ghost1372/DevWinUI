<?xml version="1.0" encoding="utf-8" ?>
<Page x:Class="DevWinUIGallery.Views.Timeline2Page"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:dev="using:DevWinUI"
      xmlns:local="using:DevWinUIGallery"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:views="using:DevWinUIGallery.Views"
      mc:Ignorable="d">

    <ScrollViewer>
        <StackPanel Margin="10" dev:PanelAttach.ChildrenTransitions="Default" Spacing="10">

            <local:ControlExample DocPage="controls/timeline2" HeaderText="Timeline2">
                <local:ControlExample.Xaml>
                    <x:String>
                        &lt;dev:Timeline2 Width="384" ActiveIndex="2" ItemsSource="{x:Bind Entries}" /&gt;
                    </x:String>
                </local:ControlExample.Xaml>
                <local:ControlExample.Pane>
                    <StackPanel Spacing="10">
                        <Slider x:Name="SliderActive" Header="Active Index" Maximum="3" Minimum="-1" StepFrequency="1" TickFrequency="1" TickPlacement="Outside" Value="2" />
                        <ComboBox x:Name="CmbSize" Header="Size" ItemsSource="{x:Bind SizeItems, Mode=OneWay}" SelectedIndex="4">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dev:Timeline2Size">
                                    <TextBlock Text="{x:Bind}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="CmbColor" Header="Color" ItemsSource="{x:Bind ColorItems, Mode=OneWay}" SelectedIndex="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dev:Timeline2Color">
                                    <TextBlock Text="{x:Bind}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="CmbKind" Header="Kind" ItemsSource="{x:Bind KindItems, Mode=OneWay}" SelectedIndex="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dev:Timeline2Kind">
                                    <TextBlock Text="{x:Bind}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="CmbMarkerShape" Header="Marker Shape" ItemsSource="{x:Bind MarkerShapeItems, Mode=OneWay}" SelectedIndex="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dev:Timeline2MarkerShape">
                                    <TextBlock Text="{x:Bind}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="CmbAlign" Header="Align" ItemsSource="{x:Bind AlignItems, Mode=OneWay}" SelectedIndex="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dev:Timeline2Align">
                                    <TextBlock Text="{x:Bind}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox x:Name="CmbDatePlacement" Header="Date Placement" ItemsSource="{x:Bind DatePlacementItems, Mode=OneWay}" SelectedIndex="0">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="dev:Timeline2DatePlacement">
                                    <TextBlock Text="{x:Bind}" />
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ToggleSwitch x:Name="TglReverse" Header="Reverse" />
                    </StackPanel>
                </local:ControlExample.Pane>
                <dev:Timeline2 Width="384" HorizontalAlignment="Left" ActiveIndex="{x:Bind (x:Int32)SliderActive.Value, Mode=OneWay}" Align="{x:Bind ((dev:Timeline2Align)CmbAlign.SelectedItem), Mode=OneWay}" DatePlacement="{x:Bind ((dev:Timeline2DatePlacement)CmbDatePlacement.SelectedItem), Mode=OneWay}" ItemsSource="{x:Bind Entries}" Kind="{x:Bind ((dev:Timeline2Kind)CmbKind.SelectedItem), Mode=OneWay}" MarkerShape="{x:Bind ((dev:Timeline2MarkerShape)CmbMarkerShape.SelectedItem), Mode=OneWay}" Reverse="{x:Bind TglReverse.IsOn, Mode=OneWay}" Size="{x:Bind ((dev:Timeline2Size)CmbSize.SelectedItem), Mode=OneWay}" Color="{x:Bind ((dev:Timeline2Color)CmbColor.SelectedItem), Mode=OneWay}" />
            </local:ControlExample>

            <local:ControlExample HeaderText="Horizontal">
                <local:ControlExample.Xaml>
                    <x:String>
                        &lt;dev:Timeline2 ActiveIndex="2" ItemsSource="{x:Bind Entries}" Orientation="Horizontal" /&gt;
                    </x:String>
                </local:ControlExample.Xaml>
                <StackPanel Spacing="32">
                    <dev:Timeline2 ActiveIndex="2" ItemsSource="{x:Bind Entries}" Orientation="Horizontal" />
                    <dev:Timeline2 ActiveIndex="2" Align="Alternate" DatePlacement="Opposite" ItemsSource="{x:Bind Entries}" Orientation="Horizontal" />
                </StackPanel>
            </local:ControlExample>

            <local:ControlExample HeaderText="Custom Templates">
                <local:ControlExample.Xaml>
                    <x:String>
                        &lt;dev:Timeline2 Align="End" ItemsSource="{x:Bind Orders}"&gt; #nl#
                        &lt;dev:Timeline2.MarkerTemplate&gt; #nl#
                        &lt;DataTemplate x:DataType="views:Timeline2OrderEvent"&gt; #nl#
                        &lt;Grid Width="32" Height="32" #nl#
                        Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="16"&gt; #nl#
                        &lt;FontIcon FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="{x:Bind Icon}" /&gt; #nl#
                        &lt;/Grid&gt; #nl#
                        &lt;/DataTemplate&gt; #nl#
                        &lt;/dev:Timeline2.MarkerTemplate&gt; #nl#
                        &lt;dev:Timeline2.OppositeTemplate&gt; #nl#
                        &lt;DataTemplate x:DataType="views:Timeline2OrderEvent"&gt; #nl#
                        &lt;TextBlock Text="{x:Bind Date}" /&gt; #nl#
                        &lt;/DataTemplate&gt; #nl#
                        &lt;/dev:Timeline2.OppositeTemplate&gt; #nl#
                        &lt;dev:Timeline2.ItemTemplate&gt; #nl#
                        &lt;DataTemplate x:DataType="views:Timeline2OrderEvent"&gt; #nl#
                        &lt;TextBlock FontWeight="Medium" Text="{x:Bind Status}" /&gt; #nl#
                        &lt;/DataTemplate&gt; #nl#
                        &lt;/dev:Timeline2.ItemTemplate&gt; #nl#
                        &lt;/dev:Timeline2&gt; #nl#
                    </x:String>
                </local:ControlExample.Xaml>
                <dev:Timeline2 Align="End" ItemsSource="{x:Bind Orders}">
                    <dev:Timeline2.MarkerTemplate>
                        <DataTemplate x:DataType="views:Timeline2OrderEvent">
                            <Grid Width="32" Height="32" Background="{ThemeResource AccentFillColorDefaultBrush}" CornerRadius="16">
                                <FontIcon FontSize="14" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Glyph="{x:Bind Icon}" />
                            </Grid>
                        </DataTemplate>
                    </dev:Timeline2.MarkerTemplate>
                    <dev:Timeline2.OppositeTemplate>
                        <DataTemplate x:DataType="views:Timeline2OrderEvent">
                            <TextBlock Text="{x:Bind Date}" />
                        </DataTemplate>
                    </dev:Timeline2.OppositeTemplate>
                    <dev:Timeline2.ItemTemplate>
                        <DataTemplate x:DataType="views:Timeline2OrderEvent">
                            <TextBlock FontWeight="Medium" Text="{x:Bind Status}" />
                        </DataTemplate>
                    </dev:Timeline2.ItemTemplate>
                </dev:Timeline2>
            </local:ControlExample>

            <local:ControlExample HeaderText="Clickable">
                <local:ControlExample.Xaml>
                    <x:String>
                        &lt;dev:Timeline2 Width="384" ActivateOnClick="True" ActiveValue="kickoff" IsItemClickEnabled="True" ItemClick="OnItemClick" ItemsSource="{x:Bind Entries}" /&gt;
                    </x:String>
                </local:ControlExample.Xaml>
                <StackPanel Spacing="12">
                    <dev:Timeline2 Width="384" HorizontalAlignment="Left" ActivateOnClick="True" ActiveValue="kickoff" IsItemClickEnabled="True" ItemClick="OnItemClick" ItemsSource="{x:Bind Entries}" />
                    <TextBlock x:Name="SelectionText" Text="Select an item" />
                </StackPanel>
            </local:ControlExample>

        </StackPanel>
    </ScrollViewer>
</Page>
