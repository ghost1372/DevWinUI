<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ShowMoreRing" Color="#A1A1A1" />
            <LinearGradientBrush x:Key="ShowMoreVeilBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00F3F3F3" />
                <GradientStop Offset="0.2" Color="#1AF3F3F3" />
                <GradientStop Offset="0.4" Color="#5AF3F3F3" />
                <GradientStop Offset="0.6" Color="#A5F3F3F3" />
                <GradientStop Offset="0.8" Color="#E4F3F3F3" />
                <GradientStop Offset="1" Color="#FFF3F3F3" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ShowMoreSecondaryVeilBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00EEEEEE" />
                <GradientStop Offset="0.2" Color="#1AEEEEEE" />
                <GradientStop Offset="0.4" Color="#5AEEEEEE" />
                <GradientStop Offset="0.6" Color="#A5EEEEEE" />
                <GradientStop Offset="0.8" Color="#E4EEEEEE" />
                <GradientStop Offset="1" Color="#FFEEEEEE" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ShowMoreRing" Color="#737373" />
            <LinearGradientBrush x:Key="ShowMoreVeilBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00202020" />
                <GradientStop Offset="0.2" Color="#1A202020" />
                <GradientStop Offset="0.4" Color="#5A202020" />
                <GradientStop Offset="0.6" Color="#A5202020" />
                <GradientStop Offset="0.8" Color="#E4202020" />
                <GradientStop Offset="1" Color="#FF202020" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="ShowMoreSecondaryVeilBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#001C1C1C" />
                <GradientStop Offset="0.2" Color="#1A1C1C1C" />
                <GradientStop Offset="0.4" Color="#5A1C1C1C" />
                <GradientStop Offset="0.6" Color="#A51C1C1C" />
                <GradientStop Offset="0.8" Color="#E41C1C1C" />
                <GradientStop Offset="1" Color="#FF1C1C1C" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ShowMoreRing" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ShowMoreVeilBrush" Color="Transparent" />
            <SolidColorBrush x:Key="ShowMoreSecondaryVeilBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style BasedOn="{StaticResource DefaultShowMoreStyle}" TargetType="local:ShowMore" />

    <Style x:Key="DefaultShowMoreStyle" TargetType="local:ShowMore">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="VeilBrush" Value="{ThemeResource ShowMoreVeilBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ShowMore">
                    <StackPanel>
                        <Grid x:Name="PART_Region">
                            <ScrollViewer x:Name="PART_Scroller" FocusVisualPrimaryBrush="{ThemeResource ShowMoreRing}" FocusVisualPrimaryThickness="2" FocusVisualSecondaryThickness="0" HorizontalScrollBarVisibility="Disabled" HorizontalScrollMode="Disabled" IsTabStop="False" UseSystemFocusVisuals="True" VerticalScrollBarVisibility="Hidden" VerticalScrollMode="Disabled">
                                <ContentPresenter x:Name="PART_Content" VerticalAlignment="Top" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" TextWrapping="Wrap" />
                            </ScrollViewer>

                            <Rectangle x:Name="PART_Veil" VerticalAlignment="Bottom" Fill="{TemplateBinding VeilBrush}" IsHitTestVisible="False" Opacity="0" />
                        </Grid>

                        <ToggleButton x:Name="PART_Toggle" IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Style="{StaticResource SubtleToggleButtonStyle}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock x:Name="PART_ToggleLabel" VerticalAlignment="Center" />
                                <Path Width="12" Height="12" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Data="M3,4.5 L6,7.5 L9,4.5" RenderTransformOrigin="0.5,0.5" Stroke="{Binding Foreground, ElementName=PART_ToggleLabel}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.5">
                                    <Path.RenderTransform>
                                        <RotateTransform x:Name="PART_ChevronRotate" />
                                    </Path.RenderTransform>
                                </Path>
                            </StackPanel>
                        </ToggleButton>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
