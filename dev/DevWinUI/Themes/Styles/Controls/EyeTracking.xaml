<?xml version="1.0" encoding="utf-8" ?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="EyeTrackingScleraBrush" Color="#E8E2DC" />
            <SolidColorBrush x:Key="EyeTrackingCyberScleraBrush" Color="#0A0E17" />
            <SolidColorBrush x:Key="EyeTrackingIrisBrush" Color="#4A6741" />
            <SolidColorBrush x:Key="EyeTrackingIrisAccentBrush" Color="#6B8F62" />
            <SolidColorBrush x:Key="EyeTrackingPupilBrush" Color="#0A0A0A" />
            <SolidColorBrush x:Key="EyeTrackingOutlineBrush" Color="#D1D5DB" />
            <SolidColorBrush x:Key="EyeTrackingRimBrush" Color="#40FFFFFF" />
            <SolidColorBrush x:Key="EyeTrackingVeinBrush" Color="#96BE3C3C" />
            <SolidColorBrush x:Key="EyeTrackingHighlightBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EyeTrackingShadeBrush" Color="#000000" />
            <LinearGradientBrush x:Key="EyeTrackingUpperEyelidShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#78000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EyeTrackingLowerEyelidShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#2D000000" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="EyeTrackingScleraBrush" Color="#F5F0EB" />
            <SolidColorBrush x:Key="EyeTrackingCyberScleraBrush" Color="#0A0E17" />
            <SolidColorBrush x:Key="EyeTrackingIrisBrush" Color="#4A6741" />
            <SolidColorBrush x:Key="EyeTrackingIrisAccentBrush" Color="#6B8F62" />
            <SolidColorBrush x:Key="EyeTrackingPupilBrush" Color="#0A0A0A" />
            <SolidColorBrush x:Key="EyeTrackingOutlineBrush" Color="#111111" />
            <SolidColorBrush x:Key="EyeTrackingRimBrush" Color="#463C2828" />
            <SolidColorBrush x:Key="EyeTrackingVeinBrush" Color="#96BE3C3C" />
            <SolidColorBrush x:Key="EyeTrackingHighlightBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="EyeTrackingShadeBrush" Color="#000000" />
            <LinearGradientBrush x:Key="EyeTrackingUpperEyelidShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#78000000" />
                <GradientStop Offset="1" Color="#00000000" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="EyeTrackingLowerEyelidShadeBrush" StartPoint="0,0" EndPoint="0,1">
                <GradientStop Offset="0" Color="#00000000" />
                <GradientStop Offset="1" Color="#2D000000" />
            </LinearGradientBrush>
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="EyeTrackingScleraBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EyeTrackingCyberScleraBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EyeTrackingIrisBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EyeTrackingIrisAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="EyeTrackingPupilBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EyeTrackingOutlineBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EyeTrackingRimBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EyeTrackingVeinBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="EyeTrackingHighlightBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="EyeTrackingShadeBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="EyeTrackingUpperEyelidShadeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="EyeTrackingLowerEyelidShadeBrush" Color="Transparent" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style BasedOn="{StaticResource DefaultEyeTrackingStyle}" TargetType="local:EyeTracking" />

    <Style x:Key="DefaultEyeTrackingStyle" TargetType="local:EyeTracking">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="ScleraBrush" Value="{ThemeResource EyeTrackingScleraBrush}" />
        <Setter Property="CyberScleraBrush" Value="{ThemeResource EyeTrackingCyberScleraBrush}" />
        <Setter Property="IrisBrush" Value="{ThemeResource EyeTrackingIrisBrush}" />
        <Setter Property="IrisAccentBrush" Value="{ThemeResource EyeTrackingIrisAccentBrush}" />
        <Setter Property="PupilBrush" Value="{ThemeResource EyeTrackingPupilBrush}" />
        <Setter Property="OutlineBrush" Value="{ThemeResource EyeTrackingOutlineBrush}" />
        <Setter Property="RimBrush" Value="{ThemeResource EyeTrackingRimBrush}" />
        <Setter Property="VeinBrush" Value="{ThemeResource EyeTrackingVeinBrush}" />
        <Setter Property="HighlightBrush" Value="{ThemeResource EyeTrackingHighlightBrush}" />
        <Setter Property="ShadeBrush" Value="{ThemeResource EyeTrackingShadeBrush}" />
        <Setter Property="UpperEyelidShadeBrush" Value="{ThemeResource EyeTrackingUpperEyelidShadeBrush}" />
        <Setter Property="LowerEyelidShadeBrush" Value="{ThemeResource EyeTrackingLowerEyelidShadeBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:EyeTracking">
                    <Grid Margin="8">
                        <Canvas x:Name="PART_Root" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
