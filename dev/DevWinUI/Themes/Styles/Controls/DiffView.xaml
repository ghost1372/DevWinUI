<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="FileDiffSelectionBaseBrush" Color="#202020" />
            <SolidColorBrush x:Key="FileDiffAddedBackgroundBrush" Color="#113A1B" />
            <SolidColorBrush x:Key="FileDiffRemovedBackgroundBrush" Color="#450C0F" />
            <SolidColorBrush x:Key="FileDiffAddedAccentBrush" Color="#2EA043" />
            <SolidColorBrush x:Key="FileDiffRemovedAccentBrush" Color="#E5484D" />
            <SolidColorBrush x:Key="FileDiffPlaceholderBackgroundBrush" Color="#1D2125" />
            <SolidColorBrush x:Key="FileDiffAddedHighlightBrush" Color="#22863A" />
            <SolidColorBrush x:Key="FileDiffRemovedHighlightBrush" Color="#B31D28" />
            <SolidColorBrush x:Key="FileDiffHighlightForegroundBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FileDiffSelectionBackgroundBrush" Color="#CC0A5AD7" />
            <SolidColorBrush x:Key="FileDiffSelectionForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="FileDiffSelectionBaseBrush" Color="#FFFFFF" />
            <SolidColorBrush x:Key="FileDiffAddedBackgroundBrush" Color="#E6FFEC" />
            <SolidColorBrush x:Key="FileDiffRemovedBackgroundBrush" Color="#FFEBE9" />
            <SolidColorBrush x:Key="FileDiffAddedAccentBrush" Color="#1A7F37" />
            <SolidColorBrush x:Key="FileDiffRemovedAccentBrush" Color="#CF222E" />
            <SolidColorBrush x:Key="FileDiffPlaceholderBackgroundBrush" Color="#F6F8FA" />
            <SolidColorBrush x:Key="FileDiffAddedHighlightBrush" Color="#ABF2BC" />
            <SolidColorBrush x:Key="FileDiffRemovedHighlightBrush" Color="#FFC1C0" />
            <StaticResource x:Key="FileDiffHighlightForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <SolidColorBrush x:Key="FileDiffSelectionBackgroundBrush" Color="#CC0A5AD7" />
            <SolidColorBrush x:Key="FileDiffSelectionForegroundBrush" Color="#FFFFFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="FileDiffSelectionBaseBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="FileDiffAddedBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="FileDiffRemovedBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="FileDiffAddedAccentBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="FileDiffRemovedAccentBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="FileDiffPlaceholderBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="FileDiffAddedHighlightBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="FileDiffRemovedHighlightBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="FileDiffHighlightForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="FileDiffSelectionBackgroundBrush" ResourceKey="SystemColorHotlightColorBrush" />
            <StaticResource x:Key="FileDiffSelectionForegroundBrush" ResourceKey="SystemColorWindowColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <x:String x:Key="FileDiffApproximateText">approximate</x:String>
    <x:String x:Key="FileDiffInlineText">Inline</x:String>
    <x:String x:Key="FileDiffBeforeText">Before</x:String>
    <x:String x:Key="FileDiffAfterText">After</x:String>
    <x:String x:Key="FileDiffCopyText">Copy</x:String>
    <x:String x:Key="FileDiffSelectAllText">Select all</x:String>
    <x:String x:Key="FileDiffExpanderFormat">⋯  {0:N0} unchanged lines</x:String>
    <x:String x:Key="FileDiffExpandAutomationFormat">Expand {0} unchanged lines</x:String>
    <x:String x:Key="FileDiffAddedLineFormat">Added: {0}</x:String>
    <x:String x:Key="FileDiffRemovedLineFormat">Removed: {0}</x:String>
    <x:String x:Key="FileDiffFileAutomationFormat">File diff: {0}</x:String>
    <x:String x:Key="FileDiffSummaryAutomationFormat">{0} added, {1} removed</x:String>

    <Style BasedOn="{StaticResource DefaultDiffViewStyle}" TargetType="local:DiffView" />

    <Style x:Key="DefaultDiffViewStyle" TargetType="local:DiffView">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="AddedBackground" Value="{ThemeResource FileDiffAddedBackgroundBrush}" />
        <Setter Property="RemovedBackground" Value="{ThemeResource FileDiffRemovedBackgroundBrush}" />
        <Setter Property="AddedAccent" Value="{ThemeResource FileDiffAddedAccentBrush}" />
        <Setter Property="RemovedAccent" Value="{ThemeResource FileDiffRemovedAccentBrush}" />
        <Setter Property="PlaceholderBackground" Value="{ThemeResource FileDiffPlaceholderBackgroundBrush}" />
        <Setter Property="AddedHighlight" Value="{ThemeResource FileDiffAddedHighlightBrush}" />
        <Setter Property="RemovedHighlight" Value="{ThemeResource FileDiffRemovedHighlightBrush}" />
        <Setter Property="HighlightForeground" Value="{ThemeResource FileDiffHighlightForegroundBrush}" />
        <Setter Property="SelectionBackground" Value="{ThemeResource FileDiffSelectionBackgroundBrush}" />
        <Setter Property="SelectionForeground" Value="{ThemeResource FileDiffSelectionForegroundBrush}" />
        <Setter Property="ApproximateText" Value="{StaticResource FileDiffApproximateText}" />
        <Setter Property="InlineText" Value="{StaticResource FileDiffInlineText}" />
        <Setter Property="BeforeText" Value="{StaticResource FileDiffBeforeText}" />
        <Setter Property="AfterText" Value="{StaticResource FileDiffAfterText}" />
        <Setter Property="CopyText" Value="{StaticResource FileDiffCopyText}" />
        <Setter Property="SelectAllText" Value="{StaticResource FileDiffSelectAllText}" />
        <Setter Property="ExpanderFormat" Value="{StaticResource FileDiffExpanderFormat}" />
        <Setter Property="ExpandAutomationFormat" Value="{StaticResource FileDiffExpandAutomationFormat}" />
        <Setter Property="AddedLineFormat" Value="{StaticResource FileDiffAddedLineFormat}" />
        <Setter Property="RemovedLineFormat" Value="{StaticResource FileDiffRemovedLineFormat}" />
        <Setter Property="FileAutomationFormat" Value="{StaticResource FileDiffFileAutomationFormat}" />
        <Setter Property="SummaryAutomationFormat" Value="{StaticResource FileDiffSummaryAutomationFormat}" />
        <Setter Property="SelectionBase" Value="{ThemeResource FileDiffSelectionBaseBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:DiffView">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="PART_HeaderBorder" Padding="12,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}" BorderThickness="0,0,0,1" CornerRadius="7,7,0,0">
                                <Grid ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Grid.Column="0" AutomationProperties.AccessibilityView="Raw" FontSize="14" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE8A5;" />

                                    <TextBlock x:Name="PART_FilenameText" Grid.Column="1" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />

                                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal" Spacing="8">
                                        <TextBlock x:Name="PART_AddedText" FontWeight="SemiBold" Foreground="{TemplateBinding AddedAccent}" />
                                        <TextBlock x:Name="PART_RemovedText" FontWeight="SemiBold" Foreground="{TemplateBinding RemovedAccent}" />
                                        <TextBlock x:Name="PART_ApproxText" Foreground="{ThemeResource TextFillColorTertiaryBrush}" Text="{TemplateBinding ApproximateText}" Visibility="Collapsed" />
                                    </StackPanel>

                                    <SelectorBar x:Name="PART_UnifiedSwitcher" Grid.Column="3" VerticalAlignment="Center" FontFamily="{ThemeResource ContentControlThemeFontFamily}" FontSize="12">
                                        <SelectorBarItem x:Name="PART_InlineItem" AutomationProperties.Name="{TemplateBinding InlineText}" Text="{TemplateBinding InlineText}" />
                                        <SelectorBarItem x:Name="PART_BeforeItem" AutomationProperties.Name="{TemplateBinding BeforeText}" Text="{TemplateBinding BeforeText}" />
                                        <SelectorBarItem x:Name="PART_AfterItem" AutomationProperties.Name="{TemplateBinding AfterText}" Text="{TemplateBinding AfterText}" />
                                    </SelectorBar>
                                </Grid>
                            </Border>

                            <ScrollViewer x:Name="PART_Scroller" Grid.Row="1" HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Auto" VerticalScrollMode="Auto">
                                <ItemsRepeater x:Name="PART_Repeater" Background="Transparent">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Vertical" Spacing="0" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </ScrollViewer>

                            <ProgressBar x:Name="PART_BusyBar" Grid.Row="1" VerticalAlignment="Top" IsIndeterminate="True" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
