<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="MagicKeyboardCustomChassisTop" ResourceKey="SolidBackgroundFillColorBase" />
            <StaticResource x:Key="MagicKeyboardCustomChassisBottom" ResourceKey="SolidBackgroundFillColorBase" />
            <StaticResource x:Key="MagicKeyboardCustomChassisStroke" ResourceKey="ControlStrongStrokeColorDefault" />
            <StaticResource x:Key="MagicKeyboardCustomFaceTop" ResourceKey="ControlSolidFillColorDefault" />
            <StaticResource x:Key="MagicKeyboardCustomFaceBottom" ResourceKey="ControlSolidFillColorDefault" />
            <StaticResource x:Key="MagicKeyboardCustomPressTop" ResourceKey="SolidBackgroundFillColorQuarternary" />
            <StaticResource x:Key="MagicKeyboardCustomPressBottom" ResourceKey="SolidBackgroundFillColorQuarternary" />
            <StaticResource x:Key="MagicKeyboardCustomEdge" ResourceKey="SolidBackgroundFillColorSecondary" />
            <StaticResource x:Key="MagicKeyboardCustomLegend" ResourceKey="TextFillColorPrimary" />
            <StaticResource x:Key="MagicKeyboardCustomDim" ResourceKey="TextFillColorSecondary" />
            <StaticResource x:Key="MagicKeyboardCustomLedActive" ResourceKey="SystemFillColorSuccess" />
            <StaticResource x:Key="MagicKeyboardPreviewBackground" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
            <StaticResource x:Key="MagicKeyboardPreviewBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <StaticResource x:Key="MagicKeyboardPreviewForeground" ResourceKey="TextFillColorPrimaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="MagicKeyboardCustomChassisTop" ResourceKey="SolidBackgroundFillColorBase" />
            <StaticResource x:Key="MagicKeyboardCustomChassisBottom" ResourceKey="SolidBackgroundFillColorBase" />
            <StaticResource x:Key="MagicKeyboardCustomChassisStroke" ResourceKey="ControlStrongStrokeColorDefault" />
            <StaticResource x:Key="MagicKeyboardCustomFaceTop" ResourceKey="ControlSolidFillColorDefault" />
            <StaticResource x:Key="MagicKeyboardCustomFaceBottom" ResourceKey="ControlSolidFillColorDefault" />
            <StaticResource x:Key="MagicKeyboardCustomPressTop" ResourceKey="SolidBackgroundFillColorQuarternary" />
            <StaticResource x:Key="MagicKeyboardCustomPressBottom" ResourceKey="SolidBackgroundFillColorQuarternary" />
            <StaticResource x:Key="MagicKeyboardCustomEdge" ResourceKey="SolidBackgroundFillColorSecondary" />
            <StaticResource x:Key="MagicKeyboardCustomLegend" ResourceKey="TextFillColorPrimary" />
            <StaticResource x:Key="MagicKeyboardCustomDim" ResourceKey="TextFillColorSecondary" />
            <StaticResource x:Key="MagicKeyboardCustomLedActive" ResourceKey="SystemFillColorSuccess" />
            <StaticResource x:Key="MagicKeyboardPreviewBackground" ResourceKey="SolidBackgroundFillColorTertiaryBrush" />
            <StaticResource x:Key="MagicKeyboardPreviewBorderBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
            <StaticResource x:Key="MagicKeyboardPreviewForeground" ResourceKey="TextFillColorPrimaryBrush" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="MagicKeyboardCustomChassisTop" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="MagicKeyboardCustomChassisBottom" ResourceKey="SystemColorWindowColor" />
            <StaticResource x:Key="MagicKeyboardCustomChassisStroke" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="MagicKeyboardCustomFaceTop" ResourceKey="SystemColorButtonFaceColor" />
            <StaticResource x:Key="MagicKeyboardCustomFaceBottom" ResourceKey="SystemColorButtonFaceColor" />
            <StaticResource x:Key="MagicKeyboardCustomPressTop" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="MagicKeyboardCustomPressBottom" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="MagicKeyboardCustomEdge" ResourceKey="SystemColorWindowTextColor" />
            <StaticResource x:Key="MagicKeyboardCustomLegend" ResourceKey="SystemColorButtonTextColor" />
            <StaticResource x:Key="MagicKeyboardCustomDim" ResourceKey="SystemColorButtonTextColor" />
            <StaticResource x:Key="MagicKeyboardCustomLedActive" ResourceKey="SystemColorHighlightColor" />
            <StaticResource x:Key="MagicKeyboardPreviewBackground" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MagicKeyboardPreviewBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MagicKeyboardPreviewForeground" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Color x:Key="MagicKeyboardSilverChassisTop">#E4E5E8</Color>
    <Color x:Key="MagicKeyboardSilverChassisBottom">#CFD1D5</Color>
    <Color x:Key="MagicKeyboardSilverChassisStroke">#B5B7BB</Color>
    <Color x:Key="MagicKeyboardSilverFaceTop">#FBFBFC</Color>
    <Color x:Key="MagicKeyboardSilverFaceBottom">#EEEFF1</Color>
    <Color x:Key="MagicKeyboardSilverPressTop">#E2E3E6</Color>
    <Color x:Key="MagicKeyboardSilverPressBottom">#D6D8DC</Color>
    <Color x:Key="MagicKeyboardSilverEdge">#A9ACB2</Color>
    <Color x:Key="MagicKeyboardSilverLegend">#2B2B2E</Color>
    <Color x:Key="MagicKeyboardSilverDim">#6E7076</Color>
    <Color x:Key="MagicKeyboardSilverLedActive">#34C759</Color>

    <Color x:Key="MagicKeyboardSpaceGrayChassisTop">#6A6B70</Color>
    <Color x:Key="MagicKeyboardSpaceGrayChassisBottom">#55565B</Color>
    <Color x:Key="MagicKeyboardSpaceGrayChassisStroke">#3E3F43</Color>
    <Color x:Key="MagicKeyboardSpaceGrayFaceTop">#2E2E32</Color>
    <Color x:Key="MagicKeyboardSpaceGrayFaceBottom">#1F1F22</Color>
    <Color x:Key="MagicKeyboardSpaceGrayPressTop">#19191C</Color>
    <Color x:Key="MagicKeyboardSpaceGrayPressBottom">#101012</Color>
    <Color x:Key="MagicKeyboardSpaceGrayEdge">#0A0A0B</Color>
    <Color x:Key="MagicKeyboardSpaceGrayLegend">#E8E8EA</Color>
    <Color x:Key="MagicKeyboardSpaceGrayDim">#9A9BA1</Color>
    <Color x:Key="MagicKeyboardSpaceGrayLedActive">#34C759</Color>

    <Color x:Key="MagicKeyboardMidnightChassisTop">#2B3140</Color>
    <Color x:Key="MagicKeyboardMidnightChassisBottom">#1D222E</Color>
    <Color x:Key="MagicKeyboardMidnightChassisStroke">#12151C</Color>
    <Color x:Key="MagicKeyboardMidnightFaceTop">#1A1E28</Color>
    <Color x:Key="MagicKeyboardMidnightFaceBottom">#11141B</Color>
    <Color x:Key="MagicKeyboardMidnightPressTop">#0C0E13</Color>
    <Color x:Key="MagicKeyboardMidnightPressBottom">#08090C</Color>
    <Color x:Key="MagicKeyboardMidnightEdge">#05060A</Color>
    <Color x:Key="MagicKeyboardMidnightLegend">#DCE1EC</Color>
    <Color x:Key="MagicKeyboardMidnightDim">#8A93A6</Color>
    <Color x:Key="MagicKeyboardMidnightLedActive">#34C759</Color>

    <Style x:Key="DefaultMagicKeyboardStyle" TargetType="local:MagicKeyboard">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MagicKeyboard">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border x:Name="PART_Preview" Margin="0,0,0,12" Padding="18,8" HorizontalAlignment="Center" Background="{ThemeResource MagicKeyboardPreviewBackground}" BorderBrush="{ThemeResource MagicKeyboardPreviewBorderBrush}" BorderThickness="1" CornerRadius="12" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                            <Border.OpacityTransition>
                                <ScalarTransition Duration="0:0:0.18" />
                            </Border.OpacityTransition>
                            <TextBlock x:Name="PART_PreviewText" FontSize="20" FontWeight="SemiBold" Foreground="{ThemeResource MagicKeyboardPreviewForeground}" />
                        </Border>

                        <Viewbox Grid.Row="1" Stretch="Uniform">
                            <Grid x:Name="PART_Board">
                                <Border x:Name="PART_Chassis" BorderThickness="1" CornerRadius="22" />
                                <Canvas x:Name="PART_Canvas" />
                            </Grid>
                        </Viewbox>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultMagicKeyboardStyle}" TargetType="local:MagicKeyboard" />

</ResourceDictionary>
