<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ProgressStepperPrimaryBrush" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="ProgressStepperSecondaryBrush" Color="#C5FFFFFF" />
            <SolidColorBrush x:Key="ProgressStepperTertiaryBrush" Color="#8BFFFFFF" />
            <SolidColorBrush x:Key="ProgressStepperRailBrush" Color="#28FFFFFF" />
            <SolidColorBrush x:Key="ProgressStepperSuccessBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="ProgressStepperSuccessFillBrush" Color="#2622C55E" />
            <SolidColorBrush x:Key="ProgressStepperAccentBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="ProgressStepperAccentTrackBrush" Color="#3C3B82F6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ProgressStepperPrimaryBrush" Color="#E4000000" />
            <SolidColorBrush x:Key="ProgressStepperSecondaryBrush" Color="#9E000000" />
            <SolidColorBrush x:Key="ProgressStepperTertiaryBrush" Color="#72000000" />
            <SolidColorBrush x:Key="ProgressStepperRailBrush" Color="#28000000" />
            <SolidColorBrush x:Key="ProgressStepperSuccessBrush" Color="#22C55E" />
            <SolidColorBrush x:Key="ProgressStepperSuccessFillBrush" Color="#2622C55E" />
            <SolidColorBrush x:Key="ProgressStepperAccentBrush" Color="#3B82F6" />
            <SolidColorBrush x:Key="ProgressStepperAccentTrackBrush" Color="#3C3B82F6" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ProgressStepperPrimaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ProgressStepperSecondaryBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ProgressStepperTertiaryBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ProgressStepperRailBrush" Color="{ThemeResource SystemColorGrayTextColor}" />
            <SolidColorBrush x:Key="ProgressStepperSuccessBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ProgressStepperSuccessFillBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ProgressStepperAccentBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ProgressStepperAccentTrackBrush" Color="{ThemeResource SystemColorWindowColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="DefaultProgressStepperStyle" TargetType="local:ProgressStepper">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="PrimaryForeground" Value="{ThemeResource ProgressStepperPrimaryBrush}" />
        <Setter Property="SecondaryForeground" Value="{ThemeResource ProgressStepperSecondaryBrush}" />
        <Setter Property="TertiaryForeground" Value="{ThemeResource ProgressStepperTertiaryBrush}" />
        <Setter Property="RailBrush" Value="{ThemeResource ProgressStepperRailBrush}" />
        <Setter Property="SuccessBrush" Value="{ThemeResource ProgressStepperSuccessBrush}" />
        <Setter Property="SuccessFillBrush" Value="{ThemeResource ProgressStepperSuccessFillBrush}" />
        <Setter Property="AccentBrush" Value="{ThemeResource ProgressStepperAccentBrush}" />
        <Setter Property="AccentTrackBrush" Value="{ThemeResource ProgressStepperAccentTrackBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ProgressStepper">
                    <Border x:Name="PART_Host" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultProgressStepperStyle}" TargetType="local:ProgressStepper" />
</ResourceDictionary>
