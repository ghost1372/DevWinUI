<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="MultiStepWizardCardBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="MultiStepWizardCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="MultiStepWizardForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="MultiStepWizardCounterForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="MultiStepWizardTrackBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="MultiStepWizardProgressBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="MultiStepWizardSegmentForegroundBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="MultiStepWizardActiveSegmentForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="MultiStepWizardCardBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
            <StaticResource x:Key="MultiStepWizardCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
            <StaticResource x:Key="MultiStepWizardForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="MultiStepWizardCounterForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="MultiStepWizardTrackBrush" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="MultiStepWizardProgressBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="MultiStepWizardSegmentForegroundBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="MultiStepWizardActiveSegmentForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="MultiStepWizardCardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
            <StaticResource x:Key="MultiStepWizardCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MultiStepWizardForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MultiStepWizardCounterForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="MultiStepWizardTrackBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="MultiStepWizardProgressBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="MultiStepWizardSegmentForegroundBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="MultiStepWizardActiveSegmentForegroundBrush" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style BasedOn="{StaticResource DefaultMorphingWizardStyle}" TargetType="local:MorphingWizard" />

    <Style x:Key="DefaultMorphingWizardStyle" TargetType="local:MorphingWizard">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Padding" Value="24" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{ThemeResource MultiStepWizardCardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource MultiStepWizardCardBorderBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource MultiStepWizardForegroundBrush}" />
        <Setter Property="CounterForeground" Value="{ThemeResource MultiStepWizardCounterForegroundBrush}" />
        <Setter Property="TrackBrush" Value="{ThemeResource MultiStepWizardTrackBrush}" />
        <Setter Property="ProgressBrush" Value="{ThemeResource MultiStepWizardProgressBrush}" />
        <Setter Property="SegmentForeground" Value="{ThemeResource MultiStepWizardSegmentForegroundBrush}" />
        <Setter Property="ActiveSegmentForeground" Value="{ThemeResource MultiStepWizardActiveSegmentForegroundBrush}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:MorphingWizard">
                    <Border x:Name="PART_Card" Padding="{TemplateBinding Padding}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                        <Border.Resources>
                            <Style x:Key="TrackStyle" TargetType="Border">
                                <Setter Property="Height" Value="4" />
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="Background" Value="{ThemeResource MultiStepWizardTrackBrush}" />
                            </Style>

                            <Style x:Key="FillStyle" TargetType="Border">
                                <Setter Property="CornerRadius" Value="2" />
                                <Setter Property="Background" Value="{ThemeResource MultiStepWizardProgressBrush}" />
                            </Style>

                            <Style x:Key="SegmentLabelStyle" TargetType="TextBlock">
                                <Setter Property="FontSize" Value="12" />
                                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                <Setter Property="Foreground" Value="{ThemeResource MultiStepWizardSegmentForegroundBrush}" />
                            </Style>

                            <Style x:Key="SegmentLabelActiveStyle" BasedOn="{StaticResource SegmentLabelStyle}" TargetType="TextBlock">
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Foreground" Value="{ThemeResource MultiStepWizardActiveSegmentForegroundBrush}" />
                            </Style>
                        </Border.Resources>

                        <Grid RowSpacing="20">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock x:Name="PART_CounterText" Grid.Row="0" AutomationProperties.LiveSetting="Polite" Foreground="{TemplateBinding CounterForeground}" Style="{StaticResource CaptionTextBlockStyle}" />

                            <Grid x:Name="PART_ProgressGrid" Grid.Row="1" ColumnSpacing="8" />

                            <local:MorphHost x:Name="PART_Host" Grid.Row="2" />

                            <Grid Grid.Row="3">
                                <Button x:Name="PART_BackButton" HorizontalAlignment="Left" Content="{TemplateBinding BackText}" IsEnabled="False" Opacity="0">
                                    <Button.OpacityTransition>
                                        <ScalarTransition Duration="0:0:0.18" />
                                    </Button.OpacityTransition>
                                </Button>

                                <Button x:Name="PART_NextButton" MinWidth="104" HorizontalAlignment="Right" Style="{StaticResource AccentButtonStyle}">
                                    <Grid>
                                        <TextBlock x:Name="PART_ContinueLabel" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Text="{TemplateBinding ContinueText}">
                                            <TextBlock.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.18" />
                                            </TextBlock.OpacityTransition>
                                        </TextBlock>
                                        <TextBlock x:Name="PART_FinishLabel" HorizontalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Opacity="0" Text="{TemplateBinding FinishText}">
                                            <TextBlock.OpacityTransition>
                                                <ScalarTransition Duration="0:0:0.18" />
                                            </TextBlock.OpacityTransition>
                                        </TextBlock>
                                    </Grid>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
