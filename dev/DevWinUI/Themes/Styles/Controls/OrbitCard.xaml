<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="OrbitCardBackground" Color="{ThemeResource SolidBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="OrbitCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="OrbitCardNameForeground" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="OrbitCardRoleForeground" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="OrbitCardDescriptionForeground" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="OrbitCardOverlayBackground" Color="#AA000000" />
            <SolidColorBrush x:Key="OrbitCardOverlayForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OrbitCardInitialsForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OrbitCardLinkBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="OrbitCardPalette0" Color="#6D28D9" />
            <SolidColorBrush x:Key="OrbitCardPalette1" Color="#0F766E" />
            <SolidColorBrush x:Key="OrbitCardPalette2" Color="#C2410C" />
            <SolidColorBrush x:Key="OrbitCardPalette3" Color="#1D4ED8" />
            <SolidColorBrush x:Key="OrbitCardPalette4" Color="#BE185D" />
            <SolidColorBrush x:Key="OrbitCardPalette5" Color="#4D7C0F" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="OrbitCardBackground" Color="{ThemeResource SolidBackgroundFillColorSecondary}" />
            <SolidColorBrush x:Key="OrbitCardBorderBrush" Color="{ThemeResource CardStrokeColorDefault}" />
            <SolidColorBrush x:Key="OrbitCardNameForeground" Color="{ThemeResource TextFillColorPrimary}" />
            <SolidColorBrush x:Key="OrbitCardRoleForeground" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="OrbitCardDescriptionForeground" Color="{ThemeResource TextFillColorSecondary}" />
            <SolidColorBrush x:Key="OrbitCardOverlayBackground" Color="#AA000000" />
            <SolidColorBrush x:Key="OrbitCardOverlayForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OrbitCardInitialsForeground" Color="#FFFFFFFF" />
            <SolidColorBrush x:Key="OrbitCardLinkBorderBrush" Color="Transparent" />
            <SolidColorBrush x:Key="OrbitCardPalette0" Color="#6D28D9" />
            <SolidColorBrush x:Key="OrbitCardPalette1" Color="#0F766E" />
            <SolidColorBrush x:Key="OrbitCardPalette2" Color="#C2410C" />
            <SolidColorBrush x:Key="OrbitCardPalette3" Color="#1D4ED8" />
            <SolidColorBrush x:Key="OrbitCardPalette4" Color="#BE185D" />
            <SolidColorBrush x:Key="OrbitCardPalette5" Color="#4D7C0F" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="OrbitCardBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrbitCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OrbitCardNameForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OrbitCardRoleForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OrbitCardDescriptionForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OrbitCardOverlayBackground" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="OrbitCardOverlayForeground" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OrbitCardInitialsForeground" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="OrbitCardLinkBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="OrbitCardPalette0" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrbitCardPalette1" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrbitCardPalette2" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrbitCardPalette3" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrbitCardPalette4" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="OrbitCardPalette5" Color="{ThemeResource SystemColorHighlightColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style BasedOn="{StaticResource DefaultOrbitCardStackStyle}" TargetType="local:OrbitCardStack" />

    <Style x:Key="DefaultOrbitCardStackStyle" TargetType="local:OrbitCardStack">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OrbitCardStack">
                    <Grid x:Name="PART_Stage" Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultOrbitCardStyle}" TargetType="local:OrbitCard" />

    <Style x:Key="DefaultOrbitCardStyle" TargetType="local:OrbitCard">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:OrbitCard">
                    <Border Background="{ThemeResource OrbitCardBackground}" BorderBrush="{ThemeResource OrbitCardBorderBrush}" BorderThickness="1" CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="PaletteStates">
                                <VisualState x:Name="Palette0">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Initials.Background" Value="{ThemeResource OrbitCardPalette0}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Palette1">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Initials.Background" Value="{ThemeResource OrbitCardPalette1}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Palette2">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Initials.Background" Value="{ThemeResource OrbitCardPalette2}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Palette3">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Initials.Background" Value="{ThemeResource OrbitCardPalette3}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Palette4">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Initials.Background" Value="{ThemeResource OrbitCardPalette4}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Palette5">
                                    <VisualState.Setters>
                                        <Setter Target="PART_Initials.Background" Value="{ThemeResource OrbitCardPalette5}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Border x:Name="PART_Image" CornerRadius="13,13,0,0" />

                                <Border x:Name="PART_Initials" CornerRadius="13,13,0,0">
                                    <TextBlock x:Name="PART_InitialsText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{TemplateBinding InitialsFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource OrbitCardInitialsForeground}" />
                                </Border>

                                <ContentPresenter HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" />

                                <Border x:Name="PART_Stat" Margin="8" Padding="7,2,7,3" HorizontalAlignment="Right" VerticalAlignment="Top" Background="{ThemeResource OrbitCardOverlayBackground}" CornerRadius="10">
                                    <TextBlock x:Name="PART_StatText" FontSize="10.5" FontWeight="SemiBold" Foreground="{ThemeResource OrbitCardOverlayForeground}" />
                                </Border>

                                <Button x:Name="PART_Link" Width="28" Height="28" MinWidth="0" MinHeight="0" Margin="0,0,8,8" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Bottom" BorderThickness="0" CornerRadius="14" IsTabStop="False" Visibility="Collapsed">
                                    <Button.Resources>
                                        <ThemeResource x:Key="ButtonBackground" ResourceKey="OrbitCardOverlayBackground" />
                                        <ThemeResource x:Key="ButtonBackgroundPointerOver" ResourceKey="OrbitCardOverlayBackground" />
                                        <ThemeResource x:Key="ButtonBackgroundPressed" ResourceKey="OrbitCardOverlayBackground" />
                                        <ThemeResource x:Key="ButtonForeground" ResourceKey="OrbitCardOverlayForeground" />
                                        <ThemeResource x:Key="ButtonForegroundPointerOver" ResourceKey="OrbitCardOverlayForeground" />
                                        <ThemeResource x:Key="ButtonForegroundPressed" ResourceKey="OrbitCardOverlayForeground" />
                                        <ThemeResource x:Key="ButtonBorderBrush" ResourceKey="OrbitCardLinkBorderBrush" />
                                        <ThemeResource x:Key="ButtonBorderBrushPointerOver" ResourceKey="OrbitCardLinkBorderBrush" />
                                        <ThemeResource x:Key="ButtonBorderBrushPressed" ResourceKey="OrbitCardLinkBorderBrush" />
                                    </Button.Resources>
                                    <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                </Button>
                            </Grid>

                            <StackPanel Grid.Row="1" Margin="10,8,10,10" Spacing="1">
                                <TextBlock x:Name="PART_Name" FontSize="{TemplateBinding NameFontSize}" FontWeight="SemiBold" Foreground="{ThemeResource OrbitCardNameForeground}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PART_Role" FontSize="{TemplateBinding BodyFontSize}" Foreground="{ThemeResource OrbitCardRoleForeground}" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="PART_Description" Margin="0,3,0,0" FontSize="{TemplateBinding BodyFontSize}" Foreground="{ThemeResource OrbitCardDescriptionForeground}" MaxLines="2" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
