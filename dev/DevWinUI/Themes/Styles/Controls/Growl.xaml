                                <VisualState x:Name="IconColorAttentionVivid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Background" Value="{ThemeResource GrowlCardAttentionVividFillBrush}" />
                                        <Setter Target="PART_IconDisc.Fill" Value="{ThemeResource GrowlCardAttentionVividFillBrush}" />
                                        <Setter Target="PART_IconRing.Stroke" Value="{ThemeResource GrowlCardAttentionVividFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconColorSuccessVivid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Background" Value="{ThemeResource GrowlCardSuccessVividFillBrush}" />
                                        <Setter Target="PART_IconDisc.Fill" Value="{ThemeResource GrowlCardSuccessVividFillBrush}" />
                                        <Setter Target="PART_IconRing.Stroke" Value="{ThemeResource GrowlCardSuccessVividFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconColorWarningVivid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Background" Value="{ThemeResource GrowlCardWarningVividFillBrush}" />
                                        <Setter Target="PART_IconDisc.Fill" Value="{ThemeResource GrowlCardWarningVividFillBrush}" />
                                        <Setter Target="PART_IconRing.Stroke" Value="{ThemeResource GrowlCardWarningVividFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconColorErrorVivid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Background" Value="{ThemeResource GrowlCardErrorVividFillBrush}" />
                                        <Setter Target="PART_IconDisc.Fill" Value="{ThemeResource GrowlCardErrorVividFillBrush}" />
                                        <Setter Target="PART_IconRing.Stroke" Value="{ThemeResource GrowlCardErrorVividFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconColorInfoVivid">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Background" Value="{ThemeResource GrowlCardInfoVividFillBrush}" />
                                        <Setter Target="PART_IconDisc.Fill" Value="{ThemeResource GrowlCardInfoVividFillBrush}" />
                                        <Setter Target="PART_IconRing.Stroke" Value="{ThemeResource GrowlCardInfoVividFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconColorRainbow">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Background" Value="{ThemeResource GrowlCardRainbowFillBrush}" />
                                        <Setter Target="PART_IconDisc.Fill" Value="{ThemeResource GrowlCardRainbowFillBrush}" />
                                        <Setter Target="PART_IconRing.Stroke" Value="{ThemeResource GrowlCardRainbowFillBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="IconBackgroundStates">
                                <VisualState x:Name="IconBackgroundDefault" />
                                <VisualState x:Name="IconBackgroundCustom">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="IconForegroundStates">
                                <VisualState x:Name="IconForegroundCustom" />
                                <VisualState x:Name="IconForegroundAttention">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconPresenter.Foreground" Value="{ThemeResource GrowlCardAttentionIconBackgroundBrush}" />
                                        <Setter Target="PART_DefaultIcon.Foreground" Value="{ThemeResource GrowlCardAttentionIconForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconForegroundSuccess">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconPresenter.Foreground" Value="{ThemeResource GrowlCardSuccessIconBackgroundBrush}" />
                                        <Setter Target="PART_DefaultIcon.Foreground" Value="{ThemeResource GrowlCardSuccessIconForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconForegroundWarning">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconPresenter.Foreground" Value="{ThemeResource GrowlCardWarningIconBackgroundBrush}" />
                                        <Setter Target="PART_DefaultIcon.Foreground" Value="{ThemeResource GrowlCardWarningIconForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconForegroundError">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconPresenter.Foreground" Value="{ThemeResource GrowlCardErrorIconBackgroundBrush}" />
                                        <Setter Target="PART_DefaultIcon.Foreground" Value="{ThemeResource GrowlCardErrorIconForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconForegroundInfo">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconPresenter.Foreground" Value="{ThemeResource GrowlCardInfoIconBackgroundBrush}" />
                                        <Setter Target="PART_DefaultIcon.Foreground" Value="{ThemeResource GrowlCardInfoIconForegroundBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="IconBorderStates">
                                <VisualState x:Name="IconBorderDefault" />
                                <VisualState x:Name="IconBorderCustom">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconContainer.BorderThickness" Value="{ThemeResource GrowlCardIconBorderThickness}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="IconStyleStates">
                                <VisualState x:Name="IconStyleFilled" />
                                <VisualState x:Name="IconStyleOutline">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconDisc.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_IconRing.Visibility" Value="Visible" />
                                        <Setter Target="PART_IconMark.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_IconMarkOutline.Visibility" Value="Visible" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="IconStyleRing">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconRing.Visibility" Value="Visible" />
                                        <Setter Target="PART_IconRing.Opacity" Value="{ThemeResource GrowlCardRingOpacity}" />
                                        <Setter Target="PART_IconRing.StrokeThickness" Value="1.5" />
                                        <Setter Target="PART_IconRing.Width" Value="22.5" />
                                        <Setter Target="PART_IconRing.Height" Value="22.5" />
                                        <Setter Target="PART_IconRing.(Canvas.Left)" Value="0.75" />
                                        <Setter Target="PART_IconRing.(Canvas.Top)" Value="0.75" />
                                        <Setter Target="PART_IconDisc.Width" Value="16" />
                                        <Setter Target="PART_IconDisc.Height" Value="16" />
                                        <Setter Target="PART_IconDisc.(Canvas.Left)" Value="4" />
                                        <Setter Target="PART_IconDisc.(Canvas.Top)" Value="4" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>

                            <VisualStateGroup x:Name="IconContainerStates">
                                <VisualState x:Name="IconContainerVisible" />
                                <VisualState x:Name="IconContainerHidden">
                                    <VisualState.Setters>
                                        <Setter Target="PART_IconTint.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_IconContainer.Visibility" Value="Collapsed" />
                                        <Setter Target="PART_DefaultIcon.Margin" Value="{ThemeResource GrowlCardBareIconInset}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="GradientStates">
                                <VisualState x:Name="GradientHidden" />
                                <VisualState x:Name="GradientAttention">
                                    <VisualState.Setters>
                                        <Setter Target="PART_GradientLayer.Visibility" Value="Visible" />
                                        <Setter Target="PART_GradientLayer.Background" Value="{ThemeResource GrowlCardAttentionGradientBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="GradientSuccess">
                                    <VisualState.Setters>
                                        <Setter Target="PART_GradientLayer.Visibility" Value="Visible" />
                                        <Setter Target="PART_GradientLayer.Background" Value="{ThemeResource GrowlCardSuccessGradientBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="GradientWarning">
                                    <VisualState.Setters>
                                        <Setter Target="PART_GradientLayer.Visibility" Value="Visible" />
                                        <Setter Target="PART_GradientLayer.Background" Value="{ThemeResource GrowlCardWarningGradientBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="GradientError">
                                    <VisualState.Setters>
                                        <Setter Target="PART_GradientLayer.Visibility" Value="Visible" />
                                        <Setter Target="PART_GradientLayer.Background" Value="{ThemeResource GrowlCardErrorGradientBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="GradientInfo">
                                    <VisualState.Setters>
                                        <Setter Target="PART_GradientLayer.Visibility" Value="Visible" />
                                        <Setter Target="PART_GradientLayer.Background" Value="{ThemeResource GrowlCardInfoGradientBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="GradientIntensityStates">
                                <VisualState x:Name="GradientIntensityNormal" />
                                <VisualState x:Name="GradientIntensityLight">
                                    <VisualState.Setters>
                                        <Setter Target="PART_GradientLayer.Opacity" Value="{ThemeResource GrowlCardGradientLightOpacity}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>

                        <Grid x:Name="PART_Surface">
                            <Grid.Resources>
                                <SolidColorBrush x:Key="AttentionIndicatorBrush" Color="{ThemeResource GrowlCardAttentionIndicatorColor}" />
                                <SolidColorBrush x:Key="SuccessIndicatorBrush" Color="{ThemeResource GrowlCardSuccessIndicatorColor}" />
                                <SolidColorBrush x:Key="WarningIndicatorBrush" Color="{ThemeResource GrowlCardWarningIndicatorColor}" />
                                <SolidColorBrush x:Key="ErrorIndicatorBrush" Color="{ThemeResource GrowlCardErrorIndicatorColor}" />
                                <SolidColorBrush x:Key="InfoIndicatorBrush" Color="{ThemeResource GrowlCardInfoIndicatorColor}" />
                            </Grid.Resources>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border x:Name="PART_GradientLayer" Grid.RowSpan="3" Grid.ColumnSpan="3" CornerRadius="{ThemeResource GrowlCardInnerCornerRadius}" IsHitTestVisible="False" Opacity="{ThemeResource GrowlCardGradientOpacity}" Visibility="Collapsed" />

                            <Border x:Name="PART_CountdownProbe" Grid.RowSpan="3" Grid.ColumnSpan="3" Background="{ThemeResource GrowlCardCountdownBrush}" Visibility="Collapsed" />

                            <Border x:Name="PART_IndicatorTop" Grid.Row="0" Grid.ColumnSpan="3" Height="{TemplateBinding IndicatorThickness}" VerticalAlignment="Top" CornerRadius="{ThemeResource GrowlCardIndicatorTopCornerRadius}" Visibility="Collapsed" />

                            <Border x:Name="PART_IndicatorLeft" Grid.RowSpan="3" Grid.Column="0" Width="{TemplateBinding IndicatorThickness}" HorizontalAlignment="Left" CornerRadius="{ThemeResource GrowlCardIndicatorLeftCornerRadius}" Visibility="Collapsed" />

                            <Border x:Name="PART_IndicatorRight" Grid.RowSpan="3" Grid.Column="2" Width="{TemplateBinding IndicatorThickness}" HorizontalAlignment="Right" CornerRadius="{ThemeResource GrowlCardIndicatorRightCornerRadius}" Visibility="Collapsed" />

                            <Border x:Name="PART_IndicatorBottom" Grid.Row="2" Grid.ColumnSpan="3" Height="{TemplateBinding IndicatorThickness}" VerticalAlignment="Bottom" CornerRadius="{ThemeResource GrowlCardIndicatorBottomCornerRadius}" Visibility="Collapsed" />

                            <Grid x:Name="PART_ContentHost" Grid.Row="1" Grid.Column="1" Padding="{ThemeResource GrowlCardPadding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="PART_IconHost" Grid.Row="0" Grid.Column="0" Width="{ThemeResource GrowlCardIconSize}" Height="{ThemeResource GrowlCardIconSize}" Margin="{ThemeResource GrowlCardIconMargin}" VerticalAlignment="Top">
                                    <Border x:Name="PART_IconTint" CornerRadius="{ThemeResource GrowlCardIconCornerRadius}" Opacity="{ThemeResource GrowlCardIconTintOpacity}" />
                                    <Border x:Name="PART_IconContainer" Background="{TemplateBinding IconBackground}" BorderBrush="{TemplateBinding IconBorderBrush}" BorderThickness="0" CornerRadius="{ThemeResource GrowlCardIconCornerRadius}" />
                                    <ContentPresenter x:Name="PART_IconPresenter" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Icon}" Foreground="{TemplateBinding IconForeground}" />
                                    <ContentPresenter x:Name="PART_DefaultIcon" Margin="{ThemeResource GrowlCardIconInset}" Foreground="{TemplateBinding IconForeground}" Visibility="Collapsed">
                                        <Viewbox>
                                            <Canvas Width="24" Height="24">
                                                <Ellipse x:Name="PART_IconDisc" Width="24" Height="24" />
                                                <Ellipse x:Name="PART_IconRing" Canvas.Left="1" Canvas.Top="1" Width="22" Height="22" StrokeThickness="2" Visibility="Collapsed" />
                                                <Path x:Name="PART_IconMark" Stroke="{Binding Foreground, ElementName=PART_DefaultIcon}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" />
                                                <Path x:Name="PART_IconMarkOutline" Stroke="{Binding Stroke, ElementName=PART_IconRing}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="2" Visibility="Collapsed" />
                                            </Canvas>
                                        </Viewbox>
                                    </ContentPresenter>
                                </Grid>

                                <StackPanel x:Name="PART_TextPanel" Grid.Row="0" Grid.Column="1" MinHeight="{ThemeResource GrowlCardIconSize}" VerticalAlignment="Center" Spacing="{ThemeResource GrowlCardTextSpacing}">
                                    <TextBlock x:Name="PART_TitleBlock" Foreground="{ThemeResource GrowlCardTitleForegroundBrush}" Style="{ThemeResource BodyStrongTextBlockStyle}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PART_SubTitleBlock" Foreground="{ThemeResource GrowlCardSubTitleForegroundBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextWrapping="Wrap" />
                                </StackPanel>

                                <Grid x:Name="PART_RingHost" Grid.Row="0" Grid.Column="2" Width="{ThemeResource GrowlCardRingHostSize}" Height="{ThemeResource GrowlCardRingHostSize}" Margin="{ThemeResource GrowlCardRingMargin}" VerticalAlignment="Top" Visibility="Collapsed">
                                    <ProgressRing x:Name="PART_ProgressRing" Width="{ThemeResource GrowlCardRingSize}" Height="{ThemeResource GrowlCardRingSize}" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{ThemeResource ControlStrongStrokeColorDefaultBrush}" IsActive="True" IsIndeterminate="{TemplateBinding IsProgressIndeterminate}" Maximum="{TemplateBinding ProgressMaximum}" Minimum="0" Value="{TemplateBinding Progress}" />
                                    <TextBlock x:Name="PART_RingText" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="{ThemeResource GrowlCardRingTextSize}" Foreground="{ThemeResource GrowlCardProgressTextForegroundBrush}" />
                                </Grid>

                                <StackPanel x:Name="PART_MetaPanel" Grid.Row="0" Grid.Column="4" Margin="{ThemeResource GrowlCardCountdownTextMargin}" VerticalAlignment="Top" Orientation="Horizontal" Spacing="{ThemeResource GrowlCardMetaSpacing}">
                                    <TextBlock x:Name="PART_SentText" Foreground="{ThemeResource GrowlCardSentTextForegroundBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                    <TextBlock x:Name="PART_CountdownText" MinWidth="{ThemeResource GrowlCardCountdownTextMinWidth}" Foreground="{ThemeResource GrowlCardCountdownTextForegroundBrush}" Style="{ThemeResource CaptionTextBlockStyle}" TextAlignment="Right" />
                                </StackPanel>

                                <Button x:Name="PART_CloseButton" Grid.Row="0" Grid.Column="5" Width="{ThemeResource GrowlCardCloseButtonSize}" Height="{ThemeResource GrowlCardCloseButtonSize}" Margin="{ThemeResource GrowlCardCloseButtonMargin}" Padding="0" VerticalAlignment="Top" Background="Transparent" BorderThickness="0" CornerRadius="{ThemeResource GrowlCardIconCornerRadius}">
                                    <FontIcon FontSize="{ThemeResource GrowlCardCloseGlyphSize}" Foreground="{ThemeResource GrowlCardCloseGlyphForegroundBrush}" Glyph="&#xE711;" />
                                </Button>

                                <Border x:Name="PART_GapContent" Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="6" Height="{ThemeResource GrowlCardGapHeight}" />

                                <ContentPresenter x:Name="PART_ContentPresenter" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" ContentTransitions="{TemplateBinding ContentTransitions}" Foreground="{ThemeResource GrowlCardContentForegroundBrush}" TextWrapping="Wrap" />

                                <Border x:Name="PART_GapProgress" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Height="{ThemeResource GrowlCardGapHeight}" />

                                <Grid x:Name="PART_ProgressHost" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ProgressBar x:Name="PART_ProgressBar" Grid.Column="0" VerticalAlignment="Center" IsIndeterminate="{TemplateBinding IsProgressIndeterminate}" Maximum="{TemplateBinding ProgressMaximum}" Minimum="0" ShowError="{TemplateBinding IsProgressError}" ShowPaused="{TemplateBinding IsProgressPaused}" Value="{TemplateBinding Progress}" />
                                    <TextBlock x:Name="PART_ProgressText" Grid.Column="1" Margin="{ThemeResource GrowlCardProgressTextMargin}" Foreground="{ThemeResource GrowlCardProgressTextForegroundBrush}" Style="{ThemeResource CaptionTextBlockStyle}" />
                                </Grid>

                                <Border x:Name="PART_GapAction" Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="6" Height="{ThemeResource GrowlCardGapHeight}" />

                                <ContentPresenter x:Name="PART_ActionPresenter" Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="6" HorizontalAlignment="Right" VerticalAlignment="Top" Content="{TemplateBinding ActionContent}" />
                            </Grid>

                            <Border x:Name="PART_CountdownHost" Grid.Row="2" Grid.ColumnSpan="3" Height="{TemplateBinding IndicatorThickness}" VerticalAlignment="Bottom" CornerRadius="{ThemeResource GrowlCardIndicatorBottomCornerRadius}" Visibility="Collapsed">
                                <Border x:Name="PART_CountdownFill" CornerRadius="{ThemeResource GrowlCardIndicatorBottomCornerRadius}" RenderTransformOrigin="0,0.5" />
                            </Border>

                            <Image x:Name="PART_Snapshot" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False" Opacity="0" Stretch="Fill" Visibility="Collapsed" />
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultGrowlHostStyle}" TargetType="local:GrowlHost" />

    <Style x:Key="DefaultGrowlHostStyle" TargetType="local:GrowlHost">
        <Setter Property="Padding" Value="24" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GrowlHost">
                    <Grid Padding="{TemplateBinding Padding}">
                        <ScrollViewer HorizontalAlignment="Left" VerticalAlignment="Top" Style="{StaticResource GrowlHostScrollViewerStyle}" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                            <StackPanel x:Name="PART_TopLeft" Padding="16" Spacing="{TemplateBinding Spacing}" />
                        </ScrollViewer>
                        <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Top" Style="{StaticResource GrowlHostScrollViewerStyle}" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                            <StackPanel x:Name="PART_TopCenter" Padding="16" Spacing="{TemplateBinding Spacing}" />
                        </ScrollViewer>
                        <ScrollViewer HorizontalAlignment="Right" VerticalAlignment="Top" Style="{StaticResource GrowlHostScrollViewerStyle}" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                            <StackPanel x:Name="PART_TopRight" Padding="16" Spacing="{TemplateBinding Spacing}" />
                        </ScrollViewer>
                        <ScrollViewer HorizontalAlignment="Left" VerticalAlignment="Bottom" Style="{StaticResource GrowlHostScrollViewerStyle}" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                            <StackPanel x:Name="PART_BottomLeft" Padding="16" Spacing="{TemplateBinding Spacing}" />
                        </ScrollViewer>
                        <ScrollViewer HorizontalAlignment="Center" VerticalAlignment="Bottom" Style="{StaticResource GrowlHostScrollViewerStyle}" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                            <StackPanel x:Name="PART_BottomCenter" Padding="16" Spacing="{TemplateBinding Spacing}" />
                        </ScrollViewer>
                        <ScrollViewer HorizontalAlignment="Right" VerticalAlignment="Bottom" Style="{StaticResource GrowlHostScrollViewerStyle}" VerticalScrollBarVisibility="{TemplateBinding ScrollBarVisibility}">
                            <StackPanel x:Name="PART_BottomRight" Padding="16" Spacing="{TemplateBinding Spacing}" />
                        </ScrollViewer>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="GrowlHostScrollViewerStyle" TargetType="ScrollViewer">
        <Setter Property="Margin" Value="-16" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    </Style>
</ResourceDictionary>
