<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ActivityGridLevel0Brush" Color="#EEF0F2" />
            <SolidColorBrush x:Key="ActivityGridLevel1Brush" Color="#A7F3D0" />
            <SolidColorBrush x:Key="ActivityGridLevel2Brush" Color="#34D399" />
            <SolidColorBrush x:Key="ActivityGridLevel3Brush" Color="#059669" />
            <SolidColorBrush x:Key="ActivityGridLevel4Brush" Color="#065F46" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <SolidColorBrush x:Key="ActivityGridLevel0Brush" Color="#262A30" />
            <SolidColorBrush x:Key="ActivityGridLevel1Brush" Color="#064E3B" />
            <SolidColorBrush x:Key="ActivityGridLevel2Brush" Color="#047857" />
            <SolidColorBrush x:Key="ActivityGridLevel3Brush" Color="#10B981" />
            <SolidColorBrush x:Key="ActivityGridLevel4Brush" Color="#6EE7B7" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style BasedOn="{StaticResource DefaultGitHubActivityGridStyle}" TargetType="local:GitHubActivityGrid" />

    <Style x:Key="DefaultGitHubActivityGridStyle" TargetType="local:GitHubActivityGrid">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="Level0Brush" Value="{ThemeResource ActivityGridLevel0Brush}" />
        <Setter Property="Level1Brush" Value="{ThemeResource ActivityGridLevel1Brush}" />
        <Setter Property="Level2Brush" Value="{ThemeResource ActivityGridLevel2Brush}" />
        <Setter Property="Level3Brush" Value="{ThemeResource ActivityGridLevel3Brush}" />
        <Setter Property="Level4Brush" Value="{ThemeResource ActivityGridLevel4Brush}" />
        <Setter Property="TipBackground" Value="#F2111827" />
        <Setter Property="TipForeground" Value="White" />
        <Setter Property="TipSecondaryForeground" Value="#B3FFFFFF" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:GitHubActivityGrid">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" HorizontalScrollMode="Auto" VerticalScrollBarVisibility="Disabled" VerticalScrollMode="Disabled">
                        <StackPanel Spacing="10">
                            <Grid>
                                <Canvas x:Name="PART_Canvas" TabFocusNavigation="Once" XYFocusKeyboardNavigation="Enabled">
                                    <Canvas.Resources>
                                        <Style TargetType="Button">
                                            <Setter Property="MinWidth" Value="0" />
                                            <Setter Property="MinHeight" Value="0" />
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="UseSystemFocusVisuals" Value="True" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="{TemplateBinding CornerRadius}" />
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Canvas.Resources>
                                </Canvas>

                                <Canvas IsHitTestVisible="False">
                                    <Border x:Name="PART_Tip" Padding="10,6" Background="{TemplateBinding TipBackground}" CornerRadius="8" IsHitTestVisible="False" Opacity="0" Visibility="Collapsed">
                                        <StackPanel Spacing="1">
                                            <TextBlock x:Name="PART_TipCount" FontSize="12" FontWeight="SemiBold" Foreground="{TemplateBinding TipForeground}" />
                                            <TextBlock x:Name="PART_TipDate" FontSize="11" Foreground="{TemplateBinding TipSecondaryForeground}" />
                                        </StackPanel>
                                    </Border>
                                </Canvas>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="PART_Total" FontSize="12" Opacity="0.7" />
                                <StackPanel x:Name="PART_Legend" Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal" Spacing="4" />
                            </Grid>
                        </StackPanel>
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
