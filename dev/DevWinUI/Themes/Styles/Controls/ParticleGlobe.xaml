<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:canvas="using:Microsoft.Graphics.Canvas.UI.Xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>

        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="ParticleGlobeBackgroundBrush" Color="#FF03060F" />
            <SolidColorBrush x:Key="ParticleGlobeLandBrush" Color="#FF4DF2FF" />
            <SolidColorBrush x:Key="ParticleGlobeOceanBrush" Color="#FF1A73D9" />
            <SolidColorBrush x:Key="ParticleGlobeAtmosphereBrush" Color="#FF3399FF" />
            <SolidColorBrush x:Key="ParticleGlobeGridBrush" Opacity="0.22" Color="#FF4DB3FF" />
            <SolidColorBrush x:Key="ParticleGlobeArcBrush" Color="#FFFF8C33" />
            <SolidColorBrush x:Key="ParticleGlobeAccentBrush" Color="#FF8CFFD9" />
            <SolidColorBrush x:Key="ParticleGlobeStarBrush" Color="#FFCCE6FF" />
        </ResourceDictionary>

        <!--  The control always sits on a dark "space" backdrop (additive blending), so Light only shifts the hue.  -->
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="ParticleGlobeBackgroundBrush" Color="#FF050B1A" />
            <SolidColorBrush x:Key="ParticleGlobeLandBrush" Color="#FF5CFFC8" />
            <SolidColorBrush x:Key="ParticleGlobeOceanBrush" Color="#FF2A8CE0" />
            <SolidColorBrush x:Key="ParticleGlobeAtmosphereBrush" Color="#FF4DA6FF" />
            <SolidColorBrush x:Key="ParticleGlobeGridBrush" Opacity="0.22" Color="#FF66C2FF" />
            <SolidColorBrush x:Key="ParticleGlobeArcBrush" Color="#FFFF7A59" />
            <SolidColorBrush x:Key="ParticleGlobeAccentBrush" Color="#FFA6FFE6" />
            <SolidColorBrush x:Key="ParticleGlobeStarBrush" Color="#FFD9ECFF" />
        </ResourceDictionary>

        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="ParticleGlobeBackgroundBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="ParticleGlobeLandBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ParticleGlobeOceanBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ParticleGlobeAtmosphereBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ParticleGlobeGridBrush" Opacity="0.4" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="ParticleGlobeArcBrush" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="ParticleGlobeAccentBrush" Color="{ThemeResource SystemColorHotlightColor}" />
            <SolidColorBrush x:Key="ParticleGlobeStarBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
        </ResourceDictionary>

    </ResourceDictionary.ThemeDictionaries>

    <Style x:Key="DefaultParticleGlobeStyle" TargetType="local:ParticleGlobe">
        <Setter Property="Background" Value="{ThemeResource ParticleGlobeBackgroundBrush}" />
        <Setter Property="LandBrush" Value="{ThemeResource ParticleGlobeLandBrush}" />
        <Setter Property="OceanBrush" Value="{ThemeResource ParticleGlobeOceanBrush}" />
        <Setter Property="AtmosphereBrush" Value="{ThemeResource ParticleGlobeAtmosphereBrush}" />
        <Setter Property="GridBrush" Value="{ThemeResource ParticleGlobeGridBrush}" />
        <Setter Property="ArcBrush" Value="{ThemeResource ParticleGlobeArcBrush}" />
        <Setter Property="AccentBrush" Value="{ThemeResource ParticleGlobeAccentBrush}" />
        <Setter Property="StarBrush" Value="{ThemeResource ParticleGlobeStarBrush}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="MinWidth" Value="240" />
        <Setter Property="MinHeight" Value="240" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ParticleGlobe">
                    <Grid Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <canvas:CanvasAnimatedControl x:Name="PART_Canvas" ClearColor="Transparent" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultParticleGlobeStyle}" TargetType="local:ParticleGlobe" />

</ResourceDictionary>
