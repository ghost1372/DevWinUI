<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="SegmentedMeterTrackBackground" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="SegmentedMeterForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SegmentedMeterAccentBackground" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="SegmentedMeterSuccessBackground" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="SegmentedMeterAttentionBackground" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="SegmentedMeterDangerBackground" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="SegmentedMeterNeutralBackground" ResourceKey="ControlStrongFillColorDefaultBrush" />
            <StaticResource x:Key="SegmentedMeterLegendValueForeground" ResourceKey="TextFillColorSecondaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="SegmentedMeterTrackBackground" ResourceKey="ControlFillColorTertiaryBrush" />
            <StaticResource x:Key="SegmentedMeterForeground" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="SegmentedMeterAccentBackground" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="SegmentedMeterSuccessBackground" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="SegmentedMeterAttentionBackground" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="SegmentedMeterDangerBackground" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="SegmentedMeterNeutralBackground" ResourceKey="ControlStrongFillColorDefaultBrush" />
            <StaticResource x:Key="SegmentedMeterLegendValueForeground" ResourceKey="TextFillColorSecondaryBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SegmentedMeterTrackBackground" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="SegmentedMeterForeground" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SegmentedMeterAccentBackground" ResourceKey="SystemColorHotlightColorBrush" />
            <StaticResource x:Key="SegmentedMeterSuccessBackground" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="SegmentedMeterAttentionBackground" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="SegmentedMeterDangerBackground" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="SegmentedMeterNeutralBackground" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="SegmentedMeterLegendValueForeground" ResourceKey="SystemColorWindowTextColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <Style BasedOn="{StaticResource DefaultSegmentedMeterStyle}" TargetType="local:SegmentedMeter" />

    <Style x:Key="DefaultSegmentedMeterStyle" TargetType="local:SegmentedMeter">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Background" Value="{ThemeResource SegmentedMeterTrackBackground}" />
        <Setter Property="Foreground" Value="{ThemeResource SegmentedMeterForeground}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SegmentedMeter">
                    <Grid x:Name="PART_Root">
                        <Grid.Resources>
                            <x:Double x:Key="BarThicknessSmall">5</x:Double>
                            <x:Double x:Key="BarThicknessDefault">8</x:Double>
                            <x:Double x:Key="BarThicknessLarge">10</x:Double>
                            <x:Double x:Key="LegendMarkerSize">8</x:Double>
                            <x:Double x:Key="VerticalMinLength">120</x:Double>

                            <Style x:Key="SegmentAccent" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource SegmentedMeterAccentBackground}" />
                            </Style>
                            <Style x:Key="SegmentSuccess" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource SegmentedMeterSuccessBackground}" />
                            </Style>
                            <Style x:Key="SegmentAttention" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource SegmentedMeterAttentionBackground}" />
                            </Style>
                            <Style x:Key="SegmentDanger" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource SegmentedMeterDangerBackground}" />
                            </Style>
                            <Style x:Key="SegmentNeutral" TargetType="Border">
                                <Setter Property="Background" Value="{ThemeResource SegmentedMeterNeutralBackground}" />
                            </Style>

                            <Style x:Key="SegmentIcon" TargetType="FontIcon">
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="SegmentAccentIcon" BasedOn="{StaticResource SegmentIcon}" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="{ThemeResource SegmentedMeterAccentBackground}" />
                            </Style>
                            <Style x:Key="SegmentSuccessIcon" BasedOn="{StaticResource SegmentIcon}" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="{ThemeResource SegmentedMeterSuccessBackground}" />
                            </Style>
                            <Style x:Key="SegmentAttentionIcon" BasedOn="{StaticResource SegmentIcon}" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="{ThemeResource SegmentedMeterAttentionBackground}" />
                            </Style>
                            <Style x:Key="SegmentDangerIcon" BasedOn="{StaticResource SegmentIcon}" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="{ThemeResource SegmentedMeterDangerBackground}" />
                            </Style>
                            <Style x:Key="SegmentNeutralIcon" BasedOn="{StaticResource SegmentIcon}" TargetType="FontIcon">
                                <Setter Property="Foreground" Value="{ThemeResource SegmentedMeterNeutralBackground}" />
                            </Style>

                            <Style x:Key="LegendItemStyle" TargetType="StackPanel">
                                <Setter Property="Orientation" Value="Horizontal" />
                                <Setter Property="Spacing" Value="6" />
                            </Style>
                            <Style x:Key="LegendLabelStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                            </Style>
                            <Style x:Key="LegendValueStyle" TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{ThemeResource SegmentedMeterLegendValueForeground}" />
                            </Style>
                        </Grid.Resources>

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter x:Name="PART_Start" Margin="0,0,0,12" Content="{TemplateBinding StartContent}" Visibility="Collapsed" />

                        <Grid x:Name="PART_Body" Grid.Row="1" ColumnSpacing="12" RowSpacing="12">
                            <Border x:Name="PART_Track" AutomationProperties.AccessibilityView="Raw" Background="{TemplateBinding Background}">
                                <Grid x:Name="PART_BarGrid" />
                            </Border>

                            <local:MeterLegendPanel x:Name="PART_Legend" AutomationProperties.AccessibilityView="Raw" HorizontalSpacing="16" VerticalSpacing="6" />
                        </Grid>

                        <ContentPresenter x:Name="PART_End" Grid.Row="2" Margin="0,12,0,0" Content="{TemplateBinding EndContent}" Visibility="Collapsed" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
