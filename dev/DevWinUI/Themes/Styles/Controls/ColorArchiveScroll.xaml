<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <Style BasedOn="{StaticResource DefaultColorArchiveScrollStyle}" TargetType="local:ColorArchiveScroll" />

    <Style x:Key="DefaultColorArchiveScrollStyle" TargetType="local:ColorArchiveScroll">
        <Setter Property="FontSize" Value="44" />
        <Setter Property="MinHeight" Value="520" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="UseSystemFocusVisuals" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:ColorArchiveScroll">
                    <Grid x:Name="PART_Root">
                        <Canvas x:Name="PART_Rows" />
                        <Canvas>
                            <Rectangle x:Name="PART_RulerHit" Fill="Transparent" />
                            <Border x:Name="PART_Card" Background="#22000000" CornerRadius="14" RenderTransformOrigin="0.5,0.5">
                                <Grid>
                                    <Image x:Name="PART_ImageFront" Stretch="UniformToFill" />
                                    <Image x:Name="PART_ImageBack" Opacity="0" Stretch="UniformToFill" />
                                </Grid>
                            </Border>
                        </Canvas>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
