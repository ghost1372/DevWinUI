<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Default">
            <StaticResource x:Key="SearchBoxSelectedItemBackgroundBrush" ResourceKey="ControlSolidFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="SearchBoxSelectedItemBackgroundBrush" ResourceKey="ControlSolidFillColorDefaultBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <StaticResource x:Key="SearchBoxSelectedItemBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <CornerRadius x:Key="SearchBoxDetailsCornerRadius">8</CornerRadius>

    <Thickness x:Key="SearchBoxItemBorderThickness">1</Thickness>
    <Thickness x:Key="SearchBoxItemPadding">12,8</Thickness>
    <Thickness x:Key="SearchBoxDetailsMargin">12,0,12,8</Thickness>
    <Thickness x:Key="SearchBoxDetailsPadding">16,12</Thickness>
    <Thickness x:Key="SearchBoxDetailRowPadding">0,12</Thickness>
    <Thickness x:Key="SearchBoxItemActionPadding">0</Thickness>

    <x:Double x:Key="SearchBoxItemIconSize">22</x:Double>
    <x:Double x:Key="SearchBoxItemActionSize">32</x:Double>
    <x:Double x:Key="SearchBoxItemSpacing">12</x:Double>
    <x:Double x:Key="SearchBoxItemActionSpacing">4</x:Double>
    <x:Double x:Key="SearchBoxDetailsSpacing">8</x:Double>
    <x:Double x:Key="SearchBoxDetailRowSpacing">16</x:Double>
    <x:Double x:Key="SearchBoxDetailDividerHeight">1</x:Double>
    <x:Double x:Key="SearchBoxPreviewMaxHeight">190</x:Double>
    <GridLength x:Key="SearchBoxItemIconColumnWidth">32</GridLength>

    <x:String x:Key="SearchBoxItemMoreText">More options</x:String>
    <x:String x:Key="SearchBoxItemOpenText">Open</x:String>

    <CornerRadius x:Key="SearchBoxTriggerCornerRadius">18</CornerRadius>
    <CornerRadius x:Key="SearchBoxFlyoutCornerRadius">16</CornerRadius>
    <CornerRadius x:Key="SearchBoxEditorCornerRadius">12</CornerRadius>
    <CornerRadius x:Key="SearchBoxItemCornerRadius">8</CornerRadius>
    <CornerRadius x:Key="SearchBoxOpenButtonCornerRadius">8</CornerRadius>

    <Thickness x:Key="SearchBoxTriggerPadding">14,0</Thickness>
    <Thickness x:Key="SearchBoxFlyoutPadding">8</Thickness>
    <Thickness x:Key="SearchBoxItemMargin">0,0,0,2</Thickness>
    <Thickness x:Key="SearchBoxEditorBorderThickness">1</Thickness>
    <Thickness x:Key="SearchBoxEditorTextBoxMargin">6,6,6,0</Thickness>
    <Thickness x:Key="SearchBoxOpenButtonMargin">10</Thickness>

    <x:Double x:Key="SearchBoxTriggerMinHeight">36</x:Double>
    <x:Double x:Key="SearchBoxTriggerMinWidth">200</x:Double>
    <x:Double x:Key="SearchBoxTriggerIconSize">14</x:Double>
    <x:Double x:Key="SearchBoxTriggerContentSpacing">10</x:Double>
    <x:Double x:Key="SearchBoxFlyoutSpacing">8</x:Double>
    <x:Double x:Key="SearchBoxEditorHeight">96</x:Double>
    <x:Double x:Key="SearchBoxNoResultsIconSize">32</x:Double>
    <x:Double x:Key="SearchBoxNoResultsSpacing">8</x:Double>
    <Thickness x:Key="SearchBoxNoResultsPadding">24,40</Thickness>

    <x:String x:Key="SearchBoxOpenButtonText">Open</x:String>

    <Style x:Key="SearchBoxPillButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource ControlFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource ControlStrokeColorDefaultBrush}" />
        <Setter Property="CornerRadius" Value="{ThemeResource SearchBoxTriggerCornerRadius}" />
        <Setter Property="MinHeight" Value="{ThemeResource SearchBoxTriggerMinHeight}" />
        <Setter Property="MinWidth" Value="{ThemeResource SearchBoxTriggerMinWidth}" />
        <Setter Property="Padding" Value="{ThemeResource SearchBoxTriggerPadding}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style x:Key="SearchBoxFlyoutPresenterStyle" TargetType="FlyoutPresenter">
        <Setter Property="Padding" Value="{ThemeResource SearchBoxFlyoutPadding}" />
        <Setter Property="CornerRadius" Value="{ThemeResource SearchBoxFlyoutCornerRadius}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MaxWidth" Value="2000" />
        <Setter Property="MaxHeight" Value="2000" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>

    <Style x:Key="SearchBoxResultItemStyle" BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Margin" Value="{ThemeResource SearchBoxItemMargin}" />
        <Setter Property="CornerRadius" Value="{ThemeResource SearchBoxItemCornerRadius}" />
    </Style>

    <Style x:Key="DefaultSearchBoxStyle" TargetType="local:SearchBox">
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:SearchBox">
                    <Button x:Name="PART_TriggerButton" Style="{StaticResource SearchBoxPillButtonStyle}">
                        <StackPanel Orientation="Horizontal" Spacing="{ThemeResource SearchBoxTriggerContentSpacing}">
                            <FontIcon FontSize="{ThemeResource SearchBoxTriggerIconSize}" Glyph="&#xE721;" />
                            <TextBlock VerticalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="{TemplateBinding PlaceholderText}" />
                        </StackPanel>

                        <Button.Flyout>
                            <Flyout FlyoutPresenterStyle="{StaticResource SearchBoxFlyoutPresenterStyle}">
                                <Grid x:Name="PART_FlyoutRoot" RowSpacing="{ThemeResource SearchBoxFlyoutSpacing}">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <ListView x:Name="PART_ResultsList" VerticalAlignment="Top" ItemContainerStyle="{StaticResource SearchBoxResultItemStyle}" ItemTemplate="{TemplateBinding ItemTemplate}" SelectionMode="Single">
                                        <ListView.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Default">
                                                        <StaticResource x:Key="ListViewItemBackgroundSelected" ResourceKey="SystemControlTransparentBrush" />
                                                        <StaticResource x:Key="ListViewItemBackgroundSelectedPointerOver" ResourceKey="SystemControlTransparentBrush" />
                                                        <StaticResource x:Key="ListViewItemBackgroundSelectedPressed" ResourceKey="SystemControlTransparentBrush" />
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </ListView.Resources>
                                    </ListView>

                                    <StackPanel x:Name="PART_NoResultsPresenter" Padding="{ThemeResource SearchBoxNoResultsPadding}" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="{ThemeResource SearchBoxNoResultsSpacing}" Visibility="Collapsed">
                                        <FontIcon HorizontalAlignment="Center" FontSize="{ThemeResource SearchBoxNoResultsIconSize}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Glyph="&#xE721;" />
                                        <TextBlock HorizontalAlignment="Center" AutomationProperties.LiveSetting="Polite" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{TemplateBinding NoResultsText}" />
                                        <TextBlock HorizontalAlignment="Center" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{TemplateBinding NoResultsDescription}" />
                                    </StackPanel>

                                    <Border Grid.Row="1" Height="{ThemeResource SearchBoxEditorHeight}" Background="{ThemeResource ControlSolidFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="{ThemeResource SearchBoxEditorBorderThickness}" CornerRadius="{ThemeResource SearchBoxEditorCornerRadius}">
                                        <Border.Resources>
                                            <ResourceDictionary>
                                                <ResourceDictionary.ThemeDictionaries>
                                                    <ResourceDictionary x:Key="Default">
                                                        <SolidColorBrush x:Key="TextControlBackground" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBackgroundFocused" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrush" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrushPointerOver" Color="Transparent" />
                                                        <SolidColorBrush x:Key="TextControlBorderBrushFocused" Color="Transparent" />
                                                        <Thickness x:Key="TextControlBorderThemeThicknessFocused">0</Thickness>
                                                    </ResourceDictionary>
                                                </ResourceDictionary.ThemeDictionaries>
                                            </ResourceDictionary>
                                        </Border.Resources>
                                        <Grid>
                                            <TextBox x:Name="PART_SearchTextBox" Margin="{ThemeResource SearchBoxEditorTextBoxMargin}" VerticalAlignment="Top" AutomationProperties.Name="{TemplateBinding PlaceholderText}" />
                                            <Button x:Name="PART_OpenButton" Margin="{ThemeResource SearchBoxOpenButtonMargin}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Content="{ThemeResource SearchBoxOpenButtonText}" CornerRadius="{ThemeResource SearchBoxOpenButtonCornerRadius}" Style="{StaticResource AccentButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style BasedOn="{StaticResource DefaultSearchBoxStyle}" TargetType="local:SearchBox" />
</ResourceDictionary>
