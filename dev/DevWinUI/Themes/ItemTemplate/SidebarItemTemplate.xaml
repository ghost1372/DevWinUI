<ResourceDictionary x:Class="DevWinUI.SidebarItemTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <DataTemplate x:Key="DefaultSidebarItemTemplate" x:DataType="local:FlatSidebarItem">
        <local:SidebarItem Margin="{x:Bind SectionGapMargin, Mode=OneWay}" ContentOpacity="{x:Bind RowOpacity}" DataContext="{x:Bind}" Item="{x:Bind Item}" NestingLevel="{x:Bind Depth}" UseItemPresentation="True" />
    </DataTemplate>
</ResourceDictionary>
