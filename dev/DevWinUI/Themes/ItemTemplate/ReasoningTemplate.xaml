<ResourceDictionary x:Class="DevWinUI.ReasoningTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <DataTemplate x:Key="DefaultReasoningStepSourcesItemTemplate" x:DataType="local:ReasoningSource">
        <HyperlinkButton CornerRadius="12" NavigateUri="{x:Bind Url}" Style="{StaticResource ReasoningLinkButtonStyle}">
            <Border Padding="8,4" BorderBrush="{ThemeResource ReasoningBorderBrush}" BorderThickness="1" CornerRadius="12">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon VerticalAlignment="Center" FontSize="11" Foreground="{ThemeResource ReasoningSecondaryForeground}" Glyph="&#xE774;" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource ReasoningPrimaryForeground}" Text="{x:Bind Title}" />
                    <TextBlock FontSize="12" Foreground="{ThemeResource ReasoningSecondaryForeground}" Text="{x:Bind Host}" />
                </StackPanel>
            </Border>
        </HyperlinkButton>
    </DataTemplate>
</ResourceDictionary>
