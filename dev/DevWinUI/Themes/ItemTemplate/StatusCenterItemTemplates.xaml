<ResourceDictionary x:Class="DevWinUI.StatusCenterItemTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
                    xmlns:local="using:DevWinUI">

    <SolidColorBrush x:Key="StatusCenterInProgressBrush" Color="{ThemeResource App.Theme.FillColorAttention}" />
    <SolidColorBrush x:Key="StatusCenterSuccessfulBackgroundBrush" Color="{ThemeResource SystemFillColorSuccessBackground}" />
    <SolidColorBrush x:Key="StatusCenterSuccessfulBrush" Color="{ThemeResource SystemFillColorSuccess}" />
    <SolidColorBrush x:Key="StatusCenterErrorBackgroundBrush" Color="{ThemeResource SystemFillColorCriticalBackground}" />
    <SolidColorBrush x:Key="StatusCenterErrorBrush" Color="{ThemeResource SystemFillColorCritical}" />
    <SolidColorBrush x:Key="StatusCenterPausedBackgroundBrush" Color="{ThemeResource SystemFillColorCautionBackground}" />
    <SolidColorBrush x:Key="StatusCenterPausedBrush" Color="{ThemeResource SystemFillColorCaution}" />
    <SolidColorBrush x:Key="StatusCenterCanceledBrush" Color="{ThemeResource TextFillColorSecondary}" />

    <local:StatusCenterStateToBrushConverter x:Key="StatusCenterStateToBrushConverter" CanceledBackgroundBrush="{StaticResource StatusCenterCanceledBrush}" CanceledForegroundBrush="{StaticResource StatusCenterCanceledBrush}" ErrorBackgroundBrush="{StaticResource StatusCenterErrorBackgroundBrush}" ErrorForegroundBrush="{StaticResource StatusCenterErrorBrush}" InProgressBackgroundBrush="{StaticResource StatusCenterInProgressBrush}" InProgressForegroundBrush="{StaticResource StatusCenterInProgressBrush}" PausedBackgroundBrush="{StaticResource StatusCenterPausedBackgroundBrush}" PausedForegroundBrush="{StaticResource StatusCenterPausedBrush}" SuccessfulBackgroundBrush="{StaticResource StatusCenterSuccessfulBackgroundBrush}" SuccessfulForegroundBrush="{StaticResource StatusCenterSuccessfulBrush}" />

    <local:BoolNegationConverter x:Key="BoolNegationConverter" />
    <local:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    <local:BoolToObjectConverter x:Key="NegateBoolToVisibilityConverter" FalseValue="Visible" TrueValue="Collapsed" />
    <local:EmptyStringToObjectConverter x:Key="EmptyStringToBoolConverter" EmptyValue="False" NotEmptyValue="True" />

    <DataTemplate x:Key="StatusCenterItemTemplate" x:DataType="local:StatusCenterItem">
        <Grid x:Name="ContentRoot" Padding="8,8,8,8" HorizontalAlignment="Stretch" AutomationProperties.Name="{x:Bind Header, Mode=OneWay}" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="{StaticResource OverlayCornerRadius}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid.Transitions>
                <TransitionCollection>
                    <RepositionThemeTransition />
                </TransitionCollection>
            </Grid.Transitions>

            <!--  Header  -->
            <Grid x:Name="StatusCenterItemHeaderPanel" Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Header Icon  -->
                <Grid Grid.Column="0">

                    <!--  Circle Background 32x32  -->
                    <Border x:Name="SeverityBackgroundBorder" Width="32" Height="32" HorizontalAlignment="Center" VerticalAlignment="Center" Background="{x:Bind ItemKind, Converter={StaticResource StatusCenterStateToBrushConverter}, ConverterParameter=True, Mode=OneWay}" CornerRadius="16" Opacity="{x:Bind IconBackgroundCircleBorderOpacity, Mode=OneWay}" />

                    <!--  State Icon 16x16  -->
                    <ContentControl x:Name="SeverityForegroundIcon" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{x:Bind IconElement, Mode=OneWay}" Foreground="{x:Bind ItemKind, Converter={StaticResource StatusCenterStateToBrushConverter}, Mode=OneWay}" />

                </Grid>

                <!--  Header Title & Description  -->
                <StackPanel x:Name="StatusCenterItemHeadedrPanel" Grid.Column="1" Margin="12,0" VerticalAlignment="Center">

                    <TextBlock x:Name="StatusCenterItemHeaderTextBlock" x:Load="{x:Bind Header, Converter={StaticResource EmptyStringToBoolConverter}, Mode=OneWay}" MaxLines="2" Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Header, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind HeaderTooltip, Mode=OneWay}" />

                </StackPanel>

                <!--  Action Buttons  -->
                <StackPanel Grid.Column="2" VerticalAlignment="Center">

                    <!--  Dismiss Item  -->
                    <Button x:Name="CloseItemButton" Width="32" Height="32" Padding="0" x:Load="{x:Bind IsInProgress, Converter={StaticResource BoolNegationConverter}, Mode=OneWay}" AutomationProperties.Name="Clear" Background="Transparent" BorderBrush="Transparent" Command="{x:Bind RemoveCommand}" ToolTipService.ToolTip="Clear">
                        <Button.Content>
                            <FontIcon FontSize="16" Glyph="&#xE711;" />
                        </Button.Content>
                    </Button>

                    <!--  Expand & Collapse Chevron  -->
                    <ToggleButton x:Name="ExpandCollapseChevronItemButton" Width="32" Height="32" Padding="0" x:Load="{x:Bind IsSpeedAndProgressAvailable, Mode=OneWay}" Background="Transparent" BorderBrush="Transparent" IsChecked="{x:Bind IsExpanded, Mode=TwoWay}">
                        <AnimatedIcon x:Name="ExpandCollapseChevron" Width="16" Height="16" HorizontalAlignment="Center" VerticalAlignment="Center" AnimatedIcon.State="{x:Bind AnimatedIconState, Mode=OneWay}" AutomationProperties.AccessibilityView="Raw" RenderTransformOrigin="0.5, 0.5">
                            <animatedvisuals:AnimatedChevronUpDownSmallVisualSource />
                            <AnimatedIcon.FallbackIconSource>
                                <FontIconSource FontFamily="{StaticResource SymbolThemeFontFamily}" FontSize="16" Glyph="{StaticResource ExpanderChevronDownGlyph}" IsTextScaleFactorEnabled="False" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </ToggleButton>

                </StackPanel>

            </Grid>

            <!--  Graph & Footer  -->
            <Grid x:Name="StatusCenterItemRichProgressDisplayPanel" Grid.Row="1" Margin="0,8,0,8" ColumnSpacing="4" Visibility="{x:Bind IsInProgress, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Main ProgressBar  -->
                <ProgressBar x:Name="MainProgressBar" Margin="4,4,4,4" VerticalAlignment="Top" Foreground="{x:Bind ItemKind, Converter={StaticResource StatusCenterStateToBrushConverter}, Mode=OneWay}" IsIndeterminate="{x:Bind IsIndeterminateProgress, Mode=OneWay}" Visibility="{x:Bind IsExpanded, Converter={StaticResource NegateBoolToVisibilityConverter}, Mode=OneWay}" Value="{x:Bind ProgressPercentage, Mode=OneWay}" />

                <!--  Graph  -->
                <Grid x:Name="MainGraphCartesianChartClipGrid" Height="88" Margin="4,4,4,12" VerticalAlignment="Top" BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="4" Visibility="{x:Bind IsExpanded, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                    <Grid Padding="-2,-2,-2,-2">
                        <local:SpeedGraph2 ErrorColor="{ThemeResource SystemFillColorCritical}" Points="{x:Bind SpeedGraphValues, Mode=OneWay}" State="{x:Bind SpeedGraphState, Mode=OneWay}" SuccessColor="{ThemeResource SystemFillColorSuccess}" WarningColor="{ThemeResource SystemFillColorCaution}" />
                    </Grid>

                    <!--  Speed Text  -->
                    <StackPanel Margin="8,4">

                        <TextBlock x:Name="OperationSpeedStringTextBlock" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="10" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Speed:" />

                        <TextBlock x:Name="OperationSpeedPerSecTextBlock" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="13" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind SpeedText, Mode=OneWay}" />

                    </StackPanel>

                </Grid>

                <!--  Footer  -->
                <Grid Grid.Row="1" Margin="4,0" VerticalAlignment="Top" Visibility="{x:Bind IsIndeterminateProgress, Converter={StaticResource NegateBoolToVisibilityConverter}, Mode=OneWay}">

                    <!--  Abstract Info (Displayed When Graph Collapsed)  -->
                    <TextBlock x:Name="StatusCenterItemSubFooterTextBlock" x:Load="{x:Bind Message, Converter={StaticResource EmptyStringToBoolConverter}, Mode=OneWay}" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind Message, Mode=OneWay}" Visibility="{x:Bind IsExpanded, Converter={StaticResource NegateBoolToVisibilityConverter}, Mode=OneWay}" />

                    <!--  Detailed Info (Displayed When Graph Expanded)  -->
                    <StackPanel Spacing="2" Visibility="{x:Bind IsExpanded, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">

                        <TextBlock x:Name="StatusCenterItemCurrentProcessingItemNameTextBlock" MaxLines="1" Style="{StaticResource BodyTextBlockStyle}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTipService.ToolTip="{x:Bind CurrentProcessingItemName, Mode=OneWay}">
                            <Run Text="Name:" />
                            <Run Text="{x:Bind CurrentProcessingItemName, Mode=OneWay}" />
                        </TextBlock>

                        <TextBlock x:Name="StatusCenterItemProcessedBytesAndProgressTextBlock" Foreground="{ThemeResource TextFillColorSecondaryBrush}" MaxLines="1" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Message, Mode=OneWay}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />

                    </StackPanel>

                </Grid>

                <!--  Action Buttons  -->
                <Grid Grid.RowSpan="2" Grid.Column="1" VerticalAlignment="Top">

                    <!--  More Options  -->
                    <Button x:Name="MoreOptionsButton" Width="32" Height="32" Padding="0" x:Load="{x:Bind HasActions, Mode=OneWay}" AutomationProperties.Name="More options..." Background="Transparent" BorderBrush="Transparent" ToolTipService.ToolTip="More options..." Visibility="{x:Bind IsInProgress, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                        <Button.Flyout>
                            <MenuFlyout>
                                <MenuFlyoutItem x:Name="PauseItemButton" Command="{x:Bind PauseCommand}" DataContext="{x:Bind}" Text="{x:Bind PauseButtonText, Mode=OneWay}" Visibility="{x:Bind IsPausable, Converter={StaticResource BoolToVisibilityConverter}, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontSize="16" Glyph="{x:Bind PauseButtonIconGlyph, Mode=OneWay}" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem x:Name="CancelItemButton" Command="{x:Bind CancelCommand}" DataContext="{x:Bind}" IsEnabled="{x:Bind IsCancelable, Mode=OneWay}" Text="Cancel">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon FontSize="16" Glyph="&#xE711;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                        <Button.Content>
                            <FontIcon FontSize="16" Glyph="&#xE712;" />
                        </Button.Content>
                    </Button>

                </Grid>

            </Grid>

        </Grid>
    </DataTemplate>

</ResourceDictionary>
