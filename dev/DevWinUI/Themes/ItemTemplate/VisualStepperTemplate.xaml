<ResourceDictionary x:Class="DevWinUI.VisualStepperTemplate"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <DataTemplate x:Key="DefaultVisualStepperCardTemplate" x:DataType="local:VisualStepperItem">
        <Border Padding="24" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="1" CornerRadius="12">
            <StackPanel VerticalAlignment="Center" Spacing="8">
                <TextBlock Style="{ThemeResource TitleTextBlockStyle}" Text="{x:Bind Step.Title, Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Opacity="0.7" Text="{x:Bind Step.Description, Mode=OneWay}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </DataTemplate>
</ResourceDictionary>
