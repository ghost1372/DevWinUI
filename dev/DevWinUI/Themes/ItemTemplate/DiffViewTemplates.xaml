<ResourceDictionary x:Class="DevWinUI.DiffViewTemplates"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <DataTemplate x:Key="DiffUnifiedRowTemplate" x:DataType="local:DiffRow">
        <Grid MinHeight="22" AutomationProperties.Name="{x:Bind AutomationName}" Background="{x:Bind Background}">

            <Grid Visibility="{x:Bind CodeVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="8" />

                <TextBlock Grid.Column="1" Width="{x:Bind OldGutterWidth}" Padding="0,0,8,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalTextAlignment="Right" IsTextSelectionEnabled="False" Text="{x:Bind OldNumber}" Visibility="{x:Bind OldGutterVisibility}" />

                <TextBlock Grid.Column="2" Width="{x:Bind NewGutterWidth}" Padding="0,0,8,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalTextAlignment="Right" IsTextSelectionEnabled="False" Text="{x:Bind NewNumber}" Visibility="{x:Bind NewGutterVisibility}" />

                <TextBlock Grid.Column="3" Width="24" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{x:Bind AccentBrush}" HorizontalTextAlignment="Center" IsTextSelectionEnabled="False" Text="{x:Bind Marker}" />

                <TextBlock Grid.Column="4" Padding="0,2,12,2" VerticalAlignment="Center" local:DiffHighlight.Row="{x:Bind}" TextWrapping="{x:Bind Wrapping}" />
            </Grid>

            <Button Padding="12,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Command="{x:Bind ExpandCommand}" CommandParameter="{x:Bind}" Content="{x:Bind ExpanderText}" CornerRadius="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ExpanderVisibility}" />
        </Grid>
    </DataTemplate>

    <DataTemplate x:Key="DiffSplitRowTemplate" x:DataType="local:SplitRow">
        <Grid MinHeight="22" AutomationProperties.Name="{x:Bind AutomationName}">

            <Grid Visibility="{x:Bind CodeVisibility}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Background="{x:Bind Left.Background}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Width="{x:Bind Left.OldGutterWidth}" Padding="0,0,8,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalTextAlignment="Right" IsTextSelectionEnabled="False" Text="{x:Bind Left.OldNumber}" Visibility="{x:Bind Left.OldGutterVisibility}" />

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{x:Bind Left.AccentBrush}" HorizontalTextAlignment="Center" IsTextSelectionEnabled="False" Text="{x:Bind Left.Marker}" />

                    <TextBlock Grid.Column="3" Padding="0,2,12,2" VerticalAlignment="Center" local:DiffHighlight.Row="{x:Bind Left}" TextTrimming="CharacterEllipsis" TextWrapping="{x:Bind Left.Wrapping}" />
                </Grid>

                <Border Grid.Column="1" Background="{ThemeResource DividerStrokeColorDefaultBrush}" />

                <Grid Grid.Column="2" Background="{x:Bind Right.Background}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="1" Width="{x:Bind Right.NewGutterWidth}" Padding="0,0,8,0" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{ThemeResource TextFillColorTertiaryBrush}" HorizontalTextAlignment="Right" IsTextSelectionEnabled="False" Text="{x:Bind Right.NewNumber}" Visibility="{x:Bind Right.NewGutterVisibility}" />

                    <TextBlock Grid.Column="2" VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" Foreground="{x:Bind Right.AccentBrush}" HorizontalTextAlignment="Center" IsTextSelectionEnabled="False" Text="{x:Bind Right.Marker}" />

                    <TextBlock Grid.Column="3" Padding="0,2,12,2" VerticalAlignment="Center" local:DiffHighlight.Row="{x:Bind Right}" TextTrimming="CharacterEllipsis" TextWrapping="{x:Bind Right.Wrapping}" />
                </Grid>
            </Grid>

            <Button Padding="12,3" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Background="Transparent" BorderThickness="0" Command="{x:Bind ExpandCommand}" CommandParameter="{x:Bind Expander}" Content="{x:Bind ExpanderText}" CornerRadius="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Visibility="{x:Bind ExpanderVisibility}" />
        </Grid>
    </DataTemplate>
</ResourceDictionary>
