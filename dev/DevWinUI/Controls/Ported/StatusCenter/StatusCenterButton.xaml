<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="using:DevWinUI">

    <Style TargetType="local:StatusCenterButton">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="local:StatusCenterButton">
                    <Grid>
                        <Grid.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.MergedDictionaries>
                                    <ResourceDictionary Source="ms-appx:///DevWinUI/Controls/Ported/StatusCenter/Styles/StatusCenterInfoBadgeStyles.xaml" />
                                </ResourceDictionary.MergedDictionaries>

                                <local:VisibilityInvertConverter x:Key="VisibilityInvertConverter" />

                                <Style x:Key="StatusCenterButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="Width" Value="36" />
                                    <Setter Property="Height" Value="32" />
                                    <Setter Property="Foreground" Value="{ThemeResource App.Theme.IconBaseBrush}" />
                                </Style>
                            </ResourceDictionary>
                        </Grid.Resources>

                        <Button x:Name="ShowStatusCenterButton" Padding="0" AutomationProperties.Name="Status center" Style="{StaticResource StatusCenterButtonStyle}" ToolTipService.ToolTip="Status center">

                            <Grid Margin="-16">
                                <Grid Visibility="{Binding ShowProgressRing, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource VisibilityInvertConverter}, Mode=OneWay}">
                                    <ContentPresenter Content="{TemplateBinding Icon}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={ThemeResource NullToVisibilityConverter}, Mode=OneWay}" />

                                    <local:ThemedIcon x:Name="StatusCenterIcon" Width="16" Height="16" Style="{StaticResource App.ThemedIcons.StatusCenter}" Visibility="{Binding Icon, RelativeSource={RelativeSource TemplatedParent}, Converter={ThemeResource NullToVisibilityReConverter}, Mode=OneWay}" />
                                </Grid>

                                <ProgressRing x:Name="MedianOperationProgressRing" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="Status center progress ring" IsIndeterminate="False" Visibility="{Binding ShowProgressRing, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="{Binding AverageOperationProgressValue, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />

                                <InfoBadge x:Name="StatusInfoBadge" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="{Binding ShowProgressRing, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" Value="{Binding InfoBadgeValue, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                            </Grid>

                            <Button.Flyout>
                                <Flyout x:Name="StatusCenterFlyout" AutomationProperties.Name="Status center" Placement="{Binding FlyoutPlacement, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" ShouldConstrainToRootBounds="False">
                                    <Flyout.FlyoutPresenterStyle>
                                        <Style TargetType="FlyoutPresenter">
                                            <Setter Property="Padding" Value="0" />
                                            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
                                        </Style>
                                    </Flyout.FlyoutPresenterStyle>

                                    <local:StatusCenter x:Name="OngoingTasksControl" Width="400" MinHeight="120" MaxHeight="500" IsTabStop="True" />
                                </Flyout>
                            </Button.Flyout>

                        </Button>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="StatusIconStates">
                                <VisualState x:Name="TasksSuccess">
                                    <VisualState.StateTriggers>
                                        <local:IsEqualStateTrigger Value="{Binding InfoBadgeState, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" To="0" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="MedianOperationProgressRing.Background" Value="{ThemeResource SystemFillColorSuccessBrush}" />
                                        <Setter Target="StatusInfoBadge.Style" Value="{StaticResource SuccessIconInfoBadgeStyle}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TasksOnging">
                                    <VisualState.StateTriggers>
                                        <local:IsEqualStateTrigger Value="{Binding InfoBadgeState, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" To="1" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="MedianOperationProgressRing.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                                        <Setter Target="MedianOperationProgressRing.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="StatusCenterIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TasksFailure">
                                    <VisualState.StateTriggers>
                                        <local:IsEqualStateTrigger Value="{Binding InfoBadgeState, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" To="2" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="MedianOperationProgressRing.Foreground" Value="{ThemeResource SystemFillColorAttentionBrush}" />
                                        <Setter Target="MedianOperationProgressRing.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="StatusCenterIcon.Visibility" Value="Collapsed" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TasksPaused">
                                    <VisualState.StateTriggers>
                                        <local:IsEqualStateTrigger Value="{Binding InfoBadgeState, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" To="4" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="MedianOperationProgressRing.Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
                                        <Setter Target="MedianOperationProgressRing.Background" Value="{ThemeResource SubtleFillColorSecondaryBrush}" />
                                        <Setter Target="StatusCenterIcon.Visibility" Value="Collapsed" />
                                        <Setter Target="StatusInfoBadge.Style" Value="{StaticResource CautionValueInfoBadgeStyle}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="TasksCompletionWithFailure">
                                    <VisualState.StateTriggers>
                                        <local:IsEqualStateTrigger Value="{Binding InfoBadgeState, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" To="3" />
                                    </VisualState.StateTriggers>
                                    <VisualState.Setters>
                                        <Setter Target="MedianOperationProgressRing.Background" Value="{ThemeResource SystemFillColorCriticalBrush}" />
                                        <Setter Target="StatusCenterIcon.Visibility" Value="Collapsed" />
                                        <Setter Target="StatusInfoBadge.Style" Value="{StaticResource CriticalIconInfoBadgeStyle}" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
