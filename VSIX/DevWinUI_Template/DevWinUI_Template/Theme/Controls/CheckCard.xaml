<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DevWinUI_Template">

    <SolidColorBrush x:Key="CheckCardTagInfoBackgroundBrush" Color="#663A5A85" />
    <SolidColorBrush x:Key="CheckCardTagInfoBorderBrush" Color="#FF7FB7FF" />

    <Style TargetType="{x:Type local:CheckCard}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="TagCornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:CheckCard}">
                    <local:Card Background="{TemplateBinding Background}" BlurRadius="{TemplateBinding BlurRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" GlowColor="{TemplateBinding GlowColor}" GlowOpacity="{TemplateBinding GlowOpacity}" IsActive="{TemplateBinding IsActive}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.RowSpan="2" Grid.Column="0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                            <ContentPresenter Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Center" VerticalAlignment="Center" Content="{TemplateBinding Icon}" />
                            <Border x:Name="TagBadge" Grid.RowSpan="2" Grid.Column="3" Margin="8,0,0,0" Padding="7,2" VerticalAlignment="Center" Background="{StaticResource CheckCardTagInfoBackgroundBrush}" BorderBrush="{StaticResource CheckCardTagInfoBorderBrush}" BorderThickness="1" CornerRadius="{TemplateBinding TagCornerRadius}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#EAF3FF" Text="{TemplateBinding Tag}" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="2" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Title}" />
                            <TextBlock x:Name="TxtSubtitle" Grid.Row="1" Grid.Column="2" FontSize="12" Foreground="#C8FFFFFF" Text="{TemplateBinding Subtitle}" TextWrapping="Wrap" />
                        </Grid>
                    </local:Card>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Tag" Value="{x:Null}">
                            <Setter TargetName="TagBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Tag" Value="">
                            <Setter TargetName="TagBadge" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="{x:Null}">
                            <Setter TargetName="TxtSubtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Subtitle" Value="">
                            <Setter TargetName="TxtSubtitle" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
