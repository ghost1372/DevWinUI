<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DevWinUI_Template">

    <SolidColorBrush x:Key="RadioCardTagInfoBackgroundBrush" Color="#663A5A85" />
    <SolidColorBrush x:Key="RadioCardTagInfoBorderBrush" Color="#FF7FB7FF" />
    <SolidColorBrush x:Key="RadioCardTagSuccessBackgroundBrush" Color="#662E6B42" />
    <SolidColorBrush x:Key="RadioCardTagSuccessBorderBrush" Color="#FF45D483" />
    <SolidColorBrush x:Key="RadioCardTagWarningBackgroundBrush" Color="#667A5A20" />
    <SolidColorBrush x:Key="RadioCardTagWarningBorderBrush" Color="#FFFFC761" />
    <SolidColorBrush x:Key="RadioCardTagErrorBackgroundBrush" Color="#667A2F2F" />
    <SolidColorBrush x:Key="RadioCardTagErrorBorderBrush" Color="#FFFF8A8A" />

    <Style TargetType="{x:Type local:RadioCard}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="TagCornerRadius" Value="6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:RadioCard}">
                    <local:Card Background="{TemplateBinding Background}" BlurRadius="{TemplateBinding BlurRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" GlowColor="{TemplateBinding GlowColor}" GlowOpacity="{TemplateBinding GlowOpacity}" IsActive="{TemplateBinding IsActive}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter Grid.RowSpan="2" Grid.Column="0" Margin="0,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Content}" />
                            <Border x:Name="TagBadge" Grid.Column="2" Margin="8,0,0,0" Padding="7,2" VerticalAlignment="Center" Background="{StaticResource RadioCardTagInfoBackgroundBrush}" BorderBrush="{StaticResource RadioCardTagInfoBorderBrush}" BorderThickness="1" CornerRadius="{TemplateBinding TagCornerRadius}" SnapsToDevicePixels="True" UseLayoutRounding="True">
                                <TextBlock FontSize="11" FontWeight="SemiBold" Foreground="#EAF3FF" Text="{TemplateBinding Tag}" />
                            </Border>
                            <TextBlock Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Title}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,3,0,0" FontSize="12" Foreground="#C8FFFFFF" Text="{TemplateBinding Subtitle}" TextWrapping="Wrap" />
                        </Grid>
                    </local:Card>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Severity" Value="{x:Static local:RadioCardSeverity.Success}">
                            <Setter TargetName="TagBadge" Property="Background" Value="{StaticResource RadioCardTagSuccessBackgroundBrush}" />
                            <Setter TargetName="TagBadge" Property="BorderBrush" Value="{StaticResource RadioCardTagSuccessBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static local:RadioCardSeverity.Warning}">
                            <Setter TargetName="TagBadge" Property="Background" Value="{StaticResource RadioCardTagWarningBackgroundBrush}" />
                            <Setter TargetName="TagBadge" Property="BorderBrush" Value="{StaticResource RadioCardTagWarningBorderBrush}" />
                        </Trigger>
                        <Trigger Property="Severity" Value="{x:Static local:RadioCardSeverity.Error}">
                            <Setter TargetName="TagBadge" Property="Background" Value="{StaticResource RadioCardTagErrorBackgroundBrush}" />
                            <Setter TargetName="TagBadge" Property="BorderBrush" Value="{StaticResource RadioCardTagErrorBorderBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
