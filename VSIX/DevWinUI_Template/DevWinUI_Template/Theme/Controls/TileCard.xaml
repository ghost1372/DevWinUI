<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:DevWinUI_Template"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">

    <Style TargetType="{x:Type local:TileCard}">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="#22FFFFFF" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="UseLayoutRounding" Value="True" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type local:TileCard}">
                    <local:Card Background="{TemplateBinding Background}" BlurRadius="{TemplateBinding BlurRadius}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" GlowColor="{TemplateBinding GlowColor}" GlowOpacity="{TemplateBinding GlowOpacity}" IsActive="{TemplateBinding IsActive}">
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter x:Name="ActiveIconPresenter" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Content="{TemplateBinding ActiveIcon}" Visibility="Collapsed" />
                            <ui:SymbolIcon x:Name="DefaultActiveIcon" Grid.RowSpan="2" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Top" Filled="True" FontSize="24" Foreground="{DynamicResource CardActiveBorderBrush}" Symbol="CheckmarkCircle24" Visibility="Collapsed" />

                            <ContentPresenter Grid.Row="0" Grid.Column="0" Margin="10,0" HorizontalAlignment="Left" VerticalAlignment="Center" Content="{TemplateBinding Icon}" />

                            <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,8,0,0" VerticalAlignment="Center" FontSize="16" FontWeight="SemiBold" Foreground="{TemplateBinding Foreground}" Text="{TemplateBinding Title}" />

                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Margin="0,6,0,0" FontSize="12" Foreground="#C8FFFFFF" Text="{TemplateBinding Subtitle}" TextWrapping="Wrap" />
                        </Grid>
                    </local:Card>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsActive" Value="True">
                            <Setter TargetName="ActiveIconPresenter" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsActive" Value="True" />
                                <Condition Property="ActiveIcon" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="DefaultActiveIcon" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
