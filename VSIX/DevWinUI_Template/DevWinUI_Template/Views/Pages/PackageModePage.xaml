<Page x:Class="DevWinUI_Template.PackageModePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DevWinUI_Template"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="PackageModePage"
      d:DesignHeight="450"
      d:DesignWidth="800"
      mc:Ignorable="d">
    <Grid Margin="0,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,10">
            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Style="{StaticResource TitleTextBlockStyle}" Text="Package Mode" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" Text="Choose how you want to package and distribute your application" />
        </StackPanel>
        <ListView x:Name="PackageLV" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NoTemplateListViewItemStyle}" SelectedValue="{Binding WindowsPackageMode, Mode=TwoWay}" SelectedValuePath="Value">
            <ListView.ItemTemplate>
                <DataTemplate DataType="model:PackageModeModel">
                    <local:Card Margin="0,0,0,10" IsActive="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}">
                        <local:Card.Content>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition />
                                </Grid.RowDefinitions>
                                <ContentPresenter Grid.RowSpan="2" Margin="10,10,10,0" VerticalAlignment="Center" Content="{Binding Icon}" />

                                <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,10,0,0" Foreground="{DynamicResource TextFillColorPrimaryBrush}" Style="{StaticResource SubtitleTextBlockStyle}" Text="{Binding Title}" />
                                <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,0,0,0" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" Text="{Binding Subtitle}" />
                                <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,10,0,10" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" Text="{Binding Description}" />
                            </Grid>
                        </local:Card.Content>
                    </local:Card>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
