<Page x:Class="DevWinUI_Template.NugetPackagePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:DevWinUI_Template"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="FilePage"
      d:DesignHeight="450"
      d:DesignWidth="800"
      mc:Ignorable="d">

    <Grid Margin="0,0,10,10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Foreground="{DynamicResource TextFillColorPrimaryBrush}" Style="{StaticResource TitleTextBlockStyle}" Text="NuGet Packages" />
            <TextBlock Foreground="{DynamicResource TextFillColorSecondaryBrush}" Style="{StaticResource BaseTextBlockStyle}" Text="Select packages that will be installed" />
        </StackPanel>
        <ListView x:Name="PackagesLV" Grid.Row="1" Background="Transparent" BorderThickness="0" ItemContainerStyle="{StaticResource NoTemplateListViewItemStyle}" SelectionChanged="PackagesLV_SelectionChanged" SelectionMode="Multiple">
            <ListView.ItemTemplate>
                <DataTemplate DataType="model:NugetPackageModel">
                    <local:CheckCard Title="{Binding Title}" Margin="0,0,40,0" CornerRadius="{Binding CornerRadius}" IsActive="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" Subtitle="{Binding Subtitle}" Tag="{Binding Tag}">
                        <local:CheckCard.Content>
                            <CheckBox IsChecked="{Binding RelativeSource={RelativeSource AncestorType=ListViewItem}, Path=IsSelected}" />
                        </local:CheckCard.Content>
                    </local:CheckCard>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</Page>
